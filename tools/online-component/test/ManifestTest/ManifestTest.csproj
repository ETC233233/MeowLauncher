<Project Sdk="Microsoft.NET.Sdk">
  <!-- 云端组件清单的验签 / 挑包逻辑自测：只链接 ComponentManifest.cs（不依赖界面）。
       运行：在本目录 dotnet build 后运行 bin/Debug/net8.0/ManifestTest.dll -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ManifestTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\..\..\MeowLauncher.WinUI\Services\ComponentManifest.cs" Link="ComponentManifest.cs" />
    <Compile Include="..\..\..\..\MeowLauncher.WinUI\Services\ComponentPackage.cs" Link="ComponentPackage.cs" />
    <Compile Include="../../../../MeowLauncher.WinUI/Services/MeowVersion.cs" Link="MeowVersion.cs" />
    <Compile Include="../../../../MeowLauncher.WinUI/Services/UpdateLogic.cs" Link="UpdateLogic.cs" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>
</Project>
