<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="AppTextColor">#FFF2F3F5</Color>
            <Color x:Key="AppText2Color">#FFA7A9B3</Color>
            <Color x:Key="AppText3Color">#FF777984</Color>
            <Color x:Key="AppPanelColor">#F2181A1E</Color>
            <Color x:Key="AppStrokeColor">#24FFFFFF</Color>
            <Color x:Key="AppChipHoverColor">#1FFFFFFF</Color>
            <Color x:Key="AppChipColor">#1CFFFFFF</Color>
            <Color x:Key="AppNavSelectedColor">#1FFFFFFF</Color>
            <!-- 侧栏不再用近黑实底：白 5% 叠在整窗材质上，壁纸在侧栏区域也要透出来 -->
            <Color x:Key="AppSidebarColor">#0DFFFFFF</Color>
            <Color x:Key="AppCardFallbackColor">#F016161A</Color>
            <Color x:Key="PanelSurfaceColor">#FB14161A</Color>
            <Color x:Key="AppGoodColor">#FF4CC38A</Color>
            <Color x:Key="AppWarnColor">#FFE5A227</Color>
            <Color x:Key="AppBadColor">#FFEB5757</Color>
            <Color x:Key="AppCardHoverBorderColor">#3DFFFFFF</Color>

            <SolidColorBrush x:Key="AppTextBrush" Color="{ThemeResource AppTextColor}" />
            <SolidColorBrush x:Key="AppText2Brush" Color="{ThemeResource AppText2Color}" />
            <SolidColorBrush x:Key="AppText3Brush" Color="{ThemeResource AppText3Color}" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="{ThemeResource AppStrokeColor}" />
            <SolidColorBrush x:Key="AppChipBrush" Color="{ThemeResource AppChipColor}" />
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="{ThemeResource AppNavSelectedColor}" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="{ThemeResource AppSidebarColor}" />
            <SolidColorBrush x:Key="AppGoodBrush" Color="{ThemeResource AppGoodColor}" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="{ThemeResource AppWarnColor}" />
            <SolidColorBrush x:Key="AppBadBrush" Color="{ThemeResource AppBadColor}" />

            <!-- 契约 1：卡片 = 半透明纯色 + 1px 描边，禁止独立 AcrylicBrush。
                 深色 alpha 从 70%（#B3）降到 45%（#73），让整窗那层 DesktopAcrylic 透上来；
                 最上面 1 格是 Win11 的玻璃边缘高光（白 6% 叠在卡底上的预乘色），下面立刻回到卡底本色。 -->
            <LinearGradientBrush x:Key="AppCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#7B1E2024" Offset="0" />
                <GradientStop Color="#730F1216" Offset="0.02" />
                <GradientStop Color="#730F1216" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="CardStrokeColor">#14FFFFFF</Color>
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource CardStrokeColor}" />

            <!-- 整窗材质由 Window.SystemBackdrop（DesktopAcrylicBackdrop）承担；
                 卡片不得自开 Acrylic。AppShellBrush 已无引用，随外壳层收口删除（ADR-0003）。 -->

            <SolidColorBrush x:Key="AppPanelBrush" Color="{ThemeResource AppPanelColor}" />
            <SolidColorBrush x:Key="AppCardHoverBorderBrush" Color="{ThemeResource AppCardHoverBorderColor}" />

            <!-- t55：Toast/胶囊悬停底（VersionsPage 原 FromArgb(28,255,255,255) 归令牌） -->
            <SolidColorBrush x:Key="ChipHoverBrush" Color="#1CFFFFFF" />

            <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F20B0D10" Offset="0" />
                <GradientStop Color="#D90B0D10" Offset="0.52" />
                <GradientStop Color="#660B0D10" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DailyBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#332FA35A" Offset="0" />
                <GradientStop Color="#141F3A2A" Offset="1" />
            </LinearGradientBrush>

            <!-- 首页内容层画布：左上品牌绿、右下冷蓝，中间完全透明让 Acrylic 透上来。
                 只做很淡的环境光，不压暗任何内容，也不参与卡片材质。 -->
            <LinearGradientBrush x:Key="HomeCanvasBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#262FA35A" Offset="0" />
                <GradientStop Color="#00181A1C" Offset="0.46" />
                <GradientStop Color="#1C2F5F8A" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppTextColor">#FF1A1A1F</Color>
            <Color x:Key="AppText2Color">#FF5A5A64</Color>
            <Color x:Key="AppText3Color">#FF84848F</Color>
            <Color x:Key="AppStrokeColor">#24000000</Color>
            <Color x:Key="AppChipHoverColor">#14000000</Color>
            <Color x:Key="AppPanelColor">#FAFFFFFF</Color>
            <Color x:Key="AppChipColor">#10000000</Color>
            <Color x:Key="AppNavSelectedColor">#EFFFFFFF</Color>
            <!-- 浅色：黑 4% -->
            <Color x:Key="AppSidebarColor">#0A000000</Color>
            <Color x:Key="AppCardFallbackColor">#EAF8F8FA</Color>
            <Color x:Key="PanelSurfaceColor">#FBF8F8FA</Color>
            <Color x:Key="AppGoodColor">#FF1F9D63</Color>
            <Color x:Key="AppWarnColor">#FFB8791A</Color>
            <Color x:Key="AppBadColor">#FFD63B3B</Color>
            <Color x:Key="AppCardHoverBorderColor">#26000000</Color>

            <SolidColorBrush x:Key="AppTextBrush" Color="{ThemeResource AppTextColor}" />
            <SolidColorBrush x:Key="AppText2Brush" Color="{ThemeResource AppText2Color}" />
            <SolidColorBrush x:Key="AppText3Brush" Color="{ThemeResource AppText3Color}" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="{ThemeResource AppStrokeColor}" />
            <SolidColorBrush x:Key="AppChipBrush" Color="{ThemeResource AppChipColor}" />
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="{ThemeResource AppNavSelectedColor}" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="{ThemeResource AppSidebarColor}" />
            <SolidColorBrush x:Key="AppGoodBrush" Color="{ThemeResource AppGoodColor}" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="{ThemeResource AppWarnColor}" />
            <SolidColorBrush x:Key="AppBadBrush" Color="{ThemeResource AppBadColor}" />

            <!-- 契约 1：卡片 = 半透明纯色 + 1px 描边，禁止独立 AcrylicBrush。
                 浅色 alpha 从 72%（#B8）降到 55%（#8C）；顶部 1 格是黑 4% 的玻璃边缘。 -->
            <LinearGradientBrush x:Key="AppCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#91F4F4F4" Offset="0" />
                <GradientStop Color="#8CFFFFFF" Offset="0.02" />
                <GradientStop Color="#8CFFFFFF" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="CardStrokeColor">#0F000000</Color>
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource CardStrokeColor}" />


            <SolidColorBrush x:Key="AppPanelBrush" Color="{ThemeResource AppPanelColor}" />
            <SolidColorBrush x:Key="AppCardHoverBorderBrush" Color="{ThemeResource AppCardHoverBorderColor}" />

            <!-- t55：Toast/胶囊悬停底（浅色） -->
            <SolidColorBrush x:Key="ChipHoverBrush" Color="#1A000000" />

            <LinearGradientBrush x:Key="HeroOverlayBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F20B0D10" Offset="0" />
                <GradientStop Color="#D90B0D10" Offset="0.52" />
                <GradientStop Color="#660B0D10" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="DailyBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2E2FA35A" Offset="0" />
                <GradientStop Color="#102FA35A" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="HomeCanvasBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A2FA35A" Offset="0" />
                <GradientStop Color="#00FFFFFF" Offset="0.46" />
                <GradientStop Color="#122F5F8A" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <!-- t55：HighContrast 变体。规则：不依赖透明度表达层级（全实心系统色 + 实线描边）。 -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="AppTextColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="AppText2Color">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="AppText3Color">{ThemeResource SystemColorGrayTextColor}</Color>
            <Color x:Key="AppStrokeColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <Color x:Key="AppChipHoverColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="AppPanelColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="AppChipColor">{ThemeResource SystemColorButtonFaceColor}</Color>
            <Color x:Key="AppNavSelectedColor">{ThemeResource SystemColorHighlightColor}</Color>
            <Color x:Key="AppSidebarColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="AppCardFallbackColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="PanelSurfaceColor">{ThemeResource SystemColorWindowColor}</Color>
            <Color x:Key="AppGoodColor">#FF00C853</Color>
            <Color x:Key="AppWarnColor">#FFFFB300</Color>
            <Color x:Key="AppBadColor">#FFFF5252</Color>
            <Color x:Key="AppCardHoverBorderColor">{ThemeResource SystemColorHighlightColor}</Color>

            <SolidColorBrush x:Key="AppTextBrush" Color="{ThemeResource AppTextColor}" />
            <SolidColorBrush x:Key="AppText2Brush" Color="{ThemeResource AppText2Color}" />
            <SolidColorBrush x:Key="AppText3Brush" Color="{ThemeResource AppText3Color}" />
            <SolidColorBrush x:Key="AppStrokeBrush" Color="{ThemeResource AppStrokeColor}" />
            <SolidColorBrush x:Key="AppChipBrush" Color="{ThemeResource AppChipColor}" />
            <SolidColorBrush x:Key="AppNavSelectedBrush" Color="{ThemeResource AppNavSelectedColor}" />
            <SolidColorBrush x:Key="AppSidebarBrush" Color="{ThemeResource AppSidebarColor}" />
            <SolidColorBrush x:Key="AppGoodBrush" Color="{ThemeResource AppGoodColor}" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="{ThemeResource AppWarnColor}" />
            <SolidColorBrush x:Key="AppBadBrush" Color="{ThemeResource AppBadColor}" />

            <!-- 卡片/描边：实心系统色 + 1px 实线描边承担层级，不用半透明 -->
            <SolidColorBrush x:Key="AppCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <Color x:Key="CardStrokeColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="CardStrokeBrush" Color="{ThemeResource CardStrokeColor}" />
            <SolidColorBrush x:Key="AppPanelBrush" Color="{ThemeResource AppPanelColor}" />
            <SolidColorBrush x:Key="AppCardHoverBorderBrush" Color="{ThemeResource AppCardHoverBorderColor}" />
            <SolidColorBrush x:Key="ChipHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HeroOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DailyBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="{ThemeResource PanelSurfaceColor}" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF2FA35A" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#252FA35A" />
    <SolidColorBrush x:Key="AppAccentTextBrush" Color="#FFFFFFFF" />

    <!-- 主题染色：极淡的一层主题色铺在材质/壁纸之上（莫奈取色与自定义色的落点）。
         运行时由 ThemeColorService 改写这两格颜色，引用它的 Border 会即时重画。 -->
    <LinearGradientBrush x:Key="AppTintBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#222FA35A" Offset="0" />
        <GradientStop Color="#002FA35A" Offset="0.72" />
    </LinearGradientBrush>
    <!-- t55：tint 满色按钮上的文字色（14 语义色深浅主题共用同一组色值，
         故 OnTint 与 AppAccentTextBrush 一样是主题无关令牌，顶层定义） -->
    <SolidColorBrush x:Key="OnTintBrush" Color="#FF12141A" />
    <!-- 品牌绿：固定色，不跟壁纸/系统强调色走。主操作（安装、启动）用它，
         否则壁纸偏红时「安装」会变成像删除的暗红按钮。 -->
    <SolidColorBrush x:Key="AppBrandBrush" Color="#FF2FA35A" />
    <SolidColorBrush x:Key="AppBrandTextBrush" Color="#FFFFFFFF" />
    <!-- 品牌绿浅底：选中行 / 选中项的填充。固定色，和 AppBrandBrush 成对用。 -->
    <SolidColorBrush x:Key="AppBrandSoftBrush" Color="#2E2FA35A" />
    <LinearGradientBrush x:Key="AppLaunchBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF43C477" Offset="0" />
        <GradientStop Color="#FF248B4B" Offset="1" />
    </LinearGradientBrush>

    <!-- 设计令牌：圆角 / 间距 / 字号统一从这里取，避免每页各写一套 -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="RowCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">9</CornerRadius>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="PagePadding">48,20,48,24</Thickness>
    <x:Double x:Key="CardGap">14</x:Double>
    <x:Double x:Key="FontSizeTitle">15</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSmall">11.5</x:Double>
    <!-- 契约 3 补充：display 44（时钟）/ cardTitle 15 / body 13 / caption 11.5（T4–T7 页面换用） -->
    <x:Double x:Key="FontSizeDisplay">44</x:Double>
    <!-- 时钟专用：44px 语义令牌（HomePage 时钟） -->
    <x:Double x:Key="FontSizeClock">44</x:Double>
    <x:Double x:Key="FontSizeCardTitle">15</x:Double>
    <x:Double x:Key="FontSizeCaption">11.5</x:Double>

    <!-- 主题无关的固定色（等值令牌）：语义上不随深浅主题变，
         深浅两主题取到同一个值（保证像素不变）。 -->
    <Color x:Key="ScrimStartColor">#00000000</Color>
    <Color x:Key="ScrimEndColor">#E60B0D11</Color>
    <Color x:Key="ScrimEndStrongColor">#F20B0D11</Color>
    <SolidColorBrush x:Key="TintInkBrush" Color="#FF0B0D11" />
    <SolidColorBrush x:Key="OnCoverBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="ChipOverlayBrush" Color="#40000000" />

    <Style x:Key="WidgetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style x:Key="WidgetLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
        <Setter Property="CharacterSpacing" Value="10" />
    </Style>

    <Style x:Key="WidgetBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NavToggleStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <!-- 焦点环由模板里的 FocusRing 画（2px 强调色，FocusStates 由代码 GoToState 驱动）；
             系统 FocusVisual 关掉，避免窗口非激活时不画环。 -->
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="FocusVisualPrimaryThickness" Value="2" />
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- 导航高亮不走 VSM：本运行时上 VSM Setter 退出状态不回滚，
                         且 IsChecked 变化触发的 CheckStates 切换不生效（红蓝探针实测），
                         会造成「两项同时亮」。高亮/悬停/按压由 MainWindow 代码直接写
                         Background/Opacity，模板只做 TemplateBinding。
                         例外：键盘焦点环必须由模板负责（代码不碰），所以这里挂了
                         FocusStates（Focused/PointerFocused/Unfocused）只切 FocusRing 的
                         Visibility，选中态仍然只有代码写 Background。 -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FocusRing"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center" />
                        </Border>

                        <!-- 2px 焦点环；系统强调色在本机为黑色（AccentColor=0xFF000000），
                             用主题文字色反而对比更稳：深色白环、浅色黑环。 -->
                        <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="2"
                                BorderBrush="{ThemeResource AppTextBrush}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
    </Style>

    <Style x:Key="LaunchButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{StaticResource AppLaunchBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!--
        互斥筛选胶囊：真正的单选控件（RadioButton），选中/悬停/焦点都由控件状态驱动，
        不再由 code-behind 刷 Background。尺寸与 ChipCornerRadius 系一致：高 28、圆角 8、字 11.5。
        用法：Background 给该页的语义色（如 TintRecentBrush），未选中时透明 + 1px 描边。
    -->
    <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- 参照 WinUI 3 SegmentedControl：4px 圆角、选中只用一层极淡填充，不做彩色实心胶囊 -->
                    <Grid x:Name="Root"
                          Height="{TemplateBinding Height}"
                          Background="Transparent"
                          CornerRadius="4"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          BorderBrush="{TemplateBinding BorderBrush}">
                        <Border x:Name="Fill"
                                CornerRadius="4"
                                Background="{ThemeResource AppChipBrush}"
                                Opacity="0" />
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Foreground="{TemplateBinding Foreground}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Opacity" Value="1" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource AppTextBrush}" />
                                        <Setter Target="Label.FontWeight" Value="SemiBold" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 全局胶囊按钮：AccountPage / SettingsPage / InstancePage 共用，别在本页各写一份 -->
    <!-- 全站唯一的「页内分段标签」样式：平时透明，选中为浅色实心胶囊（颜色 / 粗细由页面代码按 AppNavSelectedBrush / AppTextBrush 设置）。
         以前获取 / 实例页用的是系统 ToggleButton 的「选中=深色实心」，设置页是透明底 + 白胶囊，首页是下划线，三套外观。 -->
    <Style x:Key="SegTabToggleStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.8" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.65" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.4" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
    </Style>

    </ResourceDictionary>
