<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      14 个语义色（契约附录 A），
      用法：Tint<Id>Brush 满色用于图标/主数字/进度条；
      Tint<Id>SoftBrush 为混入卡底的浅色版（深色 10% / 浅色 8%，见 ThemeDictionaries）；
      WidgetTintBrush 是通用混底兜底（强调色 #2FA35A 的混底）。
    -->

    <Color x:Key="TintStatusColor">#FF4CC38A</Color>
    <Color x:Key="TintRecentColor">#FF2FA35A</Color>
    <Color x:Key="TintProfileColor">#FFFF7A9C</Color>
    <Color x:Key="TintNewsColor">#FF57C785</Color>
    <Color x:Key="TintFeedColor">#FFFFB45A</Color>
    <Color x:Key="TintStatsColor">#FF6EA8FF</Color>
    <Color x:Key="TintTasksColor">#FF7C9CFF</Color>
    <Color x:Key="TintUpdatesColor">#FFFFC65A</Color>
    <Color x:Key="TintSystemColor">#FF8E9EFF</Color>
    <Color x:Key="TintQuickColor">#FF59C7B0</Color>
    <Color x:Key="TintClockColor">#FFA0A6B8</Color>
    <Color x:Key="TintTipColor">#FFFFB07A</Color>
    <Color x:Key="TintShotsColor">#FFFF8FB1</Color>
    <Color x:Key="TintMediaColor">#FF9B8CFF</Color>

    <SolidColorBrush x:Key="TintStatusBrush" Color="{ThemeResource TintStatusColor}" />
    <SolidColorBrush x:Key="TintRecentBrush" Color="{ThemeResource TintRecentColor}" />
    <SolidColorBrush x:Key="TintProfileBrush" Color="{ThemeResource TintProfileColor}" />
    <SolidColorBrush x:Key="TintNewsBrush" Color="{ThemeResource TintNewsColor}" />
    <SolidColorBrush x:Key="TintFeedBrush" Color="{ThemeResource TintFeedColor}" />
    <SolidColorBrush x:Key="TintStatsBrush" Color="{ThemeResource TintStatsColor}" />
    <SolidColorBrush x:Key="TintTasksBrush" Color="{ThemeResource TintTasksColor}" />
    <SolidColorBrush x:Key="TintUpdatesBrush" Color="{ThemeResource TintUpdatesColor}" />
    <SolidColorBrush x:Key="TintSystemBrush" Color="{ThemeResource TintSystemColor}" />
    <SolidColorBrush x:Key="TintQuickBrush" Color="{ThemeResource TintQuickColor}" />
    <SolidColorBrush x:Key="TintClockBrush" Color="{ThemeResource TintClockColor}" />
    <SolidColorBrush x:Key="TintTipBrush" Color="{ThemeResource TintTipColor}" />
    <SolidColorBrush x:Key="TintShotsBrush" Color="{ThemeResource TintShotsColor}" />
    <SolidColorBrush x:Key="TintMediaBrush" Color="{ThemeResource TintMediaColor}" />

    <ResourceDictionary.ThemeDictionaries>
        <!-- 深色：tint 混入卡底 18%（alpha #2E = 46/255 ≈ 18%） -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TintStatusSoftBrush" Color="#2E4CC38A" />
            <SolidColorBrush x:Key="TintRecentSoftBrush" Color="#2E2FA35A" />
            <SolidColorBrush x:Key="TintProfileSoftBrush" Color="#2EFF7A9C" />
            <SolidColorBrush x:Key="TintNewsSoftBrush" Color="#2E57C785" />
            <SolidColorBrush x:Key="TintFeedSoftBrush" Color="#2EFFB45A" />
            <SolidColorBrush x:Key="TintStatsSoftBrush" Color="#2E6EA8FF" />
            <SolidColorBrush x:Key="TintTasksSoftBrush" Color="#2E7C9CFF" />
            <SolidColorBrush x:Key="TintUpdatesSoftBrush" Color="#2EFFC65A" />
            <SolidColorBrush x:Key="TintSystemSoftBrush" Color="#2E8E9EFF" />
            <SolidColorBrush x:Key="TintQuickSoftBrush" Color="#2E59C7B0" />
            <SolidColorBrush x:Key="TintClockSoftBrush" Color="#2EA0A6B8" />
            <SolidColorBrush x:Key="TintTipSoftBrush" Color="#2EFFB07A" />
            <SolidColorBrush x:Key="TintShotsSoftBrush" Color="#2EFF8FB1" />
            <SolidColorBrush x:Key="TintMediaSoftBrush" Color="#2E9B8CFF" />
            <SolidColorBrush x:Key="WidgetTintBrush" Color="#2E2FA35A" />
            <!-- 当前/选中态：语义色 40% 描边 -->
            <SolidColorBrush x:Key="TintNewsStrokeBrush" Color="#6657C785" />
            <SolidColorBrush x:Key="TintRecentStrokeBrush" Color="#662FA35A" />
            <SolidColorBrush x:Key="TintProfileStrokeBrush" Color="#66FF7A9C" />
            <SolidColorBrush x:Key="TintMediaStrokeBrush" Color="#669B8CFF" />
            <SolidColorBrush x:Key="TintQuickStrokeBrush" Color="#6659C7B0" />
            <SolidColorBrush x:Key="TintTipStrokeBrush" Color="#66FFB07A" />
            <SolidColorBrush x:Key="TintStatsStrokeBrush" Color="#666EA8FF" />
            <!-- 设置页分段控件：选中段用品牌色 16% 底 + 品牌色字，不抢强调按钮 -->
            <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#2957C785" />
            <SolidColorBrush x:Key="SegmentSelectedTextBrush" Color="#57C785" />
            <!-- ToggleSwitch 统一成品牌绿，别和分段控件一个绿一个蓝 -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2FA35A" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#35B364" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#288C4E" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2FA35A" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#35B364" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#288C4E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />

        </ResourceDictionary>

        <!-- 浅色：tint 混入卡底 14%（alpha #24 = 36/255 ≈ 14%） -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TintStatusSoftBrush" Color="#244CC38A" />
            <SolidColorBrush x:Key="TintRecentSoftBrush" Color="#242FA35A" />
            <SolidColorBrush x:Key="TintProfileSoftBrush" Color="#24FF7A9C" />
            <SolidColorBrush x:Key="TintNewsSoftBrush" Color="#2457C785" />
            <SolidColorBrush x:Key="TintFeedSoftBrush" Color="#24FFB45A" />
            <SolidColorBrush x:Key="TintStatsSoftBrush" Color="#246EA8FF" />
            <SolidColorBrush x:Key="TintTasksSoftBrush" Color="#247C9CFF" />
            <SolidColorBrush x:Key="TintUpdatesSoftBrush" Color="#24FFC65A" />
            <SolidColorBrush x:Key="TintSystemSoftBrush" Color="#248E9EFF" />
            <SolidColorBrush x:Key="TintQuickSoftBrush" Color="#2459C7B0" />
            <SolidColorBrush x:Key="TintClockSoftBrush" Color="#24A0A6B8" />
            <SolidColorBrush x:Key="TintTipSoftBrush" Color="#24FFB07A" />
            <SolidColorBrush x:Key="TintShotsSoftBrush" Color="#24FF8FB1" />
            <SolidColorBrush x:Key="TintMediaSoftBrush" Color="#249B8CFF" />
            <SolidColorBrush x:Key="WidgetTintBrush" Color="#242FA35A" />
            <!-- 当前/选中态：语义色 40% 描边 -->
            <SolidColorBrush x:Key="TintNewsStrokeBrush" Color="#6657C785" />
            <SolidColorBrush x:Key="TintRecentStrokeBrush" Color="#662FA35A" />
            <SolidColorBrush x:Key="TintProfileStrokeBrush" Color="#66FF7A9C" />
            <SolidColorBrush x:Key="TintMediaStrokeBrush" Color="#669B8CFF" />
            <SolidColorBrush x:Key="TintQuickStrokeBrush" Color="#6659C7B0" />
            <SolidColorBrush x:Key="TintTipStrokeBrush" Color="#66FFB07A" />
            <SolidColorBrush x:Key="TintStatsStrokeBrush" Color="#666EA8FF" />
            <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#292FA35A" />
            <SolidColorBrush x:Key="SegmentSelectedTextBrush" Color="#167A43" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#1E7A45" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#228A4E" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1A6B3C" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#1E7A45" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#228A4E" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1A6B3C" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />

        </ResourceDictionary>

        <!-- t55：HighContrast 变体。不依赖透明度表达层级：Soft 混底全部退为实心系统色，
             语义由满色 Tint*Brush（顶层、不透明）继续承担。 -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TintStatusSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintRecentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintProfileSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintNewsSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintFeedSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintStatsSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintTasksSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintUpdatesSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintSystemSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintQuickSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintClockSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintTipSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintShotsSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintMediaSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WidgetTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TintNewsStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TintRecentStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TintProfileStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TintMediaStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TintQuickStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TintTipStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TintStatsStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
