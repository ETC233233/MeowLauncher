<UserControl
    x:Class="MeowLauncher.WinUI.Controls.TaskIsland"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IslandTriggerStyle" TargetType="Button">
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="HitSurface" CornerRadius="17" Background="Transparent">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HitSurface.Background" Value="{ThemeResource AppChipBrush}"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HitSurface.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/></VisualState.Setters></VisualState>
                        <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="HitSurface.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Pill" Width="132" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top"
            CornerRadius="18" BorderThickness="1" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeBrush}">
        <Button x:Name="Trigger" Style="{StaticResource IslandTriggerStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="0" MinWidth="0" MinHeight="0" Click="Trigger_Click" AutomationProperties.Name="打开任务与通知">
            <Grid>
                <Grid x:Name="IdleSurface" ColumnSpacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEA8F;" FontSize="15" Foreground="{ThemeResource AppText2Brush}"/>
                    <TextBlock Grid.Column="1" Text="任务与通知" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="WorkSurface" ColumnSpacing="11" Margin="14,0" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="22" Height="22" VerticalAlignment="Center">
                        <Image x:Name="PrimaryIcon" Width="22" Height="22" Stretch="Uniform" Visibility="Collapsed"/>
                        <FontIcon x:Name="StateIcon" Glyph="&#xE896;" FontSize="17" Foreground="{ThemeResource AppText2Brush}"/>
                    </Grid>
                    <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock x:Name="PercentText" Grid.Column="2" FontSize="13" VerticalAlignment="Center"/>
                </Grid>
                <Grid x:Name="CompactTrack" Height="2" Margin="47,0,14,3" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
                    <Border Background="{ThemeResource AppChipBrush}" CornerRadius="1"/>
                    <Border x:Name="CompactFill" Background="{ThemeResource AppAccentBrush}" CornerRadius="1" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="CompactScale" ScaleX="0"/></Border.RenderTransform>
                    </Border>
                    <ProgressBar x:Name="CompactIndeterminate" Height="2" IsIndeterminate="True" Background="Transparent" Foreground="{ThemeResource AppAccentBrush}" Visibility="Collapsed"/>
                </Grid>
                <Border x:Name="UnreadDot" Width="5" Height="5" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,7,0"
                        Background="{ThemeResource AppAccentBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Button>
    </Border>
</UserControl>
