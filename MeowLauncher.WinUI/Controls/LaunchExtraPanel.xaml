<UserControl
    x:Class="MeowLauncher.WinUI.Controls.LaunchExtraPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 启动附加设置：窗口 / 进服 / 游戏参数 / 进程。全局设置页和实例页共用同一个控件。
         行结构一律 [标签 156 | 控件 *]，标签与控件垂直居中；说明文字放在控件下方，不另起一行布局。
         高级项放在 Expander 里默认收起。 -->
    <StackPanel Spacing="14">
        <Grid ColumnSpacing="14" RowSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="游戏窗口" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <NumberBox x:Name="WidthBox" Width="110" Height="32" VerticalAlignment="Center"
                           VerticalContentAlignment="Center" Minimum="0" Maximum="16384" PlaceholderText="宽"
                           ValueChanged="AnyChanged2" />
                <TextBlock Text="×" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" />
                <NumberBox x:Name="HeightBox" Width="110" Height="32" VerticalAlignment="Center"
                           VerticalContentAlignment="Center" Minimum="0" Maximum="16384" PlaceholderText="高"
                           ValueChanged="AnyChanged2" />
                <TextBlock Text="全屏" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <ToggleSwitch x:Name="FullscreenSwitch" OnContent="" OffContent="" MinWidth="0" Width="56" Margin="0,0,-12,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              AutomationProperties.Name="全屏游戏窗口" Toggled="AnyChanged" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="加入服务器" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" />
            <TextBox x:Name="ServerBox" Grid.Row="1" VerticalAlignment="Center" Grid.Column="1" PlaceholderText="留空则不自动进服，例如 play.example.com:25565"
                     TextChanged="AnyChanged3" />

            <TextBlock Grid.Row="2" Text="进程优先级" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" />
            <ComboBox x:Name="PriorityBox" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Center" Grid.Column="1" MinWidth="160" SelectionChanged="AnyChanged4">
                <ComboBoxItem Content="低于正常" Tag="below" />
                <ComboBoxItem Content="正常" Tag="normal" />
                <ComboBoxItem Content="高于正常" Tag="above" />
            </ComboBox>
        </Grid>

        <Expander Header="高级" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12">
                <TextBlock Text="写错这里会导致游戏无法启动。" FontSize="12" Foreground="{ThemeResource AppText3Brush}" />
                <TextBox x:Name="GameArgsBox" Header="额外游戏参数" PlaceholderText="--demo  --quickPlaySingleplayer 存档名"
                         TextChanged="AnyChanged3" />
                <TextBox x:Name="EnvBox" Header="环境变量（每行一条 KEY=VALUE）" AcceptsReturn="True" MinHeight="72"
                         TextWrapping="NoWrap" TextChanged="AnyChanged3" />
                <TextBox x:Name="WrapperBox" Header="启动前包装命令" PlaceholderText="例如 optirun"
                         TextChanged="AnyChanged3" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
