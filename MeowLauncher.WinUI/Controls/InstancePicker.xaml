<UserControl
    x:Class="MeowLauncher.WinUI.Controls.InstancePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeowLauncher.WinUI.Controls">

    <!-- 实例选择列表：搜索框 + 可滚动行。两行一项：名称 / 版本·加载器·上次游玩；当前实例绿点，运行中打胶囊。
         同一个控件用在顶栏下拉（InstanceSwitcher）和搜索里的「选择其他实例…」对话框。 -->
    <Grid Width="400" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="FilterBox" Height="36" PlaceholderText="搜索实例（名称 / 版本 / 加载器）"
                 TextChanged="FilterBox_TextChanged" AutomationProperties.Name="搜索实例" />

        <ListView x:Name="List" Grid.Row="1" MaxHeight="360" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="List_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:InstanceRow">
                    <Grid Padding="2,6" ColumnSpacing="10" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28" VerticalAlignment="Center">
                            <Border CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind IconSource}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-2,-2" Stroke="{ThemeResource AppCardBrush}" StrokeThickness="1.5"
                                     Fill="{ThemeResource AppAccentBrush}"
                                     Visibility="{x:Bind DotVisibility}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Sub}" FontSize="12"
                                       Foreground="{ThemeResource AppText2Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                                Background="{ThemeResource AppAccentSoftBrush}"
                                Visibility="{x:Bind BadgeVisibility}">
                            <TextBlock Text="{x:Bind Badge}" FontSize="11.5"
                                       Foreground="{ThemeResource AppAccentTextBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="没有匹配的实例" FontSize="12"
                   Foreground="{ThemeResource AppText2Brush}" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Margin="0,24" Visibility="Collapsed" />
    </Grid>
</UserControl>
