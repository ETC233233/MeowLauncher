<UserControl
    x:Class="MeowLauncher.WinUI.Controls.InstanceSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MeowLauncher.WinUI.Controls">

    <!-- 页头里的「当前实例」胶囊：绿点 + 名称 + 版本·加载器 + 下拉箭头。
         点开是一个带搜索的实例列表，选中即切换（走 InstanceSelection，和首页、版本页同一条路径）。
         放在 Mod 管理 / 实例资源 / 日志 / 实例页的页头右侧，让用户随时知道「现在操作的是哪个实例」。 -->
    <Button x:Name="Chip" Height="36" Padding="12,0" CornerRadius="10" BorderThickness="1"
            Background="{ThemeResource AppChipBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
            AutomationProperties.Name="切换实例" ToolTipService.ToolTip="切换当前实例">
        <Button.Flyout>
            <Flyout x:Name="PickFlyout" Placement="BottomEdgeAlignedRight" Opening="PickFlyout_Opening"
                    Opened="PickFlyout_Opened">
                <StackPanel Spacing="0">
                    <local:InstancePicker x:Name="Picker" HorizontalAlignment="Stretch" />
                    <Border Height="1" Margin="0,6,0,6" Background="{ThemeResource CardStrokeBrush}" />
                    <Button x:Name="ManageAllButton" Click="ManageAll_Click" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Height="36" Padding="12,0"
                            Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="管理全部实例">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE71D;" FontSize="13" Foreground="{ThemeResource AppText2Brush}" />
                            <TextBlock Text="管理全部实例…" FontSize="12" Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border x:Name="Dot" Width="22" Height="22" CornerRadius="5" VerticalAlignment="Center">
                <Border.Background>
                    <ImageBrush x:Name="IconBrush" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <TextBlock x:Name="NameText" Text="—" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource AppTextBrush}" MaxWidth="220"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="SubText" FontSize="12" Foreground="{ThemeResource AppText2Brush}"
                       MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <FontIcon x:Name="Chevron" Glyph="&#xE70D;" FontSize="11.5" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
