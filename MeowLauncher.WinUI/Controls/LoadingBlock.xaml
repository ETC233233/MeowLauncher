<UserControl
    x:Class="MeowLauncher.WinUI.Controls.LoadingBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
        <ProgressRing x:Name="Ring" Width="32" Height="32" IsActive="False" />
        <TextBlock x:Name="MainText" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource AppText2Brush}" HorizontalAlignment="Center" />
        <TextBlock x:Name="WaitText" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource AppText3Brush}" HorizontalAlignment="Center"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
