<UserControl
    x:Class="MeowLauncher.WinUI.Controls.NotificationToastCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" UseLayoutRounding="True">
    <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
            CornerRadius="10" Padding="14,12,12,12">
        <Grid ColumnSpacing="11" RowSpacing="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Width="36" Height="36" CornerRadius="8" VerticalAlignment="Top"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid IsHitTestVisible="False">
                    <FontIcon x:Name="NoticeIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                              Foreground="{ThemeResource AppText2Brush}" />
                    <Image x:Name="TargetIcon" Width="22" Height="22" Visibility="Collapsed" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="Category" FontSize="12" Foreground="{ThemeResource AppText3Brush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Body" FontSize="13" Foreground="{ThemeResource AppText2Brush}"
                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ReplyStatus" FontSize="12" Foreground="{ThemeResource AppText2Brush}"
                           TextWrapping="Wrap" MaxLines="2" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                    BorderThickness="0" Background="Transparent" VerticalAlignment="Top"
                    AutomationProperties.Name="关闭通知" Click="Close_Click">
                <FontIcon FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="11"
                          Foreground="{ThemeResource AppText2Brush}" />
            </Button>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" x:Name="Actions" Orientation="Horizontal" Spacing="6"
                        HorizontalAlignment="Right" Visibility="Collapsed">
                <Button x:Name="DeclineButton" Content="拒绝" Visibility="Collapsed" Click="Decline_Click" />
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" Click="Primary_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
