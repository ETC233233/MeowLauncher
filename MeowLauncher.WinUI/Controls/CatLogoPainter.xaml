<UserControl
    x:Class="MeowLauncher.WinUI.Controls.CatLogoPainter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="96" Height="96">
    <Grid>
        <!-- 加载失败时的静态兜底 -->
        <Image x:Name="Fallback" Source="ms-appx:///Assets/default_icon.png" Stretch="Uniform" Visibility="Collapsed"/>
        <Canvas x:Name="Paint" Width="96" Height="96" UseLayoutRounding="True" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform><ScaleTransform x:Name="Pulse" ScaleX="1" ScaleY="1"/></Canvas.RenderTransform>
        </Canvas>
    </Grid>
</UserControl>
