<UserControl
    x:Class="MeowLauncher.WinUI.Controls.SkinRenderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 首页/档案用的透明皮肤立绘：本地 skinview3d 离屏渲染一张透明 PNG。
         首次渲染后按「皮肤 + 披风 + 尺寸 + 视角」落盘缓存，下次进来直接显示缓存图；
         没有缓存时只显示一个小转圈，不再做软件光栅兜底。 -->
    <Grid x:Name="Host" Background="Transparent"
          AutomationProperties.AccessibilityView="Raw">
        <WebView2 x:Name="Web"
                  Width="1" Height="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Opacity="0.01" IsHitTestVisible="False" />
        <Image x:Name="Rendered"
               Stretch="Uniform"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
        <ProgressRing x:Name="LoadingRing"
                      Width="18" Height="18" IsActive="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed"
                      AutomationProperties.Name="正在加载皮肤立绘" />
        <TextBlock x:Name="ErrorText"
                   Text="皮肤预览加载失败"
                   FontSize="{StaticResource FontSizeCaption}"
                   Foreground="{ThemeResource AppText3Brush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
