                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusCount2" Text="" FontSize="28" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatusDetail2" Text="" FontSize="11.5"
