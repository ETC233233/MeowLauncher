                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                    <TextBlock Text="下载" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                </StackPanel>
                            </Button>
                            <!-- 2×1：一行四颗（2×1 宽 688，足够四宫格拆成一行） -->
                            <Grid x:Name="QuickTier2" Visibility="Collapsed" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="QuickDownload2" Tag="download" Click="Quick_Click"
                                        CornerRadius="12" BorderThickness="0" Background="{ThemeResource AppChipBrush}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12,0"
                                        AutomationProperties.Name="打开下载页" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="下载" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickMods2" Grid.Column="1" Tag="mods" Click="Quick_Click"
                                        CornerRadius="12" BorderThickness="0" Background="{ThemeResource AppChipBrush}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12,0"
                                        AutomationProperties.Name="打开模组页" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="模组" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickVersions2" Grid.Column="2" Tag="versions" Click="Quick_Click"
