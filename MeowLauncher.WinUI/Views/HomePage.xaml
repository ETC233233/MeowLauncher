                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="下载" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickMods4" Grid.Column="1" Tag="mods" Click="Quick_Click" CornerRadius="12" BorderThickness="0"
                                        Background="{ThemeResource AppChipBrush}" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" Padding="12,0"
                                        AutomationProperties.Name="打开模组页" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="模组" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickVersions4" Grid.Row="1" Tag="versions" Click="Quick_Click" CornerRadius="12" BorderThickness="0"
                                        Background="{ThemeResource AppChipBrush}" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" Padding="12,0"
                                        AutomationProperties.Name="打开版本页" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="版本" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickShots4" Grid.Row="1" Grid.Column="1" Tag="shots" Click="Quick_Click" CornerRadius="12" BorderThickness="0"
                                        Background="{ThemeResource AppChipBrush}" HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" Padding="12,0"
                                        AutomationProperties.Name="打开截图" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="截图" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 任务（tint tasks #7C9CFF） -->
                <Border x:Name="TasksCard" AutomationProperties.Name="任务" Style="{StaticResource WidgetCardStyle}" Padding="0" Visibility="Collapsed"
                        Tapped="OpenTasks_Tapped">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                        <Grid>
                        <!-- 无障碍/自动化锚点：卡片标题在任何档位下都能被读屏与截图校验读到（不占位、不可见） -->
                        <TextBlock Text="任务" FontSize="11.5" Opacity="0" IsHitTestVisible="False" IsTabStop="False"/>
                            <!-- 1×1：只主数字（真实队列） -->
                            <StackPanel x:Name="TasksTier1" Visibility="Collapsed" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D5;" FontSize="13" Foreground="{ThemeResource TintTasksBrush}"/>
                                <TextBlock x:Name="TaskCount1" Text="队列空闲" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 2×1：标题 + 进度条 + 当前任务名 -->
                            <Grid x:Name="TasksTier2" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D5;" FontSize="11.5" Foreground="{ThemeResource TintTasksBrush}"/>
                                        <TextBlock Text="任务" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TaskPercentText" Grid.Column="1" Text="队列空闲" FontSize="11.5"
                                               Foreground="{ThemeResource AppText3Brush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="TaskProgress" Grid.Row="1" Height="4" Margin="0,8,0,0"
                                             Foreground="{ThemeResource TintTasksBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TaskSub" Grid.Row="2" Text="" FontSize="11.5"
                                           Foreground="{ThemeResource AppText3Brush}" Margin="0,8,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <!-- 4×1：整行状态条，给第二页收底；空闲时也写清这里会出现什么 -->
                            <Grid x:Name="TasksTierWide" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9D5;" FontSize="11.5" Foreground="{ThemeResource TintTasksBrush}"/>
                                        <TextBlock Text="任务" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="TaskWideCount" Text="队列空闲" FontSize="11.5"
                                                   Foreground="{ThemeResource AppText3Brush}"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="TaskWideProgress" Grid.Row="1" Height="4" Margin="0,8,0,0"
                                             Foreground="{ThemeResource TintTasksBrush}" Visibility="Collapsed"/>
                                <TextBlock x:Name="TaskWideSub" Grid.Row="2" Text="安装、下载、启动的进度会出现在这里。"
                                           FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"
                                           Margin="0,8,0,0" VerticalAlignment="Top"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 每日一帖（tint tip #FFB07A） -->
                <Border x:Name="TipCard" AutomationProperties.Name="每日一帖" Style="{StaticResource WidgetCardStyle}" Padding="0" Visibility="Collapsed"
                        Tapped="OpenWiki_Tapped">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                        <Grid>
                        <!-- 无障碍/自动化锚点：卡片标题在任何档位下都能被读屏与截图校验读到（不占位、不可见） -->
                        <TextBlock Text="每日一帖" FontSize="11.5" Opacity="0" IsHitTestVisible="False" IsTabStop="False"/>
                            <!-- 1×1：一句话 + 来源图标 -->
                            <Grid x:Name="TipTier1" Visibility="Collapsed" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE82F;" FontSize="13" Foreground="{ThemeResource TintTipBrush}"
                                          VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <TextBlock x:Name="TipText1" Grid.Column="1" Text="正在取最新一帖…"
                                           FontSize="12" Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <!-- 2×1：封面铺满 + 底部渐变 + 左上标签 + 底部标题/元信息（与当前实例同一套压字规则） -->
                            <Grid x:Name="TipTier2" Visibility="Collapsed" Margin="-12">
                                <Grid>
                                    <Border x:Name="TipImageHost2" Background="{ThemeResource TintTipSoftBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE82F;" FontSize="20" Foreground="{ThemeResource TintTipBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="TipImage2" Stretch="UniformToFill" Visibility="Collapsed"
                                                   AutomationProperties.AccessibilityView="Raw"/>
                                        </Grid>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Height="130">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#D9000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Margin="16,14,16,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE82F;" FontSize="12" Foreground="White" Opacity="0.9"/>
                                            <TextBlock Text="每日一帖" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" Opacity="0.9"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock x:Name="TipTitle2" Text="正在取最新一帖…" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="White" TextWrapping="NoWrap" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="TipMeta2" Text="Mojang 新闻" FontSize="12"
                                                       Foreground="White" Opacity="0.78" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <!-- 2×2：配图 + 标题 + 摘要 + 日期，全部来自 Mojang 官方内容接口 -->
                            <Grid x:Name="TipTier4" Visibility="Collapsed" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="TipImageHost4" Width="188" CornerRadius="12" VerticalAlignment="Stretch"
                                        Background="{ThemeResource TintTipSoftBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE82F;" FontSize="20" Foreground="{ThemeResource TintTipBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="TipImage4" Stretch="UniformToFill" Visibility="Collapsed"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="TipTag4" Text="Mojang 新闻" FontSize="11.5"
                                                   Foreground="{ThemeResource TintTipBrush}"/>
                                        <TextBlock x:Name="TipDate4" Text="" FontSize="11.5"
                                                   Foreground="{ThemeResource AppText3Brush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TipTitle4" Text="正在取最新一帖…" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TipSub4" Text="" FontSize="12" LineHeight="19"
                                               Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                        <TextBlock Text="阅读原文" FontSize="12" Foreground="{ThemeResource TintTipBrush}"/>
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" Foreground="{ThemeResource TintTipBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 固定版本（4×1，tint updates #FFC65A）：钉住的实例直接启，横向一行，钉多少给多少 -->
                <Border x:Name="PinnedCard" AutomationProperties.Name="固定版本" Style="{StaticResource WidgetCardStyle}"
                        Padding="0" Visibility="Collapsed">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE840;" FontSize="11.5" Foreground="{ThemeResource TintUpdatesBrush}"/>
                                    <TextBlock Text="固定版本" FontSize="11.5" Foreground="{ThemeResource TintUpdatesBrush}"/>
                                </StackPanel>
                                <Button x:Name="PinnedMore4" HorizontalAlignment="Right" Height="32" Width="32" Padding="0"
                                        CornerRadius="4" BorderThickness="0" Background="Transparent"
                                        Click="PinnedMore_Click" AutomationProperties.Name="打开版本管理" IsTabStop="False">
                                    <TextBlock Text="管理" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"/>
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PinnedCardList" Orientation="Horizontal" Spacing="10"/>
                            </ScrollViewer>
                            <TextBlock x:Name="PinnedCardEmpty" Grid.Row="1"
                                       Text="还没有固定版本。到版本页右键实例，「固定到首页」。"
                                       FontSize="12" Foreground="{ThemeResource AppText3Brush}"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </Border>
        </Grid>
        </ScrollViewer>

        <!-- 首次加载骨架：只铺卡位灰块，绝不显示假数字 -->
        <Grid x:Name="SkeletonLayer" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="16"
              Width="960" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="228"/>
                <RowDefinition Height="228"/>
                <RowDefinition Height="228"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Style="{StaticResource WidgetCardStyle}" Background="{ThemeResource AppChipBrush}" Opacity="0.55"/>
            <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="1" Style="{StaticResource WidgetCardStyle}" Background="{ThemeResource AppChipBrush}" Opacity="0.55"/>
            <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="1" Grid.ColumnSpan="1" Style="{StaticResource WidgetCardStyle}" Background="{ThemeResource AppChipBrush}" Opacity="0.45"/>
            <Border Grid.Row="1" Grid.Column="3" Grid.RowSpan="1" Grid.ColumnSpan="1" Style="{StaticResource WidgetCardStyle}" Background="{ThemeResource AppChipBrush}" Opacity="0.45"/>
            <Border Grid.Row="2" Grid.Column="0" Grid.RowSpan="1" Grid.ColumnSpan="2" Style="{StaticResource WidgetCardStyle}" Background="{ThemeResource AppChipBrush}" Opacity="0.45"/>
            <Border Grid.Row="2" Grid.Column="2" Grid.RowSpan="1" Grid.ColumnSpan="2" Style="{StaticResource WidgetCardStyle}" Background="{ThemeResource AppChipBrush}" Opacity="0.45"/>
        </Grid>

        <!-- 拉快照失败：整板错误态，带重试（原地重发，不要求重开窗口） -->
        <Grid x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed">
            <Border Style="{StaticResource WidgetCardStyle}" MaxWidth="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource AppBadBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="读取本机数据失败" FontSize="14" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorSummary" FontSize="11.5" MaxWidth="380" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"/>
                    <Button x:Name="RetryButton" Content="重试" Height="32" CornerRadius="16" Padding="18,0"
                            BorderThickness="0" Background="{ThemeResource AppChipBrush}"
                            HorizontalAlignment="Center" Click="Retry_Click" IsTabStop="False"
                            AutomationProperties.Name="重新读取本机数据"/>
                </StackPanel>
            </Border>
        </Grid>
            </Grid>
        </Grid>

        <!-- 页脚：翻页 + 编辑态操作 -->
        <Grid x:Name="BoardFooter" Grid.Row="2">
            <PipsPager x:Name="BoardPager" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Orientation="Horizontal" NumberOfPages="2" SelectedPageIndex="0"
                       SelectedIndexChanged="BoardPager_SelectedIndexChanged"
                       AutomationProperties.Name="组件板翻页"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="AddWidgetBtn" Height="32" CornerRadius="16" Padding="12,0"
                        BorderThickness="0" Background="{ThemeResource AppChipBrush}" Click="AddWidget_Click"
                        Visibility="Collapsed" AutomationProperties.Name="添加小组件" IsTabStop="False">
                    <TextBlock Text="＋ 添加小组件" FontSize="11.5"/>
                </Button>
                <Button x:Name="ResetLayoutBtn" Height="32" CornerRadius="16" Padding="12,0"
                        BorderThickness="0" Background="{ThemeResource AppChipBrush}" Click="ResetLayout_Click"
                        Visibility="Collapsed"
                        AutomationProperties.Name="恢复默认布局" IsTabStop="False">
                    <TextBlock Text="恢复默认" FontSize="11.5"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 首次读取本机数据（实例 / 账户）：不让玩家对着空白发愣 -->
        <Border x:Name="HomeLoading" Grid.RowSpan="2" Canvas.ZIndex="45" Visibility="Collapsed"
                IsHitTestVisible="False" Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F21C1C1C" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="36,26" MinWidth="300">
                <controls:LoadingBlock x:Name="HomeLoadingBlock" Text="正在读取实例和账户…"
                                       Tint="{ThemeResource TintRecentBrush}" />
            </Border>
        </Border>

        <!-- 启动遮罩：点启动后立刻盖住整页，避免「点了没反应」，直到游戏进程被检测到 -->
        <Grid x:Name="LaunchOverlay" Grid.RowSpan="2" Canvas.ZIndex="50"
              Background="#B8050505" Visibility="Collapsed" Opacity="0">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#F21C1C1C" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}" Padding="32,26" MinWidth="360">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <ProgressRing x:Name="LaunchOverlayRing" Width="38" Height="38"
                                  IsActive="True" AutomationProperties.Name="正在启动游戏"/>
                    <TextBlock x:Name="LaunchOverlayTitle" Text="正在启动" FontSize="20" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LaunchOverlayName" Text="" FontSize="14"
                               Foreground="{ThemeResource AppText2Brush}" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    <TextBlock x:Name="LaunchOverlayStage" Text="正在准备启动…" FontSize="12"
                               Foreground="{ThemeResource AppText3Brush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast -->
        <InfoBar x:Name="Toast" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 MaxWidth="380" Margin="0,0,8,6" IsOpen="False"/>
    </Grid>
</Page>
