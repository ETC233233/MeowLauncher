                                        <Border x:Name="ShotWideThumb1Slot" CornerRadius="14" Background="{ThemeResource AppChipBrush}">
                                            <Image x:Name="ShotWideThumb1" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border x:Name="ShotWideThumb2Slot" Grid.Row="1" CornerRadius="14" Background="{ThemeResource AppChipBrush}"
                                                Visibility="Collapsed">
                                            <Image x:Name="ShotWideThumb2" Stretch="UniformToFill"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="ShotsWideEmpty" Grid.Row="1" Text="暂无截图。进游戏按 F2，截图会出现在这里。"
                                           FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 快捷操作（tint quick #59C7B0）：契约 11.3 唯一豁免，每格一个按钮 -->
                <Border x:Name="QuickCard" AutomationProperties.Name="快捷操作" Style="{StaticResource WidgetCardStyle}" Padding="0" Visibility="Collapsed">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                        <Grid>
                        <!-- 无障碍/自动化锚点：卡片标题在任何档位下都能被读屏与截图校验读到（不占位、不可见） -->
                        <TextBlock Text="快捷操作" FontSize="11.5" Opacity="0" IsHitTestVisible="False" IsTabStop="False"/>
