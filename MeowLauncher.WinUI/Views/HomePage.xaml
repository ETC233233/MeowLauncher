                                        AutomationProperties.Name="打开版本页" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE81C;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="版本" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="QuickShots2" Grid.Column="3" Tag="shots" Click="Quick_Click"
                                        CornerRadius="12" BorderThickness="0" Background="{ThemeResource AppChipBrush}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12,0"
                                        AutomationProperties.Name="打开截图" IsTabStop="False">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}"/>
                                        <TextBlock Text="截图" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <!-- 2×2：四格操作 -->
                            <Grid x:Name="QuickTier4" Visibility="Collapsed" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="QuickDownload4" Tag="download" Click="Quick_Click" CornerRadius="12" BorderThickness="0"
