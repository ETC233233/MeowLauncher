                            <!-- 2×1：标题 + 最近 2 条（标题 16 + 间距 2 + 2×28 正好塞进 88） -->
                            <Grid x:Name="RecentTier2" Visibility="Collapsed" RowSpacing="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="最近启动" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TintRecentBrush}"/>
                                <StackPanel x:Name="RecentList" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RecentEmpty" Text="还没有启动记录" FontSize="11.5"
                                           Foreground="{ThemeResource AppText3Brush}"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <!-- 2×2：加信息不加留白——多两条记录 + 分行铺开，照样一眼扫完 -->
                            <Grid x:Name="RecentTier4" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="最近启动" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TintRecentBrush}"/>
                                <StackPanel x:Name="RecentList4" Grid.Row="1" VerticalAlignment="Top" Margin="0,6,0,0" Spacing="2"/>
                                <TextBlock x:Name="RecentEmpty4" Grid.Row="1" Text="还没有启动记录" FontSize="11.5"
                                           Foreground="{ThemeResource AppText3Brush}"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 系统媒体（tint media #9B8CFF） -->
                <Border x:Name="MediaCard" AutomationProperties.Name="系统媒体" Style="{StaticResource WidgetCardStyle}" Padding="0" Visibility="Collapsed"
                        Tapped="MediaCard_Tapped">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                        <Grid>
                        <!-- 无障碍/自动化锚点：卡片标题在任何档位下都能被读屏与截图校验读到（不占位、不可见） -->
                        <TextBlock Text="系统媒体" FontSize="11.5" Opacity="0" IsHitTestVisible="False" IsTabStop="False"/>
                            <!-- 1×1：标题 + 艺术家，无封面无进度 -->
                            <StackPanel x:Name="MediaTier1" Visibility="Collapsed" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="MediaTitle1" Text="没有正在播放" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="MediaSub1" Text="打开网易云 / Spotify" FontSize="11.5"
                                           Foreground="{ThemeResource AppText3Brush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 2×1：封面/图标 + 标题 + 艺术家 + 只读进度条 -->
                            <Grid x:Name="MediaTier2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="9" Background="{ThemeResource AppChipBrush}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="20" Foreground="{ThemeResource TintMediaBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="系统媒体" FontSize="11.5" Foreground="{ThemeResource TintMediaBrush}"/>
                                    <TextBlock x:Name="MediaTitle" Text="没有正在播放" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaSub" Text="打开网易云 / Spotify" FontSize="11.5"
                                               Foreground="{ThemeResource AppText3Brush}" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar x:Name="MediaProgress" Height="2" Margin="0,6,0,0" Minimum="0" Maximum="1"
                                                 IsIndeterminate="True" IsHitTestVisible="False"
                                                 Foreground="{ThemeResource TintMediaBrush}" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                            <!-- 4×1：整行给媒体——封面 + 标题/艺人 + 真实进度 + 上一首/播放/下一首（都由系统会话提供） -->
                            <Grid x:Name="MediaTier4" Visibility="Collapsed" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="76" Height="76" CornerRadius="12" VerticalAlignment="Center"
                                        Background="{ThemeResource TintMediaSoftBrush}">
                                    <Grid>
                                        <FontIcon x:Name="MediaCoverIcon4" Glyph="&#xE8D6;" FontSize="20"
                                                  Foreground="{ThemeResource TintMediaBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="MediaCover4" Stretch="UniformToFill" Visibility="Collapsed"
                                               AutomationProperties.AccessibilityView="Raw"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="系统媒体" FontSize="11.5" Foreground="{ThemeResource TintMediaBrush}"/>
                                    <TextBlock x:Name="MediaTitle4" Text="没有正在播放" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaSub4" Text="打开网易云 / Spotify" FontSize="11.5"
                                               Foreground="{ThemeResource AppText3Brush}" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,6,0,0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="MediaProgress4" Height="3" Minimum="0" Maximum="1"
                                                     VerticalAlignment="Center" IsHitTestVisible="False"
                                                     Foreground="{ThemeResource TintMediaBrush}"
                                                     Background="{ThemeResource AppChipBrush}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="MediaTime4" Grid.Column="1" FontSize="12"
                                                   Foreground="{ThemeResource AppText3Brush}" Visibility="Collapsed"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button x:Name="MediaPrev4" Style="{StaticResource QuietIconButtonStyle}"
                                            Width="34" Height="32" Click="MediaPrev_Click"
                                            AutomationProperties.Name="上一首" IsTabStop="False">
                                        <FontIcon Glyph="&#xE892;" FontSize="12"/>
                                    </Button>
                                    <Button x:Name="MediaPlay4" Style="{StaticResource QuietIconButtonStyle}"
                                            Width="32" Height="32" Click="MediaPlay_Click"
                                            AutomationProperties.Name="播放或暂停" IsTabStop="False">
                                        <FontIcon x:Name="MediaPlayIcon4" Glyph="&#xE768;" FontSize="14"/>
                                    </Button>
                                    <Button x:Name="MediaNext4" Style="{StaticResource QuietIconButtonStyle}"
                                            Width="34" Height="32" Click="MediaNext_Click"
                                            AutomationProperties.Name="下一首" IsTabStop="False">
                                        <FontIcon Glyph="&#xE893;" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <!-- 截图墙（tint shots #FF8FB1） -->
                <Border x:Name="ShotsCard" AutomationProperties.Name="截图墙" Style="{StaticResource WidgetCardStyle}" Padding="0" Visibility="Collapsed"
                        Tapped="OpenShots_Tapped">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
                        <Grid>
                        <!-- 无障碍/自动化锚点：卡片标题在任何档位下都能被读屏与截图校验读到（不占位、不可见） -->
                        <TextBlock Text="截图墙" FontSize="11.5" Opacity="0" IsHitTestVisible="False" IsTabStop="False"/>
                            <!-- 1×1：首图铺满 + 底部压字 + 张数角标（吸收自 C 样式） -->
                            <Grid x:Name="ShotsTier1" Visibility="Collapsed">
                                <Image x:Name="ShotsHero1" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Height="72">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="{StaticResource ScrimStartColor}" Offset="0"/>
                                            <GradientStop Color="{StaticResource ScrimEndColor}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="10,0,10,10">
                                    <FontIcon Glyph="&#xE722;" FontSize="11.5" Foreground="White"/>
                                    <TextBlock Text="截图墙" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                                        CornerRadius="9" Background="{StaticResource ChipOverlayBrush}" Padding="7,2">
                                    <TextBlock x:Name="ShotsCount1" FontSize="11.5" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="ShotsEmpty1" Text="暂无截图" FontSize="12"
                                           Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>

                            <!-- 2×1：四张缩略 + 计数胶囊 -->
                            <Grid x:Name="ShotsTier2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE722;" FontSize="11.5" Foreground="{ThemeResource TintShotsBrush}"
                                              VerticalAlignment="Center"/>
                                    <Border x:Name="ShotT2Slot1" Width="64" Height="64" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotT2Image1" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotT2Slot2" Width="64" Height="64" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotT2Image2" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotT2Slot3" Width="64" Height="64" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotT2Image3" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotT2Slot4" Width="64" Height="64" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotT2Image4" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 2×2：3×2 六格 + 计数胶囊 -->
                            <Grid x:Name="ShotsTier4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE722;" FontSize="11.5" Foreground="{ThemeResource TintShotsBrush}"/>
                                    <TextBlock Text="截图墙" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ShotsEmpty" Grid.Column="1" Text="暂无截图" FontSize="11.5"
                                           Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Visibility="Collapsed"/>
                                <Grid x:Name="ShotsGrid" Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Left"
                                      VerticalAlignment="Center" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition x:Name="ShotsRow2Def" Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="ShotSlot1" Width="92" Height="92" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotImage1" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotSlot2" Grid.Column="1" Width="92" Height="92" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotImage2" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotSlot3" Grid.Column="2" Width="92" Height="92" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotImage3" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotSlot4" Grid.Row="1" Width="92" Height="92" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotImage4" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotSlot5" Grid.Row="1" Grid.Column="1" Width="92" Height="92" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotImage5" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                    <Border x:Name="ShotSlot6" Grid.Row="1" Grid.Column="2" Width="92" Height="92" CornerRadius="10" Background="{ThemeResource AppChipBrush}">
                                        <Image x:Name="ShotImage6" Margin="3" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- 4×N：整幅画布（左大图 + 右缩略），把第二页从两格小卡变成一页真实截图 -->
                            <Grid x:Name="ShotsTierWide" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE722;" FontSize="11.5" Foreground="{ThemeResource TintShotsBrush}"/>
                                        <TextBlock Text="截图墙" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ShotsWideMeta" Grid.Column="1" FontSize="11.5"
                                               Foreground="{ThemeResource AppText3Brush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="ShotsWideBody" Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
