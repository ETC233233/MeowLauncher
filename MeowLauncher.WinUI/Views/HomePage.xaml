                            <Grid x:Name="RecentTier1" Visibility="Collapsed" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RecentOneName" Text="还没有启动记录" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
