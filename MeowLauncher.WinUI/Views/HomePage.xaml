                </Border>

                <!-- 最近启动（tint recent #2FA35A） -->
                <Border x:Name="RecentCard" AutomationProperties.Name="最近启动" Style="{StaticResource WidgetCardStyle}" Padding="0" Visibility="Collapsed">
                    <Border Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}" Padding="12">
