<Page
    x:Class="MeowLauncher.WinUI.Views.GetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    Background="Transparent">

    <!-- 「获取」把下载版本与在线资源并成一页，用顶部两个胶囊切换；
         两个子页仍复用原页面的 XAML 与业务代码，这里只负责导航与页头。 -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12" Background="Transparent"
          AllowDrop="True" DragOver="Pack_DragOver" Drop="Pack_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="获取" FontSize="28" FontWeight="SemiBold"
                       Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
            <Button x:Name="ImportPackButton" Grid.Column="1" VerticalAlignment="Center"
                    Click="ImportPack_Click" ToolTipService.ToolTip="也可以把 .mrpack 或整合包 .zip 拖到此页">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                    <TextBlock Text="导入整合包" />
                </StackPanel>
            </Button>
            <!-- 在线资源装到哪个实例：和实例页同一个切换器，放右上角；下载版本页用不到，隐藏 -->
            <StackPanel x:Name="OnlineHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Visibility="Collapsed">
                <controls:InstanceSwitcher x:Name="OnlineSwitcher" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 子页页头：面包屑（获取 › 下载版本 › 1.20.1）。打开子页时替换上面的标题行 -->
        <StackPanel x:Name="SubHeader" Grid.Row="0" Orientation="Horizontal" Spacing="12"
                    VerticalAlignment="Center" Visibility="Collapsed">
            <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 顶栏：下载版本 | 在线资源 | 来源（在线资源选中时展开）| 搜索框（只在在线资源显示，拉满剩余宽度） -->
        <Grid x:Name="TabsRow" Grid.Row="1" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ToggleButton x:Name="TabDownload" Style="{StaticResource SegTabToggleStyle}" Tag="download" Click="Tab_Click"
                          AutomationProperties.Name="下载版本"
                          Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                          BorderThickness="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                    <TextBlock Text="下载版本" FontSize="{StaticResource FontSizeBody}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton x:Name="TabOnline" Style="{StaticResource SegTabToggleStyle}" Tag="online" Click="Tab_Click"
                          AutomationProperties.Name="在线资源"
                          Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                          BorderThickness="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE774;" FontSize="13" />
                    <TextBlock Text="在线资源" FontSize="{StaticResource FontSizeBody}" />
                </StackPanel>
            </ToggleButton>
            <!-- 在线资源的数据源：只在「在线资源」选中时从按钮右侧滑出，点一下切源。
                 选中的源记在 OnlinePage.PreferredSource，切走再切回来也不丢。 -->
            <Border x:Name="SourceStrip" Visibility="Collapsed" VerticalAlignment="Center" Margin="-2,0,0,0"
                    Padding="3" CornerRadius="{StaticResource ChipCornerRadius}"
                    Background="{ThemeResource AppChipBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="SrcModrinth" Style="{StaticResource SegTabToggleStyle}" Tag="0" Click="Source_Click"
                                  AutomationProperties.Name="数据源：Modrinth" ToolTipService.ToolTip="从 Modrinth 搜索，点一下选镜像"
                                  Padding="12,4" CornerRadius="{StaticResource ChipCornerRadius}"
                                  BorderThickness="0" VerticalAlignment="Center">
                        <TextBlock Text="Modrinth" FontSize="{StaticResource FontSizeBody}" />
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <RadioMenuFlyoutItem x:Name="OptModrinthMcim" Text="MCIM 镜像" GroupName="modrinthSource"
                                                     Tag="m0" Click="SourceOption_Click" />
                                <RadioMenuFlyoutItem x:Name="OptModrinthOfficial" Text="官方" GroupName="modrinthSource"
                                                     Tag="m1" Click="SourceOption_Click" />
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </ToggleButton>
                    <ToggleButton x:Name="SrcCurseForge" Style="{StaticResource SegTabToggleStyle}" Tag="1" Click="Source_Click"
                                  AutomationProperties.Name="数据源：CurseForge" ToolTipService.ToolTip="从 CurseForge 搜索，点一下选来源"
                                  Padding="12,4" CornerRadius="{StaticResource ChipCornerRadius}"
                                  BorderThickness="0" VerticalAlignment="Center">
                        <TextBlock Text="CurseForge" FontSize="{StaticResource FontSizeBody}" />
                        <FlyoutBase.AttachedFlyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <RadioMenuFlyoutItem x:Name="OptCfMcim" Text="MCIM 镜像" GroupName="curseForgeSource"
                                                     Tag="c0" Click="SourceOption_Click" />
                                <RadioMenuFlyoutItem x:Name="OptCfMeow" Text="MeowAPI" GroupName="curseForgeSource"
                                                     Tag="c1" Click="SourceOption_Click" />
                                <RadioMenuFlyoutItem x:Name="OptCfOfficial" Text="官方（需 API Key）" GroupName="curseForgeSource"
                                                     Tag="c2" Click="SourceOption_Click" />
                            </MenuFlyout>
                        </FlyoutBase.AttachedFlyout>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </StackPanel>
        <controls:PageSearchBox x:Name="DownloadQueryBox" Grid.Column="1" VerticalAlignment="Center"
                                IsFilter="True" PlaceholderText="在本页筛选：版本号，例如 1.21 或 24w14a" />
        <controls:PageSearchBox x:Name="OnlineQueryBox" Grid.Column="1" VerticalAlignment="Center"
                                Visibility="Collapsed" PlaceholderText="搜索 Mod、整合包、资源包、光影…" />
        </Grid>

        <Frame x:Name="InnerFrame" Grid.Row="2" Background="Transparent"
               IsNavigationStackEnabled="False" />

        <!-- 子页内容区：整页替换列表。列表页（InnerFrame）只是隐藏、不销毁，返回时滚动位置和筛选原样还在。
             第 1 行（胶囊）收起后 RowSpacing 还会占一格，这里用负边距补回。 -->
        <Frame x:Name="SubFrame" Grid.Row="2" Background="Transparent" Margin="0,-12,0,0"
               IsNavigationStackEnabled="False" Visibility="Collapsed" />
    </Grid>
</Page>
