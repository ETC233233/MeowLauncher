<Page
    x:Class="MeowLauncher.WinUI.Views.DownloadDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- 「获取 › 下载版本 › x.y.z」子页：页头（返回箭头 + 面包屑）由「获取」宿主画，这里只有内容。
         中间可滚动，底部固定一栏「要装什么 + 开始下载」。 -->
    <Page.Resources>
        <Style x:Key="FlatItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" Padding="0,0,0,4">
                <!-- 版本卡：图标 + Minecraft x.y + 类型·日期 -->
                <Border Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid Padding="18,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DetailIcon" Width="48" Height="48" CornerRadius="8" VerticalAlignment="Top">
                            <Border.Background>
                                <ImageBrush x:Name="DetailIconBrush" Stretch="Uniform" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Minecraft" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppText2Brush}" />
                                <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="DetailMeta" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource AppText3Brush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Mod 加载器" FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="SemiBold" Margin="2,6,0,0"
                           Foreground="{ThemeResource AppText2Brush}" />

                <!-- 加载器整行列表（学 PCL）：名称 + 状态 + 右箭头；选中 = 品牌绿描边 + 浅底 -->
                <ListView x:Name="DetailLoaderList" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="DetailLoader_ItemClick"
                          ItemContainerStyle="{StaticResource FlatItemStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56" Margin="0,0,0,6" Opacity="{Binding RowOpacity}">
                                <Border Background="{ThemeResource AppCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" />
                                <Border Background="{ThemeResource AppBrandSoftBrush}"
                                        BorderBrush="{ThemeResource AppBrandBrush}" BorderThickness="2"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Visibility="{Binding SelectedVisibility}" />
                                <Grid Padding="18,0,16,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform"
                                           VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}" />
                                        <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource AppText3Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                                                VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Visibility="{Binding InstalledVisibility}">
                                            <FontIcon Glyph="&#xE73E;" FontSize="13"
                                                      Foreground="{ThemeResource AppGoodBrush}" />
                                            <TextBlock Text="已安装" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{ThemeResource AppGoodBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <FontIcon Glyph="&#xE76C;" FontSize="11"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  Visibility="{Binding ChevronVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="DetailLoaderNoteRow" Orientation="Horizontal" Spacing="10" Margin="2,0,0,0">
                    <ProgressRing x:Name="DetailLoaderBusy" Width="14" Height="14" IsActive="False"
                                  Visibility="Collapsed" VerticalAlignment="Center" />
                    <TextBlock x:Name="DetailLoaderNote" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="DetailLoaderRetry" Content="重试" Visibility="Collapsed"
                            Style="{StaticResource QuietButtonStyle}" Click="DetailLoaderRetry_Click" />
                </StackPanel>

                <!-- 选了加载器后才出现：加载器版本 + 前置 -->
                <Border x:Name="DetailLoaderVersionCard" Visibility="Collapsed"
                        Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                    <StackPanel Padding="18,14" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="DetailLoaderVersionLabel" Text="加载器版本" Width="90"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="DetailLoaderVersion" Width="280"
                                      SelectionChanged="DetailLoaderVersion_SelectionChanged" />
                        </StackPanel>
                        <StackPanel x:Name="DetailPrereqRow" Spacing="8" Visibility="Collapsed">
                            <ComboBox x:Name="DetailPrereq" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="选择 API"
                                      SelectionChanged="DetailPrereq_SelectionChanged" />
                            <StackPanel x:Name="DetailPrereqVersions" Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="DetailPrereqVersion" Width="280"
                                          AutomationProperties.Name="API 版本"
                                          PlaceholderText="选择版本"
                                          SelectionChanged="DetailPrereqVersion_SelectionChanged" />
                                <Button x:Name="DetailPrereqRetry" Content="重试" Visibility="Collapsed"
                                        Style="{StaticResource QuietButtonStyle}" Click="DetailPrereqRetry_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DetailAncientNote" Visibility="Collapsed"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource AppWarnBrush}" TextWrapping="Wrap"
                           Text="远古版本：能下载安装，但不保证能启动。" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
            <Grid Padding="18,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center"
                          Foreground="{ThemeResource AppText2Brush}" />
                <TextBlock x:Name="InstallDirLabel" Grid.Column="1" Text="安装目录"
                           FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                <ComboBox x:Name="DetailDir" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          PlaceholderText="请先添加游戏目录" AutomationProperties.LabeledBy="{Binding ElementName=InstallDirLabel}"
                          SelectionChanged="DetailDir_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- 底部固定：要装什么 + 开始下载 -->
        <Border Grid.Row="2" Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
            <Grid Padding="18,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailSummary" FontSize="{StaticResource FontSizeBody}"
                           Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="DetailInstall" Grid.Column="1" Content="开始下载" Height="36" MinWidth="136"
                        Padding="20,0" CornerRadius="4" BorderThickness="0"
                        Background="{ThemeResource AppBrandBrush}"
                        Foreground="{ThemeResource AppBrandTextBrush}"
                        AutomationProperties.Name="开始下载并安装此版本"
                        Click="DetailInstall_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
