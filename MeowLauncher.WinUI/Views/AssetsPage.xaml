<Page
    x:Class="MeowLauncher.WinUI.Views.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    xmlns:models="using:MeowLauncher.WinUI.Models"
    xmlns:views="using:MeowLauncher.WinUI.Views"
    Background="Transparent">

    <Page.Resources>
        <Thickness x:Key="ToolbarPadding">16,8</Thickness>
    </Page.Resources>

    <!-- 语义色：实例资源 = 青（TintQuick）。 -->
    <Grid x:Name="PageRoot" Padding="0,20,0,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：嵌在「实例」宿主里时收起，避免和宿主页头重复 -->
        <Grid x:Name="PageHeader" Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="实例内容" FontSize="28" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
                <Border Width="28" Height="28" CornerRadius="{StaticResource ChipCornerRadius}"
                        Background="{ThemeResource TintQuickSoftBrush}" Margin="2,0,0,0"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource TintQuickBrush}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Style="{StaticResource QuietIconButtonStyle}"
                        AutomationProperties.Name="刷新实例内容" Click="Refresh_Click"
                        ToolTipService.ToolTip="刷新资源列表">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button x:Name="ImportButton" Height="36" Padding="14,0" CornerRadius="{StaticResource ChipCornerRadius}"
                        Background="{ThemeResource AppChipBrush}" BorderThickness="0"
                        Foreground="{ThemeResource AppText2Brush}"
                        AutomationProperties.Name="导入本地内容" Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="导入" FontSize="11.5" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderButton" Height="36" Padding="14,0" CornerRadius="{StaticResource ChipCornerRadius}"
                        Background="{ThemeResource AppChipBrush}" BorderThickness="0"
                        Foreground="{ThemeResource AppText2Brush}"
                        AutomationProperties.Name="打开实例资源目录" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock x:Name="OpenFolderText" Text="打开资源目录" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 筛选胶囊直接跟在 tab 下方，不再套一条 64 高的空卡；搜索已并入顶栏。 -->
        <StackPanel x:Name="FiltersPanel" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8"
                    HorizontalAlignment="Left" KeyDown="ChipGroup_KeyDown">
            <RadioButton x:Name="TabPacks" Content="资源包 0" GroupName="AssetsKind"
                         Style="{StaticResource ChipRadioStyle}"
                         AutomationProperties.Name="筛选：资源包" Tag="resourcepack"
                         Checked="Tab_Checked" />
            <RadioButton x:Name="TabShaders" Content="光影 0" GroupName="AssetsKind"
                         Style="{StaticResource ChipRadioStyle}"
                         AutomationProperties.Name="筛选：光影" Tag="shaderpack"
                         Checked="Tab_Checked" />
            <RadioButton x:Name="TabWorlds" Content="存档 0" GroupName="AssetsKind"
                         Style="{StaticResource ChipRadioStyle}"
                         AutomationProperties.Name="筛选：存档" Tag="world"
                         Checked="Tab_Checked" />
            <RadioButton x:Name="TabShots" Content="截图 0" GroupName="AssetsKind"
                         Style="{StaticResource ChipRadioStyle}"
                         AutomationProperties.Name="筛选：截图" Tag="screenshot"
                         Checked="Tab_Checked" />
        </StackPanel>

        <controls:PageSearchBox x:Name="QueryBox" Grid.Row="1" Width="260"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,8"
                                IsFilter="True" PlaceholderText="在本页筛选：名称或文件名"
                                QueryChanged="QueryBox_QueryChanged" />

        <Grid Grid.Row="2">
            <ListView x:Name="PackList" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="PackList_ItemClick"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <ReorderThemeTransition />
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PackInfo">
                        <Border Background="{ThemeResource AppCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}" Padding="0">
                            <Grid Padding="14,11" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="42" Height="42" CornerRadius="10"
                                        Background="{ThemeResource TintQuickSoftBrush}"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="&#xE7B8;" FontSize="16"
                                                  Foreground="{ThemeResource TintQuickBrush}" />
                                        <Image Source="{x:Bind IconSource}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Detail}" FontSize="12"
                                               Foreground="{ThemeResource AppText2Brush}"
                                               Visibility="{x:Bind views:PackVisuals.VisibleWhenText(Detail)}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind SizeText}" FontSize="11.5"
                                               Foreground="{ThemeResource AppText3Brush}"
                                               VerticalAlignment="Center" />
                                    <!-- 存档行：把本地 .zip/.jar 数据包装进这个存档的 datapacks（sidecar 的 datapack-install 命令） -->
                                    <Button Height="32" Padding="11,0" CornerRadius="{StaticResource ChipCornerRadius}"
                                            Background="{ThemeResource AppChipBrush}" BorderThickness="0"
                                            Visibility="{x:Bind DatapackVisibility}"
                                            Tag="{x:Bind Name}" Click="ImportDatapack_Click"
                                            AutomationProperties.Name="导入数据包到这个存档"
                                            ToolTipService.ToolTip="选择 .zip / .jar 数据包，装进这个存档的 datapacks 文件夹">
                                        <TextBlock Text="导入数据包" FontSize="11.5" Foreground="{ThemeResource AppTextBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:LoadingBlock x:Name="LoadingPanel" Text="正在读取实例内容…" Tint="{ThemeResource TintQuickBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <StackPanel x:Name="EmptyHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" Visibility="Collapsed">
                <controls:EmptyState x:Name="EmptyPanel"
                                     Glyph="&#xE7B8;" Title="这个实例还没有资源包"
                                     Hint="把资源包放进实例目录的 resourcepacks，再回来刷新。" />
                <Button x:Name="RetryButton" Content="重新读取" Height="32" Padding="16,0"
                        CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                        HorizontalAlignment="Center" FontSize="11.5"
                        Background="{ThemeResource AppChipBrush}"
                        Foreground="{ThemeResource AppTextBrush}"
                        AutomationProperties.Name="重新读取实例资源" Click="Retry_Click"
                        Visibility="Collapsed" />
            </StackPanel>
        </Grid>

    </Grid>
</Page>
