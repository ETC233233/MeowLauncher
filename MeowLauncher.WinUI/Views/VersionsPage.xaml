<Page
    x:Class="MeowLauncher.WinUI.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MeowLauncher.WinUI.Converters"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    xmlns:views="using:MeowLauncher.WinUI.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0" />
            <Setter Property="CornerRadius" Value="{StaticResource RowCornerRadius}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 页内次级按钮：圆角 / 字级 / 底色全部走令牌 -->
        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="InstanceInfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="InstanceInfoValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 快捷入口行：整行可点，图标 + 文案 + 指向箭头 -->
        <Style x:Key="QuickRowButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>


        <Style x:Key="InstanceSettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：面包屑 + 计数 + 扫描 / 打开目录 / 返回 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="CrumbRoot" Text="实例" FontSize="28" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource AppTextBrush}" Tapped="CrumbRoot_Tapped"
                           ToolTipService.ToolTip="返回实例列表" />
                <FontIcon x:Name="CrumbSeparator" Glyph="&#xE76C;" FontSize="14"
                          Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"
                          Visibility="Collapsed" />
                <TextBlock x:Name="CrumbCurrent" Text="" FontSize="28" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <!-- 全部实例是实例工作区里的一个视图：列表模式下给一个页内的返回入口（详情模式用面包屑回列表） -->
                <Button x:Name="BackToInstanceButton" Style="{StaticResource QuietButtonStyle}"
                        AutomationProperties.Name="返回实例" ToolTipService.ToolTip="返回实例（Alt+Left）"
                        Click="BackToInstance_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" Foreground="{ThemeResource AppText2Brush}" />
                        <TextBlock Text="返回实例" FontSize="{StaticResource FontSizeCaption}" />
                    </StackPanel>
                </Button>
                <Button x:Name="RescanButton" Style="{StaticResource QuietIconButtonStyle}"
                        AutomationProperties.Name="重新扫描本地实例"
                        ToolTipService.ToolTip="重新扫描本地实例" Click="Rescan_Click">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ComboBox x:Name="DirBox" Visibility="Collapsed" Width="240" VerticalAlignment="Center"
                          Header="所选目录将作为默认目录" PlaceholderText="选择游戏目录"
                          AutomationProperties.Name="默认游戏目录" SelectionChanged="DirBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">

            <!-- 列表视图：工具栏和可折叠的目录分组 -->
            <Grid x:Name="ListPanel">
                <Border Padding="0,4,0,0">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏：左侧搜索，右侧目录管理 -->
                        <Grid Height="40" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <controls:PageSearchBox x:Name="QueryBox" Width="298" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    IsFilter="True" PlaceholderText="筛选实例名、版本或加载器"
                                                    QueryChanged="QueryBox_QueryChanged" />


                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Button Height="32" Visibility="Collapsed" Click="OpenGameDir_Click"
                                        AutomationProperties.Name="打开默认游戏目录">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                        <TextBlock Text="打开目录" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AddDirButton" Height="32"
                                        AutomationProperties.Name="添加游戏目录" Click="AddDir_Click"
                                        ToolTipService.ToolTip="把另一个 .minecraft 目录加进列表（最多 6 个）">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="添加目录" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RemoveDirButton" Visibility="Collapsed" Height="32"
                                        AutomationProperties.Name="移除默认游戏目录" Click="RemoveDir_Click"
                                        ToolTipService.ToolTip="只从列表里移除，不删除磁盘上的文件">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                        <TextBlock Text="移除目录" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="VersionListScroll" HorizontalScrollBarVisibility="Disabled"
                                          ViewChanged="VersionListScroll_ViewChanged">
                                <ItemsControl x:Name="VersionList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8">
                                                <StackPanel.ChildrenTransitions>
                                                    <RepositionThemeTransition />
                                                </StackPanel.ChildrenTransitions>
                                            </StackPanel>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="views:VersionGroup">
                                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      IsExpanded="{x:Bind IsExpanded}" Tag="{x:Bind Folder}"
                                                      AutomationProperties.Name="{x:Bind Folder}"
                                                      Expanding="VersionGroup_Expanding" Collapsed="VersionGroup_Collapsed">
                                                <Expander.Header>
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                                                  Foreground="{ThemeResource AppText2Brush}" />
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                       Foreground="{ThemeResource AppTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Folder}" FontSize="{StaticResource FontSizeCaption}"
                                                                       Foreground="{ThemeResource AppText3Brush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTipService.ToolTip="{x:Bind Folder}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind CountText}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource AppText3Brush}" />
                                                            <Button Content="{x:Bind DefaultText}" Tag="{x:Bind Folder}" Click="FolderDefault_Click" />
                                                            <Button Tag="{x:Bind Folder}" Click="FolderOpen_Click" AutomationProperties.Name="打开目录">
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                                            </Button>
                                                            <Button Tag="{x:Bind Folder}" Click="RemoveDir_Click" AutomationProperties.Name="移除目录">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="此目录暂无实例" Margin="12,12" FontSize="12"
                                                               Foreground="{ThemeResource AppText3Brush}" Visibility="{x:Bind EmptyVisibility}" />
                                                <ListView SelectionMode="None" IsItemClickEnabled="True" ItemClick="VersionList_ItemClick"
                                                          ItemsSource="{x:Bind Items}"
                                                          ScrollViewer.HorizontalScrollMode="Disabled"
                                                          ScrollViewer.VerticalScrollMode="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="views:VersionRow">
                                                            <Grid Background="Transparent" PointerEntered="Row_PointerEntered"
                                                                  PointerMoved="Row_PointerMoved"
                                                                  PointerExited="Row_PointerExited">
                                                                <Border Height="1" VerticalAlignment="Bottom" Margin="12,0"
                                                                        Background="{ThemeResource CardStrokeBrush}" IsHitTestVisible="False" />
                                                                <Border Width="3" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                        CornerRadius="2" Background="{ThemeResource AppAccentBrush}" IsHitTestVisible="False"
                                                                        Visibility="{x:Bind CurrentVisibility}" />
                                                                <Grid Padding="{x:Bind RowPadding}" ColumnSpacing="12" MinHeight="{x:Bind RowMinHeight}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="28" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="14" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Width="28" Height="28" CornerRadius="6" VerticalAlignment="Center">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{x:Bind IconSource}" Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind Id}"
                                                                                   FontSize="{StaticResource FontSizeCardTitle}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{ThemeResource AppTextBrush}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind Subtitle}"
                                                                                   FontSize="{StaticResource FontSizeCaption}"
                                                                                   Foreground="{ThemeResource AppText3Brush}"
                                                                                   Visibility="{x:Bind SubtitleVisibility}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center"
                                                                               Visibility="{x:Bind CurrentVisibility}"
                                                                               FontSize="{StaticResource FontSizeCaption}"
                                                                               Foreground="{ThemeResource AppAccentTextBrush}" />

                                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                                                                Tag="move" Opacity="0" IsHitTestVisible="False"
                                                                                VerticalAlignment="Center"
                                                                                GotFocus="MovePanel_FocusChanged"
                                                                                LostFocus="MovePanel_FocusChanged">
                                                                        <Button Width="32" Height="32" Padding="0" BorderThickness="0"
                                                                                CornerRadius="7" Background="Transparent"
                                                                                AutomationProperties.Name="重命名实例"
                                                                                ToolTipService.ToolTip="重命名（名字和文件夹一起改）"
                                                                                Tag="{x:Bind}" Click="RenameRow_Click">
                                                                            <FontIcon Glyph="&#xE8AC;" FontSize="{StaticResource FontSizeCaption}"
                                                                                      Foreground="{ThemeResource AppText3Brush}" />
                                                                        </Button>
                                                                        <Button Width="32" Height="32" Padding="0" BorderThickness="0"
                                                                                CornerRadius="7" Background="Transparent"
                                                                                AutomationProperties.Name="固定到首页"
                                                                                ToolTipService.ToolTip="固定到首页 / 取消固定"
                                                                                Tag="{x:Bind Source}" Click="Pin_Click">
                                                                            <FontIcon Glyph="&#xE718;" FontSize="{StaticResource FontSizeCaption}"
                                                                                      Foreground="{ThemeResource AppText3Brush}" />
                                                                        </Button>
                                                                        <Button Width="32" Height="32" Padding="0" BorderThickness="0"
                                                                                CornerRadius="7" Background="Transparent"
                                                                                AutomationProperties.Name="上移一位"
                                                                                ToolTipService.ToolTip="上移一位（顺序会记住）"
                                                                                Tag="{x:Bind}" Click="MoveUp_Click">
                                                                            <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource FontSizeCaption}"
                                                                                      Foreground="{ThemeResource AppText3Brush}" />
                                                                        </Button>
                                                                        <Button Width="32" Height="32" Padding="0" BorderThickness="0"
                                                                                CornerRadius="7" Background="Transparent"
                                                                                AutomationProperties.Name="下移一位"
                                                                                ToolTipService.ToolTip="下移一位（顺序会记住）"
                                                                                Tag="{x:Bind}" Click="MoveDown_Click">
                                                                            <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource FontSizeCaption}"
                                                                                      Foreground="{ThemeResource AppText3Brush}" />
                                                                        </Button>
                                                                    </StackPanel>

                                                                    <FontIcon Grid.Column="4" Glyph="&#xE76C;" FontSize="12"
                                                                              Foreground="{ThemeResource AppText3Brush}"
                                                                              VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- 三态之一：加载 -->
                            <controls:LoadingBlock x:Name="LoadingPanel" Text="正在扫描本地实例…" Tint="{ThemeResource TintRecentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                            <!-- 三态之二：空（无实例 / 搜索无结果） -->
                            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="14">
                                <controls:EmptyState x:Name="ListEmpty"
                                                     Glyph="&#xE81E;" Title="还没有本地实例"
                                                     Hint="去左侧「下载版本」装一个版本，这里就会出现。" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button x:Name="EmptyOpenDirButton" Content="打开目录"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="打开这个游戏目录"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="OpenGameDir_Click" />
                                    <Button x:Name="EmptyChangeDirButton" Content="换个目录…"
                                            AutomationProperties.Name="换一个游戏目录"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="EmptyChangeDir_Click" />
                                    <Button x:Name="EmptyDownloadButton" Content="去下载版本"
                                            AutomationProperties.Name="前往下载版本页"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Click="EmptyDownload_Click" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 三态之三：错（警告图标 + ≤120 字摘要 + 原地重试） -->
                            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" MaxWidth="420"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                                          Foreground="{ThemeResource AppWarnBrush}" />
                                <TextBlock x:Name="ErrorTitle" Text="扫描本地实例失败" FontSize="14"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource AppTextBrush}" />
                                <TextBlock x:Name="ErrorSummary" Text="" MaxWidth="400"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{ThemeResource AppText3Brush}"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                                <Button Content="重试" HorizontalAlignment="Center"
                                        AutomationProperties.Name="重新扫描本地实例"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="Retry_Click" />
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>

            <!-- 详情视图 -->
            <ScrollViewer x:Name="DetailView" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="DetailPanel" Spacing="14" HorizontalAlignment="Stretch">

                    <!-- 实例名由面包屑显示。 -->
                    <Grid ColumnSpacing="12" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="DetailCurrentPill"
                                Background="{ThemeResource AppChipBrush}"
                                CornerRadius="{StaticResource ChipCornerRadius}"
                                Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock Text="当前实例"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource TintRecentBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="DetailLaunch" Style="{StaticResource LaunchButtonStyle}" MinWidth="104" Height="32"
                                    AutomationProperties.Name="启动该版本"
                                    Click="Launch_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing x:Name="LaunchRing" IsActive="False"
                                                  Width="14" Height="14" Visibility="Collapsed"
                                                  Foreground="White" VerticalAlignment="Center" />
                                    <FontIcon x:Name="LaunchGlyph" Glyph="&#xE768;" FontSize="12"
                                              VerticalAlignment="Center" />
                                    <TextBlock x:Name="LaunchLabel" Text="启动该版本"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DetailSwitch" Style="{StaticResource QuietButtonStyle}" MinWidth="104" Height="32"
                                    AutomationProperties.Name="设为当前实例"
                                    Click="SwitchInstance_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8AB;" FontSize="12"
                                              Foreground="{ThemeResource AppText2Brush}" />
                                    <TextBlock Text="设为当前实例"
                                               FontSize="{StaticResource FontSizeCaption}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuietButtonStyle}" MinWidth="104" Height="32"
                                    AutomationProperties.Name="打开实例文件夹"
                                    Click="OpenFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12"
                                              Foreground="{ThemeResource AppText2Brush}" />
                                    <TextBlock Text="打开文件夹"
                                               FontSize="{StaticResource FontSizeCaption}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Expander Header="实例信息" IsExpanded="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="游戏版本" Style="{StaticResource InstanceInfoLabelStyle}" />
                                    <TextBlock x:Name="DetailGameVersion" Grid.Column="1" Style="{StaticResource InstanceInfoValueStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="加载器版本" Style="{StaticResource InstanceInfoLabelStyle}" />
                                    <TextBlock x:Name="DetailLoader" Grid.Column="1" Style="{StaticResource InstanceInfoValueStyle}" />
                                </Grid>
                                <Grid x:Name="DetailModsRow" Visibility="Collapsed" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mod 数量" Style="{StaticResource InstanceInfoLabelStyle}" />
                                    <TextBlock x:Name="DetailMods" Grid.Column="1" Style="{StaticResource InstanceInfoValueStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="实例路径" Style="{StaticResource InstanceInfoLabelStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock x:Name="DetailPath" Style="{StaticResource InstanceInfoValueStyle}" />
                                    <TextBlock x:Name="InstanceIsolationHint" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"
                                               FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{ThemeResource AppText3Brush}" Text="" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="创建日期" Style="{StaticResource InstanceInfoLabelStyle}" />
                                    <TextBlock x:Name="DetailCreated" Grid.Column="1" Style="{StaticResource InstanceInfoValueStyle}" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="上次启动" Style="{StaticResource InstanceInfoLabelStyle}" />
                                    <TextBlock x:Name="DetailLastPlayed" Grid.Column="1" Style="{StaticResource InstanceInfoValueStyle}" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander Grid.Column="1" Header="实例操作" IsExpanded="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                            <StackPanel Spacing="4">
                                <Button Style="{StaticResource QuickRowButtonStyle}"
                                        AutomationProperties.Name="查看实例日志"
                                        Click="OpenLogs_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7C3;" FontSize="14"
                                                  Foreground="{ThemeResource TintRecentBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="查看日志"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource QuickRowButtonStyle}"
                                        AutomationProperties.Name="打开实例目录"
                                        Click="OpenFolder_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                                  Foreground="{ThemeResource TintRecentBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="打开实例目录"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource QuickRowButtonStyle}"
                                        AutomationProperties.Name="复制实例路径"
                                        Click="CopyPath_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14"
                                                  Foreground="{ThemeResource TintRecentBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="复制实例路径"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button AutomationProperties.Name="重命名实例"
                                        Style="{StaticResource QuickRowButtonStyle}"
                                        Click="RenameVersion_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8AC;" FontSize="14"
                                                  Foreground="{ThemeResource TintRecentBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="重命名实例"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button AutomationProperties.Name="修改版本"
                                        Style="{StaticResource QuickRowButtonStyle}"
                                        Click="ChangeVersion_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE895;" FontSize="14"
                                                  Foreground="{ThemeResource TintRecentBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="修改版本"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button AutomationProperties.Name="归档实例"
                                        Style="{StaticResource QuickRowButtonStyle}"
                                        Click="ArchiveVersion_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                  Foreground="{ThemeResource AppWarnBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="归档实例"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppWarnBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button x:Name="HideVersionButton" Style="{StaticResource QuickRowButtonStyle}"
                                        AutomationProperties.Name="隐藏实例"
                                        Click="HideVersion_Click">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE7B3;" FontSize="14"
                                                  Foreground="{ThemeResource TintRecentBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="隐藏实例"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                                  Foreground="{ThemeResource AppText3Brush}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Expander>
                    </Grid>

                    <TextBlock Text="实例选项" Style="{StaticResource WidgetLabelStyle}" Margin="0,6,0,0"/>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动卡展示封面" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                <ComboBox x:Name="InstanceCoverMode" Width="180" SelectionChanged="InstanceCoverMode_Changed">
                                    <ComboBoxItem Content="默认" Tag="default"/>
                                    <ComboBoxItem Content="最新的截图" Tag="latest"/>
                                    <ComboBoxItem Content="自定义图片" Tag="custom"/>
                                </ComboBox>
                                <Button x:Name="InstanceCoverPickButton" Height="32" Padding="14,0" CornerRadius="6" Content="更换封面…" AutomationProperties.Name="更换封面" Click="InstanceCoverPick_Click"/>
                                <Button x:Name="InstanceCoverResetButton" Height="32" Padding="14,0" CornerRadius="6" Content="恢复默认" AutomationProperties.Name="恢复默认封面" Click="InstanceCoverReset_Click"/>
                                <TextBlock x:Name="InstanceCoverHint" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}" Text=""/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动时显示控制台窗口" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="InstanceConsoleSwitch" Grid.Column="1" MinWidth="0" Width="56" Margin="0,0,-12,0" HorizontalAlignment="Right" OnContent="" OffContent="" AutomationProperties.Name="启动时显示控制台窗口" Toggled="InstanceConsole_Toggled"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本隔离" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <ComboBox x:Name="InstanceIsolationBox" MinWidth="150" Height="32" VerticalAlignment="Center" SelectionChanged="InstanceIsolation_Changed">
                                    <ComboBoxItem Content="跟随自动" Tag="follow"/>
                                    <ComboBoxItem Content="强制开启" Tag="on"/>
                                    <ComboBoxItem Content="强制关闭" Tag="off"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="LaunchSettingsSourceRow" Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="跟随全局设置" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="InstanceUseGlobalSwitch" Grid.Column="1" OnContent="" OffContent="" Width="56" Margin="0,0,-12,0" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="跟随全局启动设置" Toggled="InstanceUseGlobal_Toggled"/>
                        </Grid>
                    </Border>
                    <Grid ColumnSpacing="20" MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="启动设置" Style="{StaticResource WidgetLabelStyle}" Margin="0,6,0,0"/>
                        <TextBlock x:Name="InstanceAutoApplyLabel" Text="" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="InstanceSettingsStatus" Grid.Column="1" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <StackPanel Spacing="16">
                            <!-- 内存：自动分配开关与内存条放同一张卡；关掉自动才露出下面的手动输入 -->
                            <Grid ColumnSpacing="20" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="自动分配内存" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock Text="按实例内容与 Mod 数量自动计算所需内存" FontSize="12" Foreground="{ThemeResource AppText3Brush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="InstanceMemAutoSwitch" Grid.Column="1" OnContent="" OffContent="" Width="56" MinWidth="0" Margin="0,0,-12,0" HorizontalAlignment="Right" Toggled="InstanceMemAuto_Toggled"/>
                            </Grid>
                            <StackPanel x:Name="MemBarHost" Spacing="10" HorizontalAlignment="Stretch">
                                <Grid x:Name="MemStatRow" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border x:Name="MemDotOther" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource AppText3Brush}"/>
                                            <TextBlock x:Name="MemCapOther" Text="其他程序已用" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MemStatOther" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border x:Name="MemDotAlloc" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource AppBrandBrush}"/>
                                            <TextBlock x:Name="MemCapAlloc" Text="本实例分配" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MemStatAlloc" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="MemFreeStat" Grid.Column="2" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border x:Name="MemDotFree" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource AppStrokeBrush}"/>
                                            <TextBlock Text="分配后剩余" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MemStatFree" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border x:Name="MemDotTotal" Visibility="Collapsed" Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Background="{ThemeResource AppStrokeBrush}"/>
                                            <TextBlock Text="本机总内存" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MemStatTotal" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="MemBarArea" Spacing="3">
                                    <Grid x:Name="MemBar" Height="24" SizeChanged="MemBar_SizeChanged" AutomationProperties.Name="内存分配条">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="MemColOther" Width="*"/>
                                            <ColumnDefinition x:Name="MemColAlloc" Width="*"/>
                                            <ColumnDefinition x:Name="MemColFree" Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="MemSegOther" Grid.Column="0" CornerRadius="5" Margin="0,0,2,0" Background="{ThemeResource AppText3Brush}" Opacity="0.55"/>
                                        <Border x:Name="MemSegAlloc" Grid.Column="1" CornerRadius="5" Margin="0,0,2,0" Background="{ThemeResource AppBrandBrush}"/>
                                        <Border x:Name="MemSegFree" Grid.Column="2" CornerRadius="5" Background="{ThemeResource AppChipBrush}"/>
                                        <Canvas Grid.ColumnSpan="3">
                                            <Border x:Name="MemHandle" Width="8" Height="32" CornerRadius="4" Canvas.Top="-4" Background="{ThemeResource AppTextBrush}" BorderBrush="{ThemeResource AppBrandBrush}" BorderThickness="2" Visibility="Collapsed" ToolTipService.ToolTip="左右拖动，调整这个实例的内存" PointerPressed="MemHandle_PointerPressed" PointerMoved="MemHandle_PointerMoved" PointerReleased="MemHandle_PointerReleased" PointerCaptureLost="MemHandle_PointerCaptureLost"/>
                                        </Canvas>
                                    </Grid>
                                    <Canvas x:Name="MemTicks" Height="20"/>
                                </StackPanel>
                                <TextBlock x:Name="MemWarn" Visibility="Collapsed" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppWarnBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid x:Name="InstanceManualMemRow" ColumnSpacing="20" MinHeight="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="手动分配内存" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="InstanceMemorySummary" Visibility="Collapsed" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap"/>
                                    <NumberBox x:Name="InstanceMemoryBox" Width="150" Minimum="1024" HorizontalAlignment="Right" Maximum="65536" SmallChange="512" LargeChange="2048" SpinButtonPlacementMode="Compact" ValueChanged="InstanceMemoryBox_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Java 运行时" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InstanceGlobalJava" Grid.Column="1" Text="按实例版本自动选择" HorizontalAlignment="Right" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <ComboBox x:Name="InstanceJavaBox" Grid.Column="1" Width="360" HorizontalAlignment="Right" VerticalAlignment="Center" IsEditable="False" PlaceholderText="按实例版本自动选择" AutomationProperties.Name="Java 运行时" DropDownOpened="InstanceJavaBox_DropDownOpened" SelectionChanged="InstanceJavaBox_SelectionChanged"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock x:Name="InstanceJvmAutoLabel" Text="自动添加JVM参数" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}"/>
                                <TextBlock Text="根据环境和版本进行智能优化启动参数" FontSize="12" Foreground="{ThemeResource AppText3Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <TextBlock x:Name="InstanceJvmAutoHint" VerticalAlignment="Center" FontSize="{StaticResource FontSizeCaption}" Foreground="{ThemeResource AppText3Brush}" Text=""/>
                                <ToggleSwitch x:Name="InstanceJvmAutoSwitch" OnContent="" OffContent="" AutomationProperties.Name="自动添加JVM参数" Width="56" MinWidth="0" Margin="0,0,-12,0" Toggled="InstanceJvmAutoSwitch_Toggled"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <Grid ColumnSpacing="20" MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="额外 JVM 参数" FontSize="{StaticResource FontSizeBody}" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="InstanceGlobalJvm" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Right" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBox x:Name="InstanceJvmBox" HorizontalAlignment="Right" Width="360" VerticalAlignment="Center" Grid.Column="1" PlaceholderText="-XX:+UseG1GC" FontSize="{StaticResource FontSizeBody}" TextChanged="InstanceJvmBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="启动附加设置" Style="{StaticResource WidgetLabelStyle}" Margin="0,6,0,0"/>
                    <Border Style="{StaticResource InstanceSettingCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="InstanceGlobalExtra" Text="" Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <controls:LaunchExtraPanel x:Name="ExtraPanel"/>
                        </StackPanel>
                    </Border>



                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</Page>
