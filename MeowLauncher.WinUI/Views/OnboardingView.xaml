<UserControl
    x:Class="MeowLauncher.WinUI.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <!-- 背景光斑：浅色是淡蓝紫，深色自动压低（靠透明度叠在底色上） -->
        <Ellipse Width="980" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-300,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3A5B8DEF" Offset="0" />
                    <GradientStop Color="#005B8DEF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="820" Height="680" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-280" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2E8B7BEF" Offset="0" />
                    <GradientStop Color="#008B7BEF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 整张卡片固定 1010×540 设计尺寸，窗口不够大时等比缩小，保证版式和设计稿一致、不会被裁 -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="1010" MaxHeight="540" Margin="28"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="1010" Height="540" CornerRadius="10"
                Background="{ThemeResource AppPanelBrush}"
                BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46*" />
                    <ColumnDefinition Width="54*" />
                </Grid.ColumnDefinitions>

                <!-- 左：随屏插画 -->
                <Grid x:Name="ArtHost" Padding="30" IsHitTestVisible="False">
                    <Grid x:Name="Art1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Height="272">
                        <Canvas>
                            <Rectangle Canvas.Left="0" Canvas.Top="10" Width="330" Height="240" RadiusX="8" RadiusY="8"
                                       Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1.4" Fill="{ThemeResource AppChipBrush}" />
                            <Rectangle Canvas.Left="16" Canvas.Top="26" Width="86" Height="208" RadiusX="6" RadiusY="6" Fill="{ThemeResource AppPanelBrush}" />
                            <Ellipse Canvas.Left="30" Canvas.Top="40" Width="18" Height="18" Fill="{ThemeResource AppStrokeBrush}" />
                            <Rectangle Canvas.Left="56" Canvas.Top="42" Width="34" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{ThemeResource AppStrokeBrush}" />
                            <Rectangle Canvas.Left="30" Canvas.Top="76" Width="58" Height="10" RadiusX="5" RadiusY="5" Fill="{ThemeResource AppAccentBrush}" />
                            <Rectangle Canvas.Left="30" Canvas.Top="100" Width="40" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.6" />
                            <Rectangle Canvas.Left="30" Canvas.Top="118" Width="46" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.6" />
                            <Rectangle Canvas.Left="30" Canvas.Top="136" Width="36" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.6" />
                            <Rectangle Canvas.Left="30" Canvas.Top="154" Width="44" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.6" />
                            <Rectangle Canvas.Left="122" Canvas.Top="38" Width="192" Height="118" RadiusX="8" RadiusY="8" Fill="{ThemeResource AppAccentBrush}" />
                            <Rectangle Canvas.Left="140" Canvas.Top="56" Width="54" Height="82" RadiusX="6" RadiusY="6" Fill="{ThemeResource AppPanelBrush}" Opacity="0.92" />
                            <Rectangle Canvas.Left="206" Canvas.Top="60" Width="88" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource AppPanelBrush}" Opacity="0.9" />
                            <Rectangle Canvas.Left="206" Canvas.Top="78" Width="66" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource AppPanelBrush}" Opacity="0.7" />
                            <Rectangle Canvas.Left="206" Canvas.Top="102" Width="74" Height="22" RadiusX="5" RadiusY="5" Fill="{ThemeResource AppPanelBrush}" Opacity="0.95" />
                            <Rectangle Canvas.Left="122" Canvas.Top="172" Width="122" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource AppPanelBrush}" />
                            <Rectangle Canvas.Left="138" Canvas.Top="188" Width="70" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.7" />
                            <Rectangle Canvas.Left="138" Canvas.Top="204" Width="90" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="252" Canvas.Top="172" Width="62" Height="64" RadiusX="8" RadiusY="8" Fill="{ThemeResource AppChipBrush}" />
                            <Ellipse Canvas.Left="264" Canvas.Top="204" Width="9" Height="9" Fill="{ThemeResource AppBrandBrush}" />
                        </Canvas>
                    </Grid>

                    <Grid x:Name="Art2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Height="272" Visibility="Collapsed">
                        <Canvas>
                            <Ellipse Canvas.Left="48" Canvas.Top="52" Width="66" Height="66" Stroke="{ThemeResource AppText3Brush}" StrokeThickness="2" />
                            <Path Stroke="{ThemeResource AppText3Brush}" StrokeThickness="2" Data="M40,176 C40,132 122,132 122,176" />
                            <Rectangle Canvas.Left="160" Canvas.Top="76" Width="140" Height="104" RadiusX="10" RadiusY="10" Fill="{ThemeResource AppChipBrush}" Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1" />
                            <Rectangle Canvas.Left="178" Canvas.Top="96" Width="15" Height="15" Fill="#F25022" />
                            <Rectangle Canvas.Left="196" Canvas.Top="96" Width="15" Height="15" Fill="#7FBA00" />
                            <Rectangle Canvas.Left="178" Canvas.Top="114" Width="15" Height="15" Fill="#00A4EF" />
                            <Rectangle Canvas.Left="196" Canvas.Top="114" Width="15" Height="15" Fill="#FFB900" />
                            <Rectangle Canvas.Left="222" Canvas.Top="100" Width="52" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.7" />
                            <Rectangle Canvas.Left="222" Canvas.Top="116" Width="40" Height="7" RadiusX="3.5" RadiusY="3.5" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.5" />
                            <Rectangle Canvas.Left="178" Canvas.Top="142" Width="104" Height="22" RadiusX="7" RadiusY="7" Fill="{ThemeResource AppAccentBrush}" />
                        </Canvas>
                    </Grid>

                    <Grid x:Name="Art3" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Height="272" Visibility="Collapsed">
                        <Canvas>
                            <Path Fill="{ThemeResource AppChipBrush}" Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1.4"
                                  Data="M96,196 C56,196 32,168 32,136 C32,96 72,64 132,64 C200,64 244,96 244,132 C244,158 226,172 206,172 C190,172 182,180 182,192 C182,204 174,212 160,212 C150,212 146,206 140,200 C132,192 118,196 96,196 Z" />
                            <Ellipse Canvas.Left="66" Canvas.Top="96" Width="16" Height="16" Fill="#C4314B" />
                            <Ellipse Canvas.Left="106" Canvas.Top="80" Width="16" Height="16" Fill="#CA5010" />
                            <Ellipse Canvas.Left="148" Canvas.Top="80" Width="16" Height="16" Fill="#0F6CBD" />
                            <Ellipse Canvas.Left="188" Canvas.Top="96" Width="16" Height="16" Fill="#8764B8" />
                            <Ellipse Canvas.Left="62" Canvas.Top="136" Width="16" Height="16" Fill="#107C10" />
                            <Ellipse Canvas.Left="98" Canvas.Top="150" Width="16" Height="16" Fill="#C239B3" />
                            <Rectangle Canvas.Left="176" Canvas.Top="36" Width="10" Height="118" RadiusX="5" RadiusY="5" Fill="{ThemeResource AppText3Brush}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-24" CenterX="5" CenterY="59" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Canvas.Left="170" Canvas.Top="140" Width="12" Height="22" Fill="{ThemeResource AppAccentBrush}">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-24" CenterX="6" CenterY="11" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </Grid>

                    <Grid x:Name="Art4" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Height="272" Visibility="Collapsed">
                        <Canvas>
                            <Path Fill="{ThemeResource AppChipBrush}" Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1.4"
                                  Data="M56,104 L96,104 L108,86 L160,86 L160,104 L236,104 A10,10 0 0 1 246,114 L246,180 A10,10 0 0 1 236,190 L66,190 A10,10 0 0 1 56,180 Z" />
                            <Rectangle Canvas.Left="78" Canvas.Top="126" Width="92" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.55" />
                            <Rectangle Canvas.Left="78" Canvas.Top="146" Width="134" Height="8" RadiusX="4" RadiusY="4" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.4" />
                            <Rectangle Canvas.Left="108" Canvas.Top="176" Width="120" Height="46" RadiusX="10" RadiusY="10" Fill="{ThemeResource AppPanelBrush}" Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1.2" />
                            <Path Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="2.6" Data="M150,199 L184,199 M167,190 L167,208" />
                            <Ellipse Canvas.Left="208" Canvas.Top="196" Width="8" Height="8" Fill="{ThemeResource AppAccentBrush}" />
                        </Canvas>
                    </Grid>

                    <Grid x:Name="Art5" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Height="272" Visibility="Collapsed">
                        <Canvas>
                            <Rectangle Canvas.Left="34" Canvas.Top="30" Width="272" Height="206" RadiusX="14" RadiusY="14" Fill="{ThemeResource AppChipBrush}" Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1.4" />
                            <Ellipse Canvas.Left="52" Canvas.Top="48" Width="8" Height="8" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.7" />
                            <Ellipse Canvas.Left="68" Canvas.Top="48" Width="8" Height="8" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.7" />
                            <Ellipse Canvas.Left="84" Canvas.Top="48" Width="8" Height="8" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.7" />
                            <Ellipse Canvas.Left="138" Canvas.Top="80" Width="64" Height="64" Fill="{ThemeResource AppPanelBrush}" />
                            <Path Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="3" Data="M156,112 L166,122 L186,100" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Rectangle Canvas.Left="70" Canvas.Top="176" Width="200" Height="9" RadiusX="4.5" RadiusY="4.5" Fill="{ThemeResource AppStrokeBrush}" Opacity="0.35" />
                            <Rectangle Canvas.Left="70" Canvas.Top="176" Width="200" Height="9" RadiusX="4.5" RadiusY="4.5" Fill="{ThemeResource AppAccentBrush}" />
                        </Canvas>
                    </Grid>

                    <Grid x:Name="Art6" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" Height="272" Visibility="Collapsed">
                        <Canvas>
                            <Ellipse Canvas.Left="94" Canvas.Top="60" Width="150" Height="150" Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="2.4" />
                            <Path Stroke="{ThemeResource AppAccentBrush}" StrokeThickness="4" Data="M136,138 L166,168 L204,110" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="164" Canvas.Top="24" Width="10" Height="10" Fill="{ThemeResource AppAccentBrush}" Opacity="0.55" />
                            <Ellipse Canvas.Left="62" Canvas.Top="96" Width="9" Height="9" Fill="{ThemeResource AppAccentBrush}" Opacity="0.45" />
                            <Ellipse Canvas.Left="270" Canvas.Top="96" Width="9" Height="9" Fill="{ThemeResource AppAccentBrush}" Opacity="0.45" />
                            <Ellipse Canvas.Left="62" Canvas.Top="190" Width="9" Height="9" Fill="{ThemeResource AppAccentBrush}" Opacity="0.45" />
                            <Ellipse Canvas.Left="270" Canvas.Top="190" Width="9" Height="9" Fill="{ThemeResource AppAccentBrush}" Opacity="0.45" />
                            <Ellipse Canvas.Left="164" Canvas.Top="236" Width="10" Height="10" Fill="{ThemeResource AppAccentBrush}" Opacity="0.55" />
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- 右：内容 + 底栏 -->
                <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource AppStrokeBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="74" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,52,34,12">
                            <Grid>
                                <!-- 1 欢迎 -->
                                <StackPanel x:Name="Scr1" Spacing="14">
                                    <TextBlock Text="欢迎使用 MeowLauncher 启动器" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="我们致力于使用 Windows 原生的 Fluent Design 设计语言还原你最喜爱的启动器，让 Minecraft 像系统原生一样融入 Windows。" />
                                    <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="下面是本启动器的新手引导，请跟我们配置好账户、外观与你的游戏实例目录吧~" />
                                </StackPanel>

                                <!-- 2 账号 -->
                                <StackPanel x:Name="Scr2" Spacing="12" Visibility="Collapsed">
                                    <TextBlock Text="登录你的 Minecraft 账户" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="使用正版账户登录，拥有最完整的 Minecraft 体验，使用你的 Microsoft 账户进行登录吧。" />
                                    <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="没有购买 Minecraft？我们在此提供了离线账户的登录方式，但离线账户的部分功能受限。" />
                                    <TextBlock FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="如需获取正版 Minecraft，请前往 Xbox 商店或 Minecraft 官网，你也可以在第三方购物平台购买兑换码，但无法保证其商品的可用性与稳定性。" />
                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <Button x:Name="OptMs" HorizontalAlignment="Stretch" Padding="14,10" Click="OptMs_Click"
                                                Background="{ThemeResource AppChipBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Microsoft 账户" FontSize="14" Foreground="{ThemeResource AppTextBrush}" />
                                                <TextBlock Text="前往 Microsoft 登录并进行授权验证登录" FontSize="12" Foreground="{ThemeResource AppText3Brush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="OptOffline" HorizontalAlignment="Stretch" Padding="14,10" Click="OptOffline_Click"
                                                Background="{ThemeResource AppChipBrush}" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="离线账户" FontSize="14" Foreground="{ThemeResource AppTextBrush}" />
                                                <TextBlock Text="前往创建本地离线账户，仅在本机保存" FontSize="12" Foreground="{ThemeResource AppText3Brush}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel x:Name="MsPanel" Spacing="8" Visibility="Collapsed">
                                        <TextBlock x:Name="MsCode" FontSize="13" Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" />
                                        <Button x:Name="MsLoginBtn" Content="打开浏览器登录" Click="MsLogin_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="OfflinePanel" Spacing="8" Visibility="Collapsed">
                                        <TextBox x:Name="OfflineName" PlaceholderText="输入玩家名" MaxLength="16" />
                                        <Button x:Name="OfflineCreateBtn" Content="创建离线账户" Click="OfflineCreate_Click" />
                                    </StackPanel>

                                    <TextBlock FontSize="12.5" Foreground="{ThemeResource AppText3Brush}" Margin="0,2,0,0"
                                               Text="仍在使用旧 Mojang 账户？在此处查看更多信息。" />
                                    <HyperlinkButton Content="稍后再说" Padding="0" Click="SkipAccount_Click" />
                                </StackPanel>

                                <!-- 3 外观 -->
                                <StackPanel x:Name="Scr3" Spacing="12" Visibility="Collapsed">
                                    <TextBlock Text="设置你的外观" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock Text="根据你的喜好对外观进行个性化。" FontSize="13" Foreground="{ThemeResource AppText2Brush}" />
                                    <StackPanel Spacing="10" Margin="0,6,0,0">
                                        <Button x:Name="ThemeLight" HorizontalAlignment="Stretch" Height="56" Padding="18,0" Click="ThemeLight_Click"
                                                Background="White" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                                            <TextBlock Text="浅色" FontSize="14" Foreground="#1A1A1A" />
                                        </Button>
                                        <Button x:Name="ThemeDark" HorizontalAlignment="Stretch" Height="56" Padding="18,0" Click="ThemeDark_Click"
                                                Background="#1B212A" BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                                            <TextBlock Text="深色" FontSize="14" Foreground="#F1F4F9" />
                                        </Button>
                                        <Button x:Name="ThemeAuto" HorizontalAlignment="Stretch" Height="56" Padding="18,0" Click="ThemeAuto_Click"
                                                BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FFFFFF" Offset="0.48" />
                                                    <GradientStop Color="#1B212A" Offset="0.52" />
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <TextBlock Text="跟随系统" FontSize="14" Foreground="{ThemeResource AppTextBrush}" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="主题色" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{ThemeResource AppTextBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="9">
                                        <Ellipse x:Name="Sw0" Width="28" Height="28" Fill="#0F6CBD" Tag="#0F6CBD" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw1" Width="28" Height="28" Fill="#4F52B2" Tag="#4F52B2" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw2" Width="28" Height="28" Fill="#8764B8" Tag="#8764B8" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw3" Width="28" Height="28" Fill="#C239B3" Tag="#C239B3" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw4" Width="28" Height="28" Fill="#C4314B" Tag="#C4314B" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw5" Width="28" Height="28" Fill="#CA5010" Tag="#CA5010" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw6" Width="28" Height="28" Fill="#107C10" Tag="#107C10" Tapped="Accent_Tapped" />
                                        <Ellipse x:Name="Sw7" Width="28" Height="28" Fill="#038387" Tag="#038387" Tapped="Accent_Tapped" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- 4 目录 -->
                                <StackPanel x:Name="Scr4" Spacing="10" Visibility="Collapsed">
                                    <TextBlock Text="选择默认游戏目录" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock x:Name="DirLead" FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}" />
                                    <StackPanel x:Name="DirList" Spacing="8" Margin="0,4,0,0" />
                                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="{ThemeResource AppText3Brush}"
                                               Text="手动添加目录需要定位到 .minecraft 文件夹，均支持版本隔离或未开启版本隔离的文件夹。" />
                                    <HyperlinkButton Content="添加游戏目录…" Padding="0" Click="AddDir_Click" />
                                </StackPanel>

                                <!-- 5 更新 -->
                                <StackPanel x:Name="Scr5" Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="自动检查更新" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="保持最新的启动器版本往往能解决很多问题，并跟进我们研发的新特性！" />
                                    <StackPanel Spacing="14" Margin="0,4,0,0">
                                        <ToggleSwitch x:Name="TgCheck" Header="自动检查更新" IsOn="True" />
                                        <ToggleSwitch x:Name="TgDownload" Header="自动下载更新" IsOn="True" />
                                        <ToggleSwitch x:Name="TgInstall" Header="自动安装更新" IsOn="False" />
                                    </StackPanel>
                                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Foreground="{ThemeResource AppText3Brush}"
                                               Text="我们会在有可用更新时提醒你。当自动安装启用时，我们会在游戏启动时进行自动安装并重新开启启动器。" />
                                </StackPanel>

                                <!-- 6 就绪 -->
                                <StackPanel x:Name="Scr6" Spacing="14" Visibility="Collapsed">
                                    <TextBlock Text="准备就绪" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource AppText2Brush}"
                                               Text="好东西就要来了！请检查你的配置，准备出发吧~" />
                                    <StackPanel x:Name="Summary" Spacing="0" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AppStrokeBrush}" Padding="24,0">
                            <Button x:Name="BackBtn" Click="Back_Click" Width="36" Height="36" Padding="0" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE72B;"
                                    AutomationProperties.Name="返回" />
                            <Button x:Name="NextBtn" Content="开始" Click="Next_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="32" Padding="22,0" Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Viewbox>
    </Grid>
</UserControl>
