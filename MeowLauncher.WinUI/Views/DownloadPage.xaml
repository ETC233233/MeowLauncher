<Page
    x:Class="MeowLauncher.WinUI.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="FlatItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- 更新日志：分组标题 / 小节名 / 条目 -->
        <Style x:Key="NoteSecStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="NoteSubStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="NoteEntryStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏（嵌在「获取」宿主里时整行收起，避免和宿主页头重复） -->
        <Grid x:Name="PageHeader" Grid.Row="0">
            <TextBlock x:Name="PageTitle" Text="下载版本" FontSize="28" FontWeight="Bold"
                       Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- 搜索框在「获取」宿主顶栏（与下载版本 / 在线资源胶囊同一排），本页不自带工具栏。
             下载源下拉在右栏版本列表标题行右侧（见下方 ListTitle 那一行）。 -->

        <Grid Grid.Row="1">
            <!-- 两栏：左 大版本导航，右 版本列表 -->
            <Grid x:Name="BrowseGrid" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="224" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：顶部三段分类（正式版 / 快照 / 远古版），下面列该分类的大版本 -->
                <Border Grid.Column="0" Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="CatBar" Grid.Row="0" Margin="8,8,8,4" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CatRelease" Grid.Column="0" Tag="release" Click="Cat_Click"
                                          AutomationProperties.Name="正式版" HorizontalAlignment="Stretch"
                                          Padding="0,6" CornerRadius="6" BorderThickness="0">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="正式版" FontSize="12.5" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CatReleaseCount" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource AppText3Brush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CatSnapshot" Grid.Column="1" Tag="snapshot" Click="Cat_Click"
                                          AutomationProperties.Name="快照" HorizontalAlignment="Stretch"
                                          Padding="0,6" CornerRadius="6" BorderThickness="0">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="快照" FontSize="12.5" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CatSnapshotCount" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource AppText3Brush}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CatAncient" Grid.Column="2" Tag="ancient" Click="Cat_Click"
                                          AutomationProperties.Name="远古版" HorizontalAlignment="Stretch"
                                          Padding="0,6" CornerRadius="6" BorderThickness="0">
                                <StackPanel Spacing="0">
                                    <TextBlock Text="远古" FontSize="12.5" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CatAncientCount" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource AppText3Brush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ListView x:Name="NavList" Grid.Row="1" SelectionMode="None" Padding="0,2,0,6"
                                  IsItemClickEnabled="True" ItemClick="Nav_ItemClick"
                                  ItemContainerStyle="{StaticResource FlatItemStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- 换分类/切换选中时列表整批替换，默认的收缩/位移动画看着突兀，关掉 -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource AppChipHoverColor}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource AppChipHoverColor}" />
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- 大版本条目：28 图标（有横幅用横幅，没有用 default_icon）+ 大版本 / 副标题 + 数量；
                                         每行两行文字，没有官方代号的副标题写「最新 x · 年月」。
                                         选中 = 品牌绿浅底 + 左侧品牌绿竖条 -->
                                    <Grid MinHeight="40" Margin="8,1">
                                        <Border Background="{ThemeResource AppBrandSoftBrush}" CornerRadius="6"
                                                Visibility="{Binding SelectedVisibility}" />
                                        <Border Width="3" CornerRadius="2" HorizontalAlignment="Left"
                                                Margin="0,8"
                                                Background="{ThemeResource AppBrandBrush}"
                                                Visibility="{Binding SelectedVisibility}" />
                                        <Grid Padding="14,4,10,4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="4" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                                <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AppTextBrush}" />
                                                <TextBlock Text="{Binding Sub}" FontSize="{StaticResource FontSizeCaption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AppText3Brush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}"
                                                       FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 右栏 -->
                <Border Grid.Column="1" Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                        <StackPanel>

                        <!-- 下载源暂不在界面上露出，留一个隐藏载体给 code-behind 用 -->
                        <ComboBox x:Name="SourceBox" Visibility="Collapsed" SelectedIndex="0"
                                  SelectionChanged="SourceBox_SelectionChanged">
                            <ComboBoxItem Content="智能分配" Tag="auto" />
                            <ComboBoxItem Content="Mojang 官方" Tag="official" />
                            <ComboBoxItem Content="BMCLAPI" Tag="bmclapi" />
                            <ComboBoxItem Content="MeowAPI（自建）" Tag="meow" />
                            <ComboBoxItem Content="自定义镜像" Tag="custom" />
                        </ComboBox>

                        <!-- 没有宣传图也没有更新内容的分组（远古版、搜索结果）就退回原来的标题行 -->
                        <Grid x:Name="ListHeader" Padding="20,16,20,6" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ListTitle" FontSize="16" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppTextBrush}" />
                            <TextBlock x:Name="ListCount" Grid.Column="1" FontSize="{StaticResource FontSizeCaption}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppText3Brush}" />
                        </Grid>

                        <!-- 该版本的宣传图：图铺满，底部半渐变，标题压在图上（博客头图那种） -->
                        <Grid x:Name="CoverCard" Margin="0,0,0,8" Height="210"
                              Visibility="Collapsed">
                            <Border CornerRadius="12,12,0,0">
                                <Border.Background>
                                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="12,12,0,0">
                                <Border.Background>
                                    <!-- 往卡片底色（#0F1216 系）过渡，结尾不用纯黑，避免图底和卡片之间一条硬边 -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#000B0D10" Offset="0.1" />
                                        <GradientStop Color="#4D0B0D10" Offset="0.45" />
                                        <GradientStop Color="#B30B0D10" Offset="0.8" />
                                        <GradientStop Color="#D90B0D10" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Bottom" Padding="16,0,16,14" Spacing="3">
                                <TextBlock x:Name="CoverTitle" FontSize="22" FontWeight="SemiBold"
                                           Foreground="White" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CoverSub" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="#D9FFFFFF" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="VersionList" SelectionMode="None" Padding="8,4"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  IsItemClickEnabled="True" ItemClick="Version_RowClick"
                                  ItemContainerStyle="{StaticResource FlatItemStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- 换分组时列表整批替换，WinUI 默认的收缩/位移动画看着突兀，直接关掉 -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource AppChipHoverColor}" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource AppChipHoverColor}" />
                            </ListView.Resources>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- 版本行：56 高；32 图标 + 版本号/日期 + 已安装标记 -->
                                    <Grid Height="56" Padding="12,0,12,0" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="4" VerticalAlignment="Center">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform" />
                                            </Border.Background>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Id}" VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource AppTextBrush}" />
                                                <TextBlock Text="最新版本" VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSizeCaption}"
                                                           Foreground="{ThemeResource AppGoodBrush}"
                                                           Visibility="{Binding LatestVisibility}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Meta}" FontSize="{StaticResource FontSizeCaption}"
                                                       Foreground="{ThemeResource AppText3Brush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE76C;" FontSize="11"
                                                      Foreground="{ThemeResource AppText3Brush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                            <!-- 读更新日志时的占位：有缓存直接出，没缓存才闪这几条，避免空白等待 -->
                            <StackPanel x:Name="NotesLoading" Visibility="Collapsed" Margin="20,14,20,4" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="True" Width="14" Height="14"
                                                  Foreground="{ThemeResource AppText3Brush}" />
                                    <TextBlock Text="正在读取更新内容…" FontSize="{StaticResource FontSizeCaption}"
                                               Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Height="10" CornerRadius="5" Background="{ThemeResource AppChipBrush}" />
                                <Border Height="10" CornerRadius="5" Background="{ThemeResource AppChipBrush}" Width="280" HorizontalAlignment="Left" />
                                <Border Height="10" CornerRadius="5" Background="{ThemeResource AppChipBrush}" Width="210" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- 大版本更新内容：中文 Minecraft Wiki 的 新内容 / 更改 / 修复 -->
                            <StackPanel x:Name="NotesHost" Margin="20,10,20,20" Spacing="2" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                        <!-- 切版本组时整栏先盖一层，等头图和更新内容都就绪再一次性露出 -->
                        <Grid x:Name="RightLoading" Visibility="Collapsed" Background="{ThemeResource AppCardBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                <ProgressRing IsActive="True" Width="26" Height="26"
                                              Foreground="{ThemeResource AppBrandBrush}" />
                                <TextBlock Text="正在加载版本信息…" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{ThemeResource AppText3Brush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 加载态 -->
            <controls:LoadingBlock x:Name="LoadingPanel" Text="正在读取 Mojang 版本清单…" Tint="{ThemeResource TintStatsBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- 空态 -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <controls:EmptyState x:Name="EmptyText"
                                     Glyph="&#xE896;" Title="没有匹配的版本" Hint="" />
                <Button x:Name="EmptyAction" Content="重新读取清单" HorizontalAlignment="Center"
                        Style="{StaticResource QuietButtonStyle}" Click="EmptyAction_Click" />
            </StackPanel>

            <!-- 错态 -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" MaxWidth="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource AppWarnBrush}" />
                <TextBlock x:Name="ErrorTitle" Text="读取版本清单失败" FontSize="14"
                           FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppTextBrush}" />
                <TextBlock x:Name="ErrorSummary" Text="" MaxWidth="400"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource AppText3Brush}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="重试" HorizontalAlignment="Center"
                        AutomationProperties.Name="重新读取 Mojang 版本清单"
                        Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click" />
            </StackPanel>

            <InfoBar x:Name="StatusBar" IsOpen="False" Width="560"
                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,10" IsClosable="True" />
        </Grid>
    </Grid>
</Page>
