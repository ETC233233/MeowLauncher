<Page
    x:Class="MeowLauncher.WinUI.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    xmlns:models="using:MeowLauncher.WinUI.Models"
    xmlns:services="using:MeowLauncher.WinUI.Services"
    xmlns:views="using:MeowLauncher.WinUI.Views"
    xmlns:converters="using:MeowLauncher.WinUI.Converters"
    Background="Transparent">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="TaskSectionTabStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <!-- 任务行：进行中带行内转圈 + 取消；完成/失败带状态胶囊。 -->
        <DataTemplate x:Key="TaskRowTemplate" x:DataType="models:TaskEntry">
            <Border Margin="0,0,0,14" BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1" Padding="0,7,0,14">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="28" Height="30">
                            <FontIcon Glyph="{x:Bind views:TaskVisuals.IconFor(Title)}" FontSize="18" Foreground="{ThemeResource AppText2Brush}" Visibility="{x:Bind TaskGlyphVisibility, Mode=OneWay}"/>
                            <Image Source="{x:Bind TargetIcon, Mode=OneWay}" Width="28" Height="28" Stretch="Uniform"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind views:TaskVisuals.DisplayTitle(Title)}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind views:TaskVisuals.TaskMeta(Title, Status, TimeText), Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="移除此任务记录" Tag="{x:Bind Id}" Click="DismissTask_Click"
                                Visibility="{x:Bind views:TaskVisuals.FinishedVisibility(Status), Mode=OneWay}"><FontIcon Glyph="&#xE711;" FontSize="11"/></Button>
                    </Grid>
                    <Grid ColumnSpacing="12" Visibility="{x:Bind views:TaskVisuals.ActiveVisibility(Status), Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{x:Bind views:TaskVisuals.DeterminateVisibility(IsIndeterminate), Mode=OneWay}">
                            <TextBlock Text="{x:Bind views:TaskVisuals.PercentNumber(Progress), Mode=OneWay}" FontSize="32" FontWeight="SemiBold"/>
                            <TextBlock Text="%" FontSize="13" Foreground="{ThemeResource AppText2Brush}" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppText2Brush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            <Grid Height="3">
                                <Border CornerRadius="1.5" Background="{ThemeResource AppChipBrush}"/>
                                <Border CornerRadius="1.5" Background="{ThemeResource AppAccentBrush}" RenderTransformOrigin="0,0.5" Visibility="{x:Bind views:TaskVisuals.DeterminateVisibility(IsIndeterminate), Mode=OneWay}">
                                    <Border.RenderTransform><ScaleTransform ScaleX="{x:Bind views:TaskVisuals.ProgressScale(Progress), Mode=OneWay}"/></Border.RenderTransform>
                                </Border>
                                <ProgressBar IsIndeterminate="True" Height="3" Background="Transparent" Foreground="{ThemeResource AppAccentBrush}" Visibility="{x:Bind views:TaskVisuals.IndeterminateVisibility(IsIndeterminate), Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="{x:Bind views:TaskVisuals.StatsText(SpeedText, RemainText), Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}" TextWrapping="Wrap"
                                       Visibility="{x:Bind views:TaskVisuals.HasStatsVisibility(HasStats), Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind views:TaskVisuals.TaskDetailVisibility(Status, IsIndeterminate), Mode=OneWay}"/>
                    <Grid ColumnSpacing="12" Visibility="{x:Bind views:TaskVisuals.ActiveVisibility(Status), Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="StepsToggle" IsChecked="False" Height="28" Padding="6,0" FontSize="12" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                                      Visibility="{x:Bind StepsVisibility, Mode=OneWay}" AutomationProperties.Name="展开或收起安装步骤">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70D;" FontSize="10"/><TextBlock Text="安装详情" FontSize="12"/></StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="1" Content="取消" Height="28" Padding="8,0" FontSize="12" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Tag="{x:Bind Id}" Click="Cancel_Click"
                                AutomationProperties.Name="取消这个进行中的任务" IsEnabled="{x:Bind views:TaskVisuals.CancelEnabled(Status, Detail), Mode=OneWay}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Steps, Mode=OneWay}" Margin="0,2,0,0"
                                  Visibility="{Binding IsChecked, ElementName=StepsToggle, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskStep">
                                <Grid Height="22" ColumnSpacing="8" Opacity="{x:Bind Opacity, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="12"
                                              Foreground="{ThemeResource AppAccentBrush}" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"/>
                                    <ProgressRing Width="18" Height="18" IsActive="True"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="-1,0,0,0"
                                                  Foreground="{ThemeResource TintTasksBrush}"
                                                  Visibility="{x:Bind SpinnerVisibility, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Detail, Mode=OneWay}" FontSize="11.5"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{ThemeResource AppText3Brush}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                               Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PctText, Mode=OneWay}" FontSize="11.5"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{ThemeResource AppText3Brush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind views:TaskVisuals.FailedVisibility(Status), Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ErrorCodeText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource AppBadBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="复制诊断" FontSize="12" Padding="6,3" Background="Transparent" BorderThickness="0" AutomationProperties.Name="复制诊断信息" Tag="{x:Bind Id}" Click="CopyDiagnostics_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NotificationRowTemplate" x:DataType="services:TaskNotification">
            <ContentControl Margin="0,0,0,10" IsTabStop="True" UseSystemFocusVisuals="True" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="{x:Bind Title}" Tag="{x:Bind Id}" KeyDown="Notification_KeyDown">
                <Border BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="0,0,0,1" Padding="0,10,0,15" Tag="{x:Bind Id}" Tapped="Notification_Tapped" Background="Transparent">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="26" Height="26" VerticalAlignment="Top">
                            <FontIcon Glyph="{x:Bind views:TaskVisuals.NotificationGlyph(Kind, Title)}" FontSize="18" Foreground="{x:Bind views:TaskVisuals.NotificationBrush(Kind)}" IsHitTestVisible="False"/>
                            <Border Width="5" Height="5" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource AppAccentBrush}" Visibility="{x:Bind UnreadVisibility, Mode=OneWay}" IsHitTestVisible="False"/>
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="7">
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind TimeText}" FontSize="11" Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Message}" FontSize="12" Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" MaxLines="{x:Bind MessageMaxLines}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal" Spacing="8" Visibility="{x:Bind InviteButtonsVisibility, Mode=OneWay}">
                                <Button Content="接受" Height="30" Padding="12,0" FontSize="12" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="接受这个邀请" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanRespondToInvite, Mode=OneWay}" Click="InviteAccept_Click"/>
                                <Button Content="忽略" Height="30" Padding="10,0" FontSize="12" Background="Transparent" BorderThickness="0" AutomationProperties.Name="忽略这个邀请" Tag="{x:Bind Id}" IsEnabled="{x:Bind CanRespondToInvite, Mode=OneWay}" Click="InviteDecline_Click"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource AppText2Brush}" TextWrapping="Wrap" Visibility="{x:Bind ResultVisibility, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ContentControl>
        </DataTemplate>
        <!-- 详情里的单段：左边状态图标、中间标题+说明、右边状态字。 -->
        <!-- 正在运行的游戏：任务页里直接看到 pid 并结束进程。 -->
        <DataTemplate x:Key="RunningRowTemplate" x:DataType="services:RunningGame">
            <Border Margin="0,0,0,8" Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <Grid Padding="14,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19"
                            Background="{ThemeResource AppChipBrush}">
                        <FontIcon Glyph="&#xE768;" FontSize="16"
                                  Foreground="{ThemeResource AppGoodBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Version}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource AppText3Brush}">
                            <Run Text="进程 " /><Run Text="{x:Bind Pid}" />
                            <Run Text=" · 游戏正在运行" />
                        </TextBlock>
                    </StackPanel>
                    <Button VerticalAlignment="Center" Grid.Column="2" Content="结束进程" Height="32" Padding="14,0"
                            CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                            FontSize="12" Foreground="{ThemeResource AppBadBrush}"
                            AutomationProperties.Name="结束这个游戏进程"
                            Tag="{x:Bind Pid}" Click="EndGame_Click">
                        <Button.Background>
                            <SolidColorBrush Color="{ThemeResource AppBadColor}" Opacity="0.16" />
                        </Button.Background>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- 语义色：任务 = 蓝（TintTasks）。两条通道：任务（进行中/已完成/失败）与通知（一次性事件）。 -->
    <Grid x:Name="PageRoot" Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="PageHeader" Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="任务与通知" FontSize="28" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SummaryText" Text="队列空闲" FontSize="11.5"
                           Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"
                           Margin="8,4,0,0" />
            </StackPanel>

            <!-- 两条通道：任务 / 通知 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        KeyDown="ChipGroup_KeyDown">
                <RadioButton x:Name="TasksTab" Content="任务" GroupName="TasksSection"
                             Style="{StaticResource TaskSectionTabStyle}"
                             Background="{ThemeResource TintTasksBrush}"
                             AutomationProperties.Name="查看任务通道"
                             Tag="tasks" Checked="Section_Checked" />
                <RadioButton x:Name="NotificationsTab" Content="通知" GroupName="TasksSection"
                             Style="{StaticResource TaskSectionTabStyle}"
                             Background="{ThemeResource TintTasksBrush}"
                             AutomationProperties.Name="查看通知通道"
                             Tag="notifications" Checked="Section_Checked" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="MarkAllReadButton" Content="全部已读" Height="32" Padding="13,0"
                        CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                        Background="{ThemeResource AppChipBrush}" FontSize="11.5"
                        Foreground="{ThemeResource AppText2Brush}" Visibility="Collapsed"
                        AutomationProperties.Name="把所有通知标为已读" Click="MarkAllRead_Click" />
                <Button x:Name="ClearButton" Content="清空已完成" Height="32" Padding="13,0"
                        CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                        Background="{ThemeResource AppChipBrush}" FontSize="11.5"
                        Foreground="{ThemeResource AppText2Brush}"
                        AutomationProperties.Name="清空已完成的任务" Click="Clear_Click" />
                <Button x:Name="ClearNotificationsButton" Content="清空通知" Height="32" Padding="13,0"
                        CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                        Background="{ThemeResource AppChipBrush}" FontSize="11.5"
                        Foreground="{ThemeResource AppText2Brush}" Visibility="Collapsed"
                        AutomationProperties.Name="清空全部通知" Click="ClearNotifications_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid Grid.Column="0">

            <!-- ① 任务通道 -->
            <Grid x:Name="TaskSection">
                <ScrollViewer x:Name="GroupsScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <StackPanel x:Name="RunningSection" Visibility="Collapsed">
                            <Grid Margin="2,0,2,8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{ThemeResource AppGoodBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="正在运行" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
                                    <Border Background="{ThemeResource AppChipBrush}"
                                            CornerRadius="{StaticResource ChipCornerRadius}" Padding="7,2">
                                        <TextBlock x:Name="RunningCountText" Text="0" FontSize="11.5"
                                                   Foreground="{ThemeResource AppGoodBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind RunningGames}"
                                          ItemTemplate="{StaticResource RunningRowTemplate}" />
                        </StackPanel>

                        <StackPanel x:Name="ActiveSection">
                            <StackPanel x:Name="ActiveSectionHeader" Orientation="Horizontal" Spacing="7" Margin="0,3,0,7">
                                <TextBlock Text="进行中" FontSize="12" Foreground="{ThemeResource AppText2Brush}"/>
                                <TextBlock x:Name="ActiveCountText" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="ActiveTasksList" ItemsSource="{x:Bind ActiveTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}" />
                        </StackPanel>

                        <StackPanel x:Name="DoneSection">
                            <StackPanel x:Name="DoneSectionHeader" Orientation="Horizontal" Spacing="7" Margin="0,3,0,7">
                                <TextBlock Text="最近完成" FontSize="12" Foreground="{ThemeResource AppText2Brush}"/>
                                <TextBlock x:Name="DoneCountText" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="DoneTasksList" ItemsSource="{x:Bind DoneTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}" />
                        </StackPanel>

                        <StackPanel x:Name="FailedSection">
                            <StackPanel x:Name="FailedSectionHeader" Orientation="Horizontal" Spacing="7" Margin="0,3,0,7">
                                <TextBlock Text="失败" FontSize="12" Foreground="{ThemeResource AppText2Brush}"/>
                                <TextBlock x:Name="FailedCountText" FontSize="11.5" Foreground="{ThemeResource AppText3Brush}"/>
                            </StackPanel>
                            <ItemsControl x:Name="FailedTasksList" ItemsSource="{x:Bind FailedTasks}"
                                          ItemTemplate="{StaticResource TaskRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyHost" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12">
                    <controls:EmptyState x:Name="EmptyPanel"
                                         Glyph="&#xE7C3;" Title="还没有任务"
                                         Hint="装个版本或启动一次游戏，进度会在这里实时显示。" />
                </StackPanel>
            </Grid>

            <!-- ② 通知通道 -->
            <Grid x:Name="NotificationSection" Visibility="Collapsed">
                <ScrollViewer x:Name="NotificationsScroll" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="NotificationsList" ItemsSource="{x:Bind Notifications}"
                                  ItemTemplate="{StaticResource NotificationRowTemplate}" />
                </ScrollViewer>

                <StackPanel x:Name="NotificationEmptyHost" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="12">
                    <controls:EmptyState x:Name="NotificationEmpty"
                                         Glyph="&#xEA8F;" Title="还没有通知"
                                         Hint="邀请、启动器更新和账户提醒会保留在这里。" />
                </StackPanel>
            </Grid>

            <!-- ③ 加载态 -->
            <controls:LoadingBlock x:Name="LoadingPanel" Text="正在读取任务队列…" Tint="{ThemeResource TintTasksBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- ④ 错误态：图标 + 标题 + 截断摘要 + 原地重试 -->
            <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" MaxWidth="520" Visibility="Collapsed">
                <FontIcon Glyph="&#xE7BA;" FontSize="28"
                          Foreground="{ThemeResource AppWarnBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorTitle" Text="任务队列暂时不可用" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorSummary" FontSize="11.5" TextWrapping="Wrap" MaxLines="3"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Foreground="{ThemeResource AppText3Brush}" HorizontalAlignment="Center" />
                <Button Content="重试" Height="32" Padding="18,0" HorizontalAlignment="Center"
                        CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                        Background="{ThemeResource TintTasksSoftBrush}" FontSize="11.5"
                        Foreground="{ThemeResource TintTasksBrush}"
                        AutomationProperties.Name="重新读取任务队列" Click="Retry_Click" />
            </StackPanel>
            </Grid>

        </Grid>

    </Grid>


</Page>
