<Page
    x:Class="MeowLauncher.WinUI.Views.SimplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="24,16,24,18">
        <Border Style="{StaticResource WidgetCardStyle}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="13" MaxWidth="520">
                    <Border Width="58" Height="58" CornerRadius="18" Background="{ThemeResource AppChipBrush}"
                            HorizontalAlignment="Left">
                        <FontIcon x:Name="PageGlyph" Glyph="&#xE80F;" FontSize="20"
                                  Foreground="{ThemeResource AppAccentBrush}" />
                    </Border>
                    <TextBlock x:Name="PageTitle" Text="页面" FontSize="28" FontWeight="Bold"
                               Foreground="{ThemeResource AppTextBrush}" Margin="0,4,0,0" />
                    <TextBlock x:Name="PageDescription" Text="这个页面还没有迁移。"
                               FontSize="12" Foreground="{ThemeResource AppText2Brush}"
                               TextWrapping="Wrap" LineHeight="22" />
                    <Border Background="{ThemeResource AppChipBrush}" CornerRadius="10" Padding="10,5"
                            HorizontalAlignment="Left">
                        <TextBlock Text="第一阶段 · 外壳已接入" FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource AppText3Brush}" />
                    </Border>
                    <Button Content="回到主页" AutomationProperties.Name="回到主页" Height="38" Padding="18,0" CornerRadius="19"
                            Background="{ThemeResource AppAccentBrush}" Foreground="White"
                            BorderThickness="0" Margin="0,10,0,0" Click="Home_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
