<Page
    x:Class="MeowLauncher.WinUI.Views.OnlineDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- 「获取 › 在线资源 › 某某 Mod」子页：页头（返回箭头 + 面包屑）由「获取」宿主画，这里只有内容。
         中间可滚动（项目卡 / 简介 / 版本列表），底部固定「要装哪个文件 + 安装」。 -->
    <Page.Resources>
        <Style x:Key="FlatItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12" Padding="0,0,0,4">
                <!-- 项目卡：图标 + 标题 + 作者·类型 + 下载量·来源；右侧「打开项目页」 -->
                <Border Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                    <Grid Padding="18,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="10" VerticalAlignment="Top"
                                Background="{ThemeResource TintMediaSoftBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE774;" FontSize="22" Foreground="{ThemeResource TintMediaBrush}" />
                                <Image x:Name="DetailIcon" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailAuthor" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource AppText2Brush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailStats" FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{ThemeResource AppText3Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="打开项目页" VerticalAlignment="Top"
                                Style="{StaticResource QuietButtonStyle}"
                                AutomationProperties.Name="在浏览器打开项目页"
                                Click="DetailOpen_Click" />
                    </Grid>
                </Border>

                <!-- 兼容性提示：只在有问题时出现 -->
                <TextBlock x:Name="DetailHint" Visibility="Collapsed" Margin="2,0,0,0"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{ThemeResource AppWarnBrush}" TextWrapping="Wrap" />

                <Border Background="{ThemeResource AppCardBrush}" BorderBrush="{ThemeResource CardStrokeBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                    <StackPanel Padding="18,14" Spacing="8">
                        <TextBlock Text="简介" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppText2Brush}" />
                        <TextBlock x:Name="DetailDescription" FontSize="13"
                                   Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <TextBlock Text="版本" FontSize="{StaticResource FontSizeCaption}"
                           FontWeight="SemiBold" Margin="2,6,0,0"
                           Foreground="{ThemeResource AppText2Brush}" />

                <!-- 版本整行列表：文件名 + 一行说明；选中 = 品牌绿描边 + 浅底 -->
                <ListView x:Name="FileList" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="File_ItemClick"
                          ItemContainerStyle="{StaticResource FlatItemStyle}"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="56" Margin="0,0,0,6">
                                <Border Background="{ThemeResource AppCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}" />
                                <Border Background="{ThemeResource AppBrandSoftBrush}"
                                        BorderBrush="{ThemeResource AppBrandBrush}" BorderThickness="2"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Visibility="{Binding SelectedVisibility}" />
                                <Grid Padding="18,8,16,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Meta}" FontSize="{StaticResource FontSizeCaption}"
                                                   Foreground="{ThemeResource AppText3Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <Border Background="{Binding TypeBrush}" CornerRadius="8" Padding="7,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeText}" FontSize="11.5"
                                                       Foreground="{ThemeResource AppTextBrush}" />
                                        </Border>
                                        <FontIcon Glyph="&#xE73E;" FontSize="14"
                                                  Foreground="{ThemeResource AppBrandBrush}"
                                                  Visibility="{Binding SelectedVisibility}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,0">
                    <ProgressRing x:Name="FilesBusy" Width="14" Height="14" IsActive="False"
                                  Visibility="Collapsed" VerticalAlignment="Center" />
                    <TextBlock x:Name="FilesNote" FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="FilesRetry" Content="重试" Visibility="Collapsed"
                            Style="{StaticResource QuietButtonStyle}" Click="FilesRetry_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定：要装哪个文件 + 安装 -->
        <Border Grid.Row="1" Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1"
                CornerRadius="{StaticResource CardCornerRadius}">
            <Grid Padding="18,12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="DetailSummary" FontSize="{StaticResource FontSizeBody}"
                               Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="SavePanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="安装到存档" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeCaption}"
                                   Foreground="{ThemeResource AppTextBrush}" />
                        <ComboBox x:Name="SaveBox" MinWidth="220" Height="32"
                                  AutomationProperties.Name="选择要装进的存档"
                                  SelectionChanged="SaveBox_SelectionChanged" />
                    </StackPanel>
                    <TextBlock x:Name="DepsLink" Visibility="Collapsed" Margin="0,1,0,0"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource AppText2Brush}"
                               TextDecorations="Underline"
                               IsTextSelectionEnabled="False"
                               ToolTipService.ToolTip="查看并选择要一起安装的前置"
                               Tapped="DepsLink_Tapped" />
                </StackPanel>
                <Button x:Name="DetailInstall" Grid.Column="1" Content="安装" Height="36" MinWidth="136"
                        Padding="20,0" CornerRadius="4" BorderThickness="0"
                        Background="{ThemeResource AppBrandBrush}"
                        Foreground="{ThemeResource AppBrandTextBrush}"
                        AutomationProperties.Name="安装选中的版本"
                        Click="DetailInstall_Click" />
            </Grid>
        </Border>
    </Grid>
</Page>
