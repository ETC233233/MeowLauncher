                                                            </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                                            <Grid ColumnSpacing="14" MinHeight="34">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="诊断包" Style="{StaticResource RowLabelStyle}" />
