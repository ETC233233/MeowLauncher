                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="配置目录" Style="{StaticResource RowLabelStyle}" />
                                                                <Button Grid.Column="2" Content="打开" Style="{StaticResource PillButtonStyle}"
