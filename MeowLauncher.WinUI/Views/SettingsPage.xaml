                        </StackPanel>
                    </StackPanel>

                    <!-- 关于页按用户导出的 meow-about-layout.json 编排；备注转为控件行为。 -->
                    <StackPanel Spacing="8" x:Name="AboutCard" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="14" Padding="0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AppChipBrush}">
                                    <Image Source="ms-appx:///Assets/Icons/Packaged/Square44x44Logo.targetsize-256_altform-unplated.png" Stretch="Uniform" Margin="4" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="MeowLauncher" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock x:Name="AboutVersionText" FontSize="12" Foreground="{ThemeResource AppText3Brush}" Tapped="AboutVersion_Tapped" />
                                </StackPanel>
                                <Button x:Name="AboutGithubButton" Grid.Column="2" Width="40" Height="40" Padding="8" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Click="OpenRepo_Click"
                                    AutomationProperties.Name="打开 GitHub 仓库" ToolTipService.ToolTip="GitHub">
                                    <!-- GitHub Octicons mark-github-24, MIT: https://github.com/primer/octicons -->
                                    <PathIcon Data="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943" />
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AboutNoticeText" Visibility="Collapsed" Style="{StaticResource GroupDescStyle}" />
                        <TextBlock Text="维护与还原" Margin="0,8,0,0" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="新手引导" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="重新开启新手引导教程" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel>
                                <Button Grid.Column="1" Content="开始" Style="{StaticResource SettingsActionStyle}" Click="OpenOnboarding_Click" AutomationProperties.Name="开始新手引导" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="导出日志" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="打包并导出轻量诊断文件" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel>
                                <Button Grid.Column="1" Content="导出" Style="{StaticResource SettingsActionStyle}" Click="ExportDiagnostics_Click" AutomationProperties.Name="导出日志" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="日志目录" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="查看启动器及实例运行日志" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开" Style="{StaticResource SettingsActionStyle}" Click="OpenLogsFolder_Click" AutomationProperties.Name="打开日志目录" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="清理缓存" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="仅清理启动器内本地缓存文件" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel>
                                <Button Grid.Column="1" Content="清理" Style="{StaticResource SettingsActionStyle}" Click="ClearCache_Click" AutomationProperties.Name="清理缓存" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="重置设置" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="重置启动器所有设置（重启启动器后生效）" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel>
                                <Button Grid.Column="1" Content="重置" Style="{StaticResource SettingsActionStyle}" Click="ResetSettings_Click" AutomationProperties.Name="重置设置" />
                            </Grid>
                        </Border>
                        <TextBlock Text="版本与更新" Margin="0,8,0,0" Style="{StaticResource GroupTitleStyle}" />
                        <Expander x:Name="AutomaticUpdatesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" CornerRadius="6">
                            <Expander.Header><StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="自动更新设置" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="决定启动器是否自动检查和下载更新" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel></Expander.Header>
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="20" MinHeight="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动检查更新" Style="{StaticResource RowLabelStyle}" />
                                    <ToggleSwitch x:Name="CheckUpdatesSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                        AutomationProperties.Name="自动检查更新" Toggled="CheckUpdatesSwitch_Toggled" />
                                </Grid>
                                <Grid ColumnSpacing="20" MinHeight="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动下载更新" Style="{StaticResource RowLabelStyle}" />
                                    <ToggleSwitch x:Name="AutoDownloadUpdateSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                        AutomationProperties.Name="自动下载更新" Toggled="AutomaticUpdateSwitch_Toggled" />
                                </Grid>
                                <Grid ColumnSpacing="20" MinHeight="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动安装更新" Style="{StaticResource RowLabelStyle}" />
                                    <ToggleSwitch x:Name="AutoInstallUpdateSwitch" Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                        AutomationProperties.Name="自动安装更新" Toggled="AutomaticUpdateSwitch_Toggled" />
                                </Grid>
                                <TextBlock x:Name="AutomaticUpdateNoticeText" Margin="0,8,0,0" Style="{StaticResource GroupDescStyle}" />
                            </StackPanel>
                        </Expander>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="更新渠道" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="选择当前更新的渠道" Style="{StaticResource GroupDescStyle}" x:Name="UpdateChannelDescriptionText" />
                                </StackPanel>
                                <ComboBox x:Name="UpdateChannelBox" Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                    AutomationProperties.Name="更新渠道" SelectionChanged="UpdateChannelBox_SelectionChanged">
                                    <ComboBoxItem Content="Release" Tag="stable" />
                                    <ComboBoxItem Content="Beta" Tag="beta" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="当前版本" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="" Style="{StaticResource GroupDescStyle}" x:Name="UpdateCurrentText" Tapped="AboutVersion_Tapped" />
                                </StackPanel>
                                <Button x:Name="UpdateCheckButton" Grid.Column="1" Content="检查更新" Style="{StaticResource SettingsActionStyle}" Click="UpdateCheck_Click" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="UpdateResultPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource GroupDescStyle}" />
                            <Button x:Name="UpdateOpenButton" Content="查看并下载" Style="{StaticResource SettingsActionStyle}" Visibility="Collapsed" Click="UpdateOpen_Click" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="项目源仓库" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="此启动器项目的 Github 源码仓库" Style="{StaticResource GroupDescStyle}" />
                                </StackPanel>
                                <Button x:Name="AboutRepoButton" Grid.Column="1" Content="打开" Style="{StaticResource SettingsActionStyle}" Click="OpenRepo_Click" AutomationProperties.Name="打开源码仓库" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="开源许可证" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="本项目所使用的开源许可证" Style="{StaticResource GroupDescStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="GPL-3.0" Style="{StaticResource RowValueStyle}" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="第三方开源许可" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="第三方组件的许可证与声明" Style="{StaticResource GroupDescStyle}"  />
                                </StackPanel>
                                <Button Grid.Column="1" Content="查看" Style="{StaticResource SettingsActionStyle}" Click="OpenLicenses_Click" AutomationProperties.Name="查看第三方开源许可" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="AboutOnlineComponents" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="第三方组件" Margin="0,8,0,0" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="20" MinHeight="38">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="联机模块" Style="{StaticResource RowLabelStyle}" />
                                        <TextBlock x:Name="AboutModuleVersionText" Style="{StaticResource GroupDescStyle}" />
                                    </StackPanel>
                                    <Button x:Name="AboutModuleUpdateButton" Grid.Column="1" Content="检查更新"
                                            Style="{StaticResource SettingsActionStyle}" Click="AboutModuleUpdate_Click"
                                            AutomationProperties.Name="管理联机模块更新" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AboutModuleNoteText" Visibility="Collapsed" Style="{StaticResource GroupDescStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="20" MinHeight="38">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="EasyTier 组件" Style="{StaticResource RowLabelStyle}" />
                                        <TextBlock x:Name="AboutEasyTierVersionText" Style="{StaticResource GroupDescStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="该组件跟随联机模块下载，不支持独立更新" MaxWidth="260" TextWrapping="Wrap" Style="{StaticResource RowValueStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="致谢" Margin="0,8,0,0" Style="{StaticResource GroupTitleStyle}" />
                        <TextBlock Style="{StaticResource GroupDescStyle}" Text="由 bangbang93 维护的 BMCLAPI 为 MeowLauncher 提供 Minecraft 与 Mod 加载器的部分下载服务&#xA;&#xA;由 MCIM 镜像站为 MeowLauncher 提供 Mods 检索下载加速服务&#xA;&#xA;由 EasyTier 项目为 MeowLauncher 联机模块提供基础联机工具服务&#xA;&#xA;由 Cloudflare 为本项目提供出色的平台搭建与承载服务&#xA;&#xA;以及每一位参与本项目测试和反馈的小伙伴们" />
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="20" MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="服务域名备案" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="本项目服务网站的 ICP 备案信息" Style="{StaticResource GroupDescStyle}" />
                                </StackPanel>
                                <HyperlinkButton Grid.Column="1" Content="晋ICP备2024042413号-1" NavigateUri="https://beian.miit.gov.cn" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="查看服务域名 ICP 备案信息" />
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
        </ScrollViewer>

        </Grid>

        <InfoBar x:Name="Toast" IsOpen="False" Severity="Informational"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Width="360" Margin="0,0,8,8" IsClosable="True" />
    </Grid>
</Page>
