                                        <NumberBox x:Name="DownloadParallelBox" Width="130" Height="32" Minimum="1"
                                                   Maximum="16" SmallChange="1" LargeChange="1"
                                                   SpinButtonPlacementMode="Compact" Value="8"
                                                   ValueChanged="DownloadParallel_Changed" />
