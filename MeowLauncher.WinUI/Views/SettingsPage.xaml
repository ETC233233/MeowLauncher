                                                                <Button Grid.Column="2" Content="导出" Style="{StaticResource PillButtonStyle}"
                                                                        Click="ExportDiagnostics_Click" AutomationProperties.Name="导出诊断包" />
                                                            </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
