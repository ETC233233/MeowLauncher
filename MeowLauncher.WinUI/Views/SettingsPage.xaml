                                                   HorizontalAlignment="Left" TextAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ④ 游戏与进程 -->
                    <StackPanel Spacing="12" x:Name="JavaCard" Visibility="Collapsed">
