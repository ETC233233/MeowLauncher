                                            VerticalAlignment="Center" Click="ManageJava_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="内存与 JVM" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
