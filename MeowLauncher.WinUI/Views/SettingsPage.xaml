                                <Grid ColumnSpacing="14" MinHeight="38" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动游戏后" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox Grid.Column="1" x:Name="AfterLaunchBox" Height="32" MinWidth="200"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              SelectionChanged="AfterLaunch_Changed">
                                        <ComboBoxItem Content="留在前台" Tag="keep" />
                                        <ComboBoxItem Content="最小化到任务栏" Tag="minimize" />
                                    </ComboBox>
                                </Grid>


                            

                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
