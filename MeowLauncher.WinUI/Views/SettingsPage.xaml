                                                   SmallChange="1" LargeChange="100" SpinButtonPlacementMode="Compact" VerticalAlignment="Center"
                                                   Value="7890" ValueChanged="ProxyPort_Changed" />
                                    </Grid>
                                </Grid>

                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=ProxyAuthRow}">
                                <Grid x:Name="ProxyAuthRow" ColumnSpacing="14" MinHeight="38" Visibility="Collapsed">
