                    <StackPanel Spacing="12" x:Name="DevCard" Visibility="Collapsed">
                        <StackPanel Spacing="4">

                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启用开发者测试" Style="{StaticResource RowLabelStyle}" />
                                    <ToggleSwitch x:Name="DevFeaturesSwitch" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,-12,0"
                                                  OnContent="" OffContent="" Toggled="DevFeaturesSwitch_Toggled" MinWidth="0" />
                                </Grid>
                            </Border>
                            <TextBlock Text="仅供通过开发者认证的账号使用。这里的功能还在测试中，可能不稳定，也不会出现在正式版里。打开后，下面的实验功能才可以使用。"
                                       Style="{StaticResource GroupDescStyle}" />

                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=DevFeaturesPanel}">
