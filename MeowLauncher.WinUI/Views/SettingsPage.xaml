                                             HorizontalAlignment="Right" PlaceholderText="留空用 https://gh-proxy.com/"
                                             TextChanged="GithubAccelHost_Changed" />
                                </Grid>

                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="代理" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
