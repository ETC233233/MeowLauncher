<Page
    x:Class="MeowLauncher.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    IsTabStop="True"
    Background="Transparent">

    <!--
      设置页：常规 / 外观 / 游戏与进程 / 下载与网络 / 关于与更新，认证后显示开发者测试。
      全部自动保存（去抖 650ms），没有保存按钮、没有只读路径陈列卡。
    -->
    <Page.Resources>
        <Style x:Key="SettingsRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        </Style>
        <Style x:Key="GroupDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingsActionStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="224" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <!-- 当前 Fluent 模板为 44px 轨道 + 12px 内容间距；保留完整轨道与系统动效。 -->
            <Setter Property="Width" Value="56" />
            <Setter Property="Margin" Value="0,0,-12,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
        <Style x:Key="SettingsTabStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" CornerRadius="14" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SegmentSelectedBrush}" />
                                            <Setter Target="Label.Foreground" Value="{ThemeResource SegmentSelectedTextBrush}" />
                                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AppText2Brush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentFrameStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="NavIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TintClockBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRootGrid" Padding="{StaticResource PagePadding}" SizeChanged="PageRootGrid_SizeChanged">
        <Grid x:Name="ContentColumn" Width="980" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 页头：面包屑 + 自动保存状态（全页唯一的状态位，没有保存按钮） -->
            <Grid Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="AutoSaveBox" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                              Foreground="{ThemeResource TintClockBrush}" />
                    <TextBlock x:Name="AutoSaveStatus" Text=""
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource AppText3Brush}" />
                </StackPanel>
            </Grid>

        <Border Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Left"
                Padding="3" CornerRadius="10" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeBrush}" Background="{ThemeResource AppCardBrush}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="NavLaunch" Tag="launch" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="常规设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="常规" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAppearance" Tag="appearance" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="外观设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="外观" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavJava" Tag="java" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="游戏与进程设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="游戏" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavNetwork" Tag="network" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="下载与网络设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="下载与网络" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavDev" Tag="dev" Style="{StaticResource SettingsTabStyle}" Visibility="Collapsed"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="开发者测试" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="开发者测试" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAbout" Tag="about" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="关于与更新" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="关于" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 当前分类的设置分组 -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" Padding="0,0,16,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Spacing="14">

                    <!-- ① 启动 -->
                    <StackPanel x:Name="GeneralContent" Spacing="14" Visibility="Collapsed">
                    <StackPanel Spacing="12" x:Name="LaunchCard">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启动" Style="{StaticResource GroupTitleStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LaunchStatusText" Grid.Column="1"
                                           Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left"
                                           TextAlignment="Left" VerticalAlignment="Center" Margin="8,0" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动时显示" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox Style="{StaticResource SettingsComboStyle}" x:Name="HomeStartScreenBox" Grid.Column="2"
                                              SelectionChanged="HomeStartScreen_Changed"
                                              AutomationProperties.Name="启动时显示哪一屏">
                                        <ComboBoxItem Content="继续玩（负一屏）" Tag="continue" />
                                        <ComboBoxItem Content="组件板" Tag="board" />
                                    </ComboBox>
                                </Grid>

                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="游戏目录" Style="{StaticResource RowLabelStyle}" />
                                    <Button VerticalAlignment="Center" Grid.Column="2" Content="管理游戏目录…" Style="{StaticResource SettingsActionStyle}"
                                            AutomationProperties.Name="管理游戏目录" Click="ManageGameDirs_Click" />
                                </Grid>

                            </Border>
                        </StackPanel>

                    </StackPanel>

                    <!-- ② 已隐藏版本（独立卡：本质是实例管理的恢复入口） -->
                    <!-- 通知 -->
                    <StackPanel x:Name="NotifyCard" Spacing="4">
                        <TextBlock Text="通知" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="14" MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="任务完成时在启动器里提醒" Grid.ColumnSpan="2" TextTrimming="CharacterEllipsis" Style="{StaticResource RowLabelStyle}" />
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" x:Name="NotifyTaskDoneSwitch" Grid.Column="2" Toggled="NotifyTaskDoneSwitch_Toggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsRowCardStyle}">
                            <Grid ColumnSpacing="14" MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="156" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="显示任务药丸" Style="{StaticResource RowLabelStyle}" />
                                <ToggleSwitch Style="{StaticResource SettingsToggleStyle}" x:Name="ShowTaskIslandSwitch" Grid.Column="2" Toggled="ShowTaskIslandSwitch_Toggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border x:Name="HiddenVersionsCard" Style="{StaticResource WidgetCardStyle}">
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="已隐藏版本" Style="{StaticResource GroupTitleStyle}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock x:Name="HiddenCountValue" VerticalAlignment="Center" Grid.Column="1"
                                                                           Style="{StaticResource RowValueStyle}" />
                                                            </Grid>
                                                            <ItemsControl x:Name="HiddenList">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid ColumnSpacing="12" MinHeight="38">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Id}" FontSize="{StaticResource FontSizeBody}"
                                                                                           Foreground="{ThemeResource AppTextBrush}" />
                                                                                <TextBlock Text="{Binding Root}" TextTrimming="CharacterEllipsis"
                                                                                           ToolTipService.ToolTip="{Binding Root}"
                                                                                           FontSize="{StaticResource FontSizeCaption}"
                                                                                           Foreground="{ThemeResource AppText2Brush}" />
                                                                                <TextBlock Text="{Binding SinceText}"
                                                                                           FontSize="{StaticResource FontSizeCaption}"
                                                                                           Foreground="{ThemeResource AppText3Brush}" />
                                                                            </StackPanel>
                                                                            <Button VerticalAlignment="Center" Grid.Column="1" Content="恢复" Style="{StaticResource SettingsActionStyle}"
                                                                                    AutomationProperties.Name="恢复这个版本"
                                                                                    Tag="{Binding}" Click="Unhide_Click" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <controls:EmptyState x:Name="HiddenEmpty" Glyph="&#xE7C3;"
                                                                                 Title="没有已隐藏的版本"
                                                                                 Hint="在版本管理里隐藏的实例会出现在这里。"
                                                                                 Visibility="Collapsed" />
                                                        </StackPanel>
                    </Border>

                    <!-- ③ 外观 -->

                    </StackPanel>
                    <StackPanel Spacing="12" x:Name="AppearanceCard" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题" Style="{StaticResource GroupTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AppearanceStatusText" Grid.Column="1"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left"
                                               TextAlignment="Left" VerticalAlignment="Center" Margin="8,0" />
                                </Grid>

                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox Style="{StaticResource SettingsComboStyle}" Grid.Column="2" x:Name="ThemeBox"
                                              SelectionChanged="Theme_Changed"
                                              AutomationProperties.Name="主题模式">
                                        <ComboBoxItem Content="跟随系统" Tag="system" />
                                        <ComboBoxItem Content="深色" Tag="dark" />
                                        <ComboBoxItem Content="浅色" Tag="light" />
                                    </ComboBox>
                                </Grid>

    <!-- 主题色：系统强调色 / 壁纸取色（莫奈）/ 自定义；右侧色块直接点开取色器。 -->
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题色" Style="{StaticResource RowLabelStyle}" />
                                    <StackPanel HorizontalAlignment="Right" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <ComboBox Style="{StaticResource SettingsComboStyle}" x:Name="ThemeColorBox"
                                                  SelectionChanged="ThemeColor_Changed">
                                            <ComboBoxItem Content="跟随壁纸取色" Tag="wallpaper" />
                                            <ComboBoxItem Content="跟随系统强调色" Tag="accent" />
                                            <ComboBoxItem Content="自定义颜色" Tag="custom" />
                                        </ComboBox>
                                        <Button x:Name="ThemeColorSwatch" Width="32" Height="32" Padding="0"
                                                CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeBrush}"
                                                AutomationProperties.Name="选择主题色"
                                                ToolTipService.ToolTip="打开取色器"
                                                Click="ThemeColorSwatch_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThemeColorValueText" VerticalAlignment="Center" Grid.Column="2"
                                               Style="{StaticResource RowValueStyle}" Text="#2FA35A" />
                                </Grid>


                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="材质与主题" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <TextBlock Text="窗口材质与背景主题无法共存，仅能选择一者启用" Style="{StaticResource GroupDescStyle}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="窗口材质" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox Style="{StaticResource SettingsComboStyle}" Grid.Column="2" x:Name="BackgroundBox"
                                              SelectionChanged="Background_Changed">
                                        <ComboBoxItem Content="Acrylic" Tag="Acrylic" />
                                        <ComboBoxItem Content="Mica" Tag="Mica" />
                                        <ComboBoxItem Content="无效果" Tag="Solid" />
                                    </ComboBox>
                                </Grid>

                            </Border>
                            <InfoBar x:Name="EnergySaverNotice" IsOpen="True" IsClosable="False"
                                     Severity="Informational" Visibility="Collapsed"
                                     Message="当前系统已启用节能模式，已自动关闭透明效果。" />
                            <Border x:Name="AcrylicKindRow" Style="{StaticResource SettingsRowCardStyle}" Visibility="Collapsed">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="亚克力样式" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox x:Name="AcrylicKindBox" Grid.Column="2" Style="{StaticResource SettingsComboStyle}"
                                              AutomationProperties.Name="亚克力样式" SelectionChanged="Background_Changed">
                                        <ComboBoxItem Content="正常" Tag="normal" />
                                        <ComboBoxItem Content="轻质" Tag="thin" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景主题" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox x:Name="BackgroundThemeBox" Grid.Column="2" Style="{StaticResource SettingsComboStyle}"
                                              AutomationProperties.Name="背景主题" SelectionChanged="Background_Changed">
                                        <ComboBoxItem Content="无" Tag="None" />
                                        <ComboBoxItem Content="像素小猫" Tag="PixelWallpaper" />
                                        <ComboBoxItem Content="跟随壁纸" Tag="Wallpaper" />
                                        <ComboBoxItem Content="自定义图片" Tag="Image" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="WallpaperEffectsPanel" Visibility="Collapsed" Spacing="4">
                                <Border Style="{StaticResource SettingsRowCardStyle}">
                                    <Grid ColumnSpacing="14" MinHeight="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="156" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="模糊程度" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="WallpaperBlurSlider" Grid.Column="1" Width="210" Minimum="0" Maximum="40" StepFrequency="1"
                                                HorizontalAlignment="Right" AutomationProperties.Name="壁纸模糊程度" ValueChanged="WallpaperEffects_Changed" />
                                        <TextBlock x:Name="WallpaperBlurValue" Grid.Column="2" Style="{StaticResource RowValueStyle}" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SettingsRowCardStyle}">
                                    <Grid ColumnSpacing="14" MinHeight="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="156" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="遮罩强度" Style="{StaticResource RowLabelStyle}" />
                                        <Slider x:Name="WallpaperShadeSlider" Grid.Column="1" Width="210" Minimum="0" Maximum="0.8" StepFrequency="0.01"
                                                HorizontalAlignment="Right" AutomationProperties.Name="壁纸遮罩强度" ValueChanged="WallpaperEffects_Changed" />
                                        <TextBlock x:Name="WallpaperShadeValue" Grid.Column="2" Style="{StaticResource RowValueStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=BackgroundImageRow}">
                                <Grid x:Name="BackgroundImageRow" ColumnSpacing="14" MinHeight="38"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景图片" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="BackgroundImageValue" Grid.Column="1"
                                               Style="{StaticResource RowValueStyle}" Text="未选择"
                                               HorizontalAlignment="Left" TextAlignment="Left" />
                                    <Button x:Name="ChooseImageButton" Grid.Column="2" Content="选择图片"
                                            Style="{StaticResource SettingsActionStyle}"
                                            AutomationProperties.Name="选择背景图片" Click="ChooseImage_Click" />
                                </Grid>

                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="可读性" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="156" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字体缩放" Style="{StaticResource RowLabelStyle}" />
                                    <Slider Grid.Column="1" x:Name="FontScaleSlider" Width="210" Minimum="0.85" Maximum="1.25"
                                            StepFrequency="0.05" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" ValueChanged="FontScale_Changed" />
