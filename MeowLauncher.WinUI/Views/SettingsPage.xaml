                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="启用联机功能" Style="{StaticResource RowLabelStyle}" />
                                        <ToggleSwitch x:Name="OnlineEnabledSwitch" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,-12,0"
                                                      OnContent="" OffContent="" Toggled="OnlineEnabledSwitch_Toggled" MinWidth="0" />
                                    </Grid>
                                    <Grid ColumnSpacing="14" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="向好友显示在线" Style="{StaticResource RowLabelStyle}" />
                                        <ToggleSwitch x:Name="ShareOnlineSwitch" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,-12,0"
                                                      OnContent="" OffContent="" Toggled="ShareOnlineSwitch_Toggled" MinWidth="0" />
                                    </Grid>
                                    <TextBlock Text="开启联机后，启动器会向 Mojang 好友系统上报你的在线状态（带 MeowLauncher 标记），你的好友能看到你在线；游戏运行时不会覆盖游戏里的状态。关闭后不会上报任何状态。"
                                               Style="{StaticResource GroupDescStyle}" />
                                    <TextBlock x:Name="OnlineEnvHint" Visibility="Collapsed"
                                               Text="环境变量 MEOW_ONLINE 已强制启用联机（测试用），上面的开关暂时不起作用。"
                                               Style="{StaticResource GroupDescStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 更新（T8 第 2 步）：没有更新服务，就不写「已是最新版本」 -->
                    <StackPanel Spacing="12" x:Name="UpdateCard" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                                <TextBlock Text="更新偏好" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="更新渠道" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox x:Name="UpdateChannelBox" Grid.Column="2" Width="140" Height="32" VerticalAlignment="Center"
                                              SelectionChanged="UpdateChannelBox_SelectionChanged">
                                        <ComboBoxItem Content="正式版" Tag="stable" />
                                        <ComboBoxItem Content="尝鲜版" Tag="beta" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动时检查更新" Style="{StaticResource RowLabelStyle}" />
                                    <ToggleSwitch x:Name="CheckUpdatesSwitch" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,-12,0"
                                                  OnContent="" OffContent="" Toggled="CheckUpdatesSwitch_Toggled" MinWidth="0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="版本与更新" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前版本" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="UpdateCurrentText" Grid.Column="1" VerticalAlignment="Center"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                    <Button x:Name="UpdateCheckButton" Grid.Column="2" Content="检查更新" Style="{StaticResource PillButtonStyle}"
                                            Click="UpdateCheck_Click" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="最新版本" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="UpdateLatestText" Grid.Column="1" VerticalAlignment="Center"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                    <Button x:Name="UpdateOpenButton" Grid.Column="2" Content="查看并下载" Style="{StaticResource PillButtonStyle}"
                                            Visibility="Collapsed" Click="UpdateOpen_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="UpdateStatusText" Visibility="Collapsed" TextWrapping="Wrap"
                                       Style="{StaticResource GroupDescStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=ComponentSection}">
                                <StackPanel x:Name="ComponentSection" Spacing="12" Visibility="Collapsed">
                                    <TextBlock Text="联机组件" Style="{StaticResource RowLabelStyle}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <Grid ColumnSpacing="14" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="版本" Style="{StaticResource RowLabelStyle}" />
                                        <TextBlock x:Name="ComponentStatusText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ComponentActionButton" Content="下载" Style="{StaticResource PillButtonStyle}"
                                                    Visibility="Collapsed" Click="ComponentAction_Click" />
                                            <Button x:Name="ComponentCheckButton" Content="检查更新" Style="{StaticResource PillButtonStyle}"
                                                    Click="ComponentCheck_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="ComponentNoteText" Visibility="Collapsed" TextWrapping="Wrap"
                                               Style="{StaticResource GroupDescStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 关于（T8 第 1 步）：只放真实信息，没有更新服务就不写「已是最新版本」 -->
                    <StackPanel Spacing="12" x:Name="AboutCard" Margin="0,0,0,12">
                        <StackPanel Spacing="4">

                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource AppChipBrush}">
                                        <Image Source="ms-appx:///Assets/Icons/Packaged/Square44x44Logo.targetsize-256_altform-unplated.png"
                                               Stretch="Uniform" Margin="4" />
                                    </Border>
                                    <StackPanel HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="MeowLauncher" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}" />
                                        <TextBlock x:Name="AboutSummaryText" FontSize="12"
                                                   Foreground="{ThemeResource AppText3Brush}" Text="启动器" />
                                        <TextBlock x:Name="AboutBuildText" FontSize="12" Visibility="Collapsed"
                                                   Foreground="{ThemeResource AppText3Brush}" />
                                        <TextBlock x:Name="AboutNoticeText" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource AppText3Brush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="版本" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="AboutVersionText" Text="版本 —" Grid.Column="1" VerticalAlignment="Center" Tapped="AboutVersion_Tapped"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="AboutRuntimeText" Text="运行环境 —" Grid.Column="2" VerticalAlignment="Center"
                                               Style="{StaticResource RowValueStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="项目与组件" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开源许可" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock Text="第三方组件的许可证与声明" Grid.Column="1" VerticalAlignment="Center"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                    <Button Grid.Column="2" Content="查看" Style="{StaticResource PillButtonStyle}"
                                            AutomationProperties.Name="查看第三方许可证" Click="OpenLicenses_Click" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="源码仓库" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="AboutRepoText" Grid.Column="1" VerticalAlignment="Center"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                    <Button x:Name="AboutRepoButton" Grid.Column="2" Content="打开" Style="{StaticResource PillButtonStyle}"
                                            AutomationProperties.Name="打开源码仓库" Click="OpenRepo_Click" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=AboutComponentRow}">
                                <Grid x:Name="AboutComponentRow" ColumnSpacing="14" MinHeight="34" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="联机组件" Style="{StaticResource RowLabelStyle}" />
                                    <TextBlock x:Name="AboutComponentText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left" />
                                    <Button x:Name="AboutComponentButton" Grid.Column="2" Content="源码仓库" Style="{StaticResource PillButtonStyle}"
                                            AutomationProperties.Name="打开联机组件源码仓库" Click="OpenRepo_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
        </ScrollViewer>

        </Grid>

        <InfoBar x:Name="Toast" IsOpen="False" Severity="Informational"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Width="360" Margin="0,0,8,8" IsClosable="True" />
    </Grid>
</Page>
