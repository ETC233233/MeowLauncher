<Page
    x:Class="MeowLauncher.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    IsTabStop="True"
    Background="Transparent">

    <!--
      设置页（契约 3/5/6/7）：左侧一级分类（对标 PCL-CE PageSetupLeft 左栏 + PrismLauncher 类页切换），
      右侧只显示当前分类；语义色 = 灰蓝（附录 A clock）。
      五个分类：启动 / 外观 / 下载与网络 / 游戏与进程 / 高级。
      全部自动保存（去抖 650ms），没有保存按钮、没有只读路径陈列卡。
    -->
    <Page.Resources>
        <Style x:Key="SettingsRowCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Foreground" Value="{ThemeResource AppText2Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        </Style>
        <Style x:Key="GroupDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{ThemeResource AppText3Brush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource AppTextBrush}" />
        </Style>
        <Style x:Key="SettingsTabStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Root" CornerRadius="14" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SegmentSelectedBrush}" />
                                            <Setter Target="Label.Foreground" Value="{ThemeResource SegmentSelectedTextBrush}" />
                                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AppText2Brush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentFrameStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
            <Setter Property="Background" Value="{ThemeResource AppChipBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="NavIconStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TintClockBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRootGrid" Padding="{StaticResource PagePadding}" SizeChanged="PageRootGrid_SizeChanged">
        <Grid x:Name="ContentColumn" Width="980" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 页头：面包屑 + 自动保存状态（全页唯一的状态位，没有保存按钮） -->
            <Grid Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="AutoSaveBox" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE73E;" FontSize="12"
                              Foreground="{ThemeResource TintClockBrush}" />
                    <TextBlock x:Name="AutoSaveStatus" Text=""
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{ThemeResource AppText3Brush}" />
                </StackPanel>
            </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollMode="Enabled"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Left">
            <Border Padding="3" CornerRadius="10" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeBrush}" Background="{ThemeResource AppCardBrush}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                <Button x:Name="NavLaunch" Tag="launch" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="常规设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="常规" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAppearance" Tag="appearance" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="外观设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE790;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="外观" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavJava" Tag="java" MinWidth="120" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="游戏与进程设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="游戏与进程" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavNetwork" Tag="network" MinWidth="120" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="下载与网络设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="下载与网络" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavNotify" Tag="notify" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="通知设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7E7;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="通知" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavUpdate" Tag="update" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="更新设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="更新" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAdvanced" Tag="advanced" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="诊断设置" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE713;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="诊断" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavDev" Tag="dev" MinWidth="120" Style="{StaticResource SettingsTabStyle}" Visibility="Collapsed"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="开发者测试" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE943;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="开发者测试" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAbout" Tag="about" Style="{StaticResource SettingsTabStyle}"
                        HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                        AutomationProperties.Name="关于" Click="Nav_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" Style="{StaticResource NavIconStyle}" />
                        <TextBlock Text="关于" FontSize="14" Foreground="{ThemeResource AppTextBrush}" Opacity="0.6" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 当前分类的设置分组 -->
        <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel HorizontalAlignment="Stretch" Spacing="14">

                    <!-- ① 启动 -->
                    <StackPanel Spacing="12" x:Name="LaunchCard" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启动" Style="{StaticResource GroupTitleStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="LaunchStatusText" Grid.Column="1"
                                           Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left"
                                           TextAlignment="Left" VerticalAlignment="Center" Margin="8,0" />
                            </Grid>

                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动时显示" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox x:Name="HomeStartScreenBox" Grid.Column="2" VerticalAlignment="Center" Width="220" Height="32"
                                              HorizontalAlignment="Right" SelectionChanged="HomeStartScreen_Changed"
                                              AutomationProperties.Name="启动时显示哪一屏">
                                        <ComboBoxItem Content="继续玩（负一屏）" Tag="continue" />
                                        <ComboBoxItem Content="组件板" Tag="board" />
                                    </ComboBox>
                                </Grid>

                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="游戏目录" Style="{StaticResource RowLabelStyle}" />
                                    <Button VerticalAlignment="Center" Grid.Column="2" Content="管理游戏目录…" Style="{StaticResource PillButtonStyle}"
                                            AutomationProperties.Name="管理游戏目录" Click="ManageGameDirs_Click" />
                                </Grid>

                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="窗口" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                        <Grid ColumnSpacing="14" MinHeight="38">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="窗口尺寸" Style="{StaticResource RowLabelStyle}" />
                                                                <Border Grid.Column="2" Style="{StaticResource SegmentFrameStyle}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                                                    <RadioButton x:Name="AutoSizeChip" GroupName="WindowSizeMode" Content="自适应"
                                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                                 AutomationProperties.Name="窗口尺寸自适应"
                                                                                 Checked="WindowMode_Checked" />
                                                                    <RadioButton x:Name="FixedSizeChip" GroupName="WindowSizeMode" Content="固定"
                                                                                 Style="{StaticResource SegmentRadioStyle}"
                                                                                 AutomationProperties.Name="窗口尺寸固定"
                                                                                 Checked="WindowMode_Checked" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                            
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=CustomSizeRow}">
                                                            <Grid x:Name="CustomSizeRow" ColumnSpacing="14" MinHeight="38" Visibility="Collapsed">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="自定义尺寸" Style="{StaticResource RowLabelStyle}" />
                                                                <StackPanel HorizontalAlignment="Right" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                    <NumberBox x:Name="WindowWidthBox" Width="116" Height="32" Minimum="880"
                                                                               Maximum="3840" SpinButtonPlacementMode="Compact"
                                                                               SmallChange="40" LargeChange="160" ValueChanged="WindowSize_Changed" />
                                                                    <TextBlock Text="×" Style="{StaticResource RowLabelStyle}" />
                                                                    <NumberBox x:Name="WindowHeightBox" Width="116" Height="32" Minimum="620"
                                                                               Maximum="2160" SpinButtonPlacementMode="Compact"
                                                                               SmallChange="40" LargeChange="160" ValueChanged="WindowSize_Changed" />
                                                                </StackPanel>
                                                            </Grid>
                            
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                                            <Grid ColumnSpacing="14" MinHeight="38">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="记住尺寸" Style="{StaticResource RowLabelStyle}" />
                                                                <ToggleSwitch Grid.Column="2" x:Name="RememberWindowSwitch" HorizontalAlignment="Right" Margin="0,0,-12,0"
                                                                              OnContent="" OffContent=""
                                                                              Toggled="RememberWindow_Toggled" MinWidth="0" />
                                                            </Grid>

                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                                            <Grid ColumnSpacing="14" MinHeight="38">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="104" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="忽略系统缩放" Style="{StaticResource RowLabelStyle}" />
                                                                <ToggleSwitch Grid.Column="2" x:Name="IgnoreDpiSwitch" HorizontalAlignment="Right" Margin="0,0,-12,0"
                                                                              OnContent="" OffContent=""
                                                                              AutomationProperties.Name="忽略系统缩放比例"
                                                                              Toggled="IgnoreDpi_Toggled" MinWidth="0" />
                                                            </Grid>
                            

                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ② 已隐藏版本（独立卡：本质是实例管理的恢复入口） -->
                    <Border x:Name="HiddenVersionsCard" Style="{StaticResource WidgetCardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="已隐藏版本" Style="{StaticResource GroupTitleStyle}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock x:Name="HiddenCountValue" VerticalAlignment="Center" Grid.Column="1"
                                                                           Style="{StaticResource RowValueStyle}" />
                                                            </Grid>
                                                            <ItemsControl x:Name="HiddenList">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid ColumnSpacing="12" MinHeight="38">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Id}" FontSize="{StaticResource FontSizeBody}"
                                                                                           Foreground="{ThemeResource AppTextBrush}" />
                                                                                <TextBlock Text="{Binding SinceText}"
                                                                                           FontSize="{StaticResource FontSizeCaption}"
                                                                                           Foreground="{ThemeResource AppText3Brush}" />
                                                                            </StackPanel>
                                                                            <Button VerticalAlignment="Center" Grid.Column="1" Content="恢复" Style="{StaticResource PillButtonStyle}"
                                                                                    AutomationProperties.Name="恢复这个版本"
                                                                                    Tag="{Binding Id}" Click="Unhide_Click" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <controls:EmptyState x:Name="HiddenEmpty" Glyph="&#xE7C3;"
                                                                                 Title="没有已隐藏的版本"
                                                                                 Hint="在版本管理里隐藏的实例会出现在这里。"
                                                                                 Visibility="Collapsed" />
                                                        </StackPanel>
                    </Border>

                    <!-- ③ 外观 -->
                    <StackPanel Spacing="12" x:Name="AppearanceCard" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题" Style="{StaticResource GroupTitleStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="AppearanceStatusText" Grid.Column="1"
                                               Style="{StaticResource RowValueStyle}" HorizontalAlignment="Left"
                                               TextAlignment="Left" VerticalAlignment="Center" Margin="8,0" />
                                </Grid>

                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="ThemeBox" Height="32" MinWidth="200"
                                              HorizontalAlignment="Right" SelectionChanged="Theme_Changed"
                                              AutomationProperties.Name="主题模式">
                                        <ComboBoxItem Content="跟随系统" Tag="system" />
                                        <ComboBoxItem Content="深色" Tag="dark" />
                                        <ComboBoxItem Content="浅色" Tag="light" />
                                    </ComboBox>
                                </Grid>

    <!-- 主题色：系统强调色 / 壁纸取色（莫奈）/ 自定义；右侧色块直接点开取色器。 -->
                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="主题色" Style="{StaticResource RowLabelStyle}" />
                                    <StackPanel HorizontalAlignment="Right" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <ComboBox x:Name="ThemeColorBox" Height="32" MinWidth="200"
                                                  HorizontalAlignment="Left" SelectionChanged="ThemeColor_Changed">
                                            <ComboBoxItem Content="跟随壁纸取色" Tag="wallpaper" />
                                            <ComboBoxItem Content="跟随系统强调色" Tag="accent" />
                                            <ComboBoxItem Content="自定义颜色" Tag="custom" />
                                        </ComboBox>
                                        <Button x:Name="ThemeColorSwatch" Width="32" Height="32" Padding="0"
                                                CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeBrush}"
                                                AutomationProperties.Name="选择主题色"
                                                ToolTipService.ToolTip="打开取色器"
                                                Click="ThemeColorSwatch_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ThemeColorValueText" VerticalAlignment="Center" Grid.Column="2"
                                               Style="{StaticResource RowValueStyle}" Text="#2FA35A" />
                                </Grid>


                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="外观设置" Style="{StaticResource RowLabelStyle}" />
                                    <Button Grid.Column="1" Content="恢复默认" Style="{StaticResource PillButtonStyle}"
                                            VerticalAlignment="Center" AutomationProperties.Name="恢复默认外观" Click="ResetAppearance_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="背景" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
                                <Grid ColumnSpacing="14" MinHeight="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="窗口材质" Style="{StaticResource RowLabelStyle}" />
                                    <ComboBox Grid.Column="1" VerticalAlignment="Center" x:Name="BackgroundBox" Height="32" MinWidth="200"
                                              HorizontalAlignment="Right" SelectionChanged="Background_Changed">
                                        <ComboBoxItem Content="亚克力" Tag="Acrylic" />
                                        <ComboBoxItem Content="云母" Tag="Mica" />
                                        <ComboBoxItem Content="跟随壁纸" Tag="Wallpaper" />
                                        <ComboBoxItem Content="自定义图片" Tag="Image" />
                                        <ComboBoxItem Content="像素壁纸" Tag="PixelWallpaper" />
                                    </ComboBox>
                                </Grid>

                            </Border>
                            <Border Style="{StaticResource SettingsRowCardStyle}" Visibility="{Binding Visibility, ElementName=BackgroundImageRow}">
                                <Grid x:Name="BackgroundImageRow" ColumnSpacing="14" MinHeight="38"
                                      Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景图片" Style="{StaticResource RowLabelStyle}" />
                                    <Button VerticalAlignment="Center" Grid.Column="1" x:Name="ChooseImageButton" Content="选择图片" Height="32"
                                            Padding="12,0" CornerRadius="15"
                                            HorizontalAlignment="Right" BorderThickness="0"
                                            FontSize="{StaticResource FontSizeCaption}"
                                            Background="{ThemeResource AppChipBrush}"
                                            Foreground="{ThemeResource AppTextBrush}"
                                            AutomationProperties.Name="选择背景图片" Click="ChooseImage_Click" />
                                    <TextBlock x:Name="BackgroundImageValue" VerticalAlignment="Center" Grid.Column="2"
                                               Style="{StaticResource RowValueStyle}" Text="未选择" />
                                </Grid>

                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="可读性" Margin="0,0,0,4" Style="{StaticResource GroupTitleStyle}" />
                            <Border Style="{StaticResource SettingsRowCardStyle}">
