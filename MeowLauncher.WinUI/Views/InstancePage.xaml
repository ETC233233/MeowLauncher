<Page
    x:Class="MeowLauncher.WinUI.Views.InstancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    Background="Transparent">

    <!-- 「实例」把 Mod 管理与四类实例资源并成同一级；不再套一层「实例内容」。
         五个胶囊共用同一套样式与计数，内容仍复用 ModsPage / AssetsPage。 -->
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="实例" FontSize="28" FontWeight="SemiBold"
                       Foreground="{ThemeResource AppTextBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- 第 3 步：全部实例是实例工作区里的一个视图，不再单列侧栏项 -->
                <Button x:Name="AllInstancesButton" Content="全部实例" Height="32"
                        Style="{StaticResource PillButtonStyle}"
                        AutomationProperties.Name="打开全部实例"
                        Click="AllInstances_Click" />
                <controls:InstanceSwitcher x:Name="Switcher" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <ToggleButton x:Name="TabMods" Style="{StaticResource SegTabToggleStyle}" Tag="mods" Click="Tab_Click"
                              AutomationProperties.Name="Mod 管理"
                              Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                              BorderThickness="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8B7;" FontSize="13" />
                        <TextBlock Text="Mod 管理" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabResourcepack" Style="{StaticResource SegTabToggleStyle}" Tag="resourcepack" Click="Tab_Click"
                              AutomationProperties.Name="资源包"
                              Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                              BorderThickness="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE7B8;" FontSize="13" />
                        <TextBlock x:Name="AssetPacksText" Text="资源包 0" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabShaderpack" Style="{StaticResource SegTabToggleStyle}" Tag="shaderpack" Click="Tab_Click"
                              AutomationProperties.Name="光影"
                              Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                              BorderThickness="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE790;" FontSize="13" />
                        <TextBlock x:Name="AssetShadersText" Text="光影 0" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabWorld" Style="{StaticResource SegTabToggleStyle}" Tag="world" Click="Tab_Click"
                              AutomationProperties.Name="存档"
                              Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                              BorderThickness="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE81E;" FontSize="13" />
                        <TextBlock x:Name="AssetWorldsText" Text="存档 0" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TabScreenshot" Style="{StaticResource SegTabToggleStyle}" Tag="screenshot" Click="Tab_Click"
                              AutomationProperties.Name="截图"
                              Padding="14,7" CornerRadius="{StaticResource ChipCornerRadius}"
                              BorderThickness="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE91B;" FontSize="13" />
                        <TextBlock x:Name="AssetShotsText" Text="截图 0" FontSize="{StaticResource FontSizeBody}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </ScrollViewer>

        <Frame x:Name="InnerFrame" Grid.Row="2" Background="Transparent"
               IsNavigationStackEnabled="False" />
    </Grid>
</Page>
