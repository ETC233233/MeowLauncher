<Window
    x:Class="MeowLauncher.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MeowLauncher.WinUI.Converters"
    xmlns:controls="using:MeowLauncher.WinUI.Controls"
    xmlns:views="using:MeowLauncher.WinUI.Views"
    mc:Ignorable="d"
    Title="MeowLauncher">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Language="zh-CN" KeyDown="RootGrid_KeyDown"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control,Shift" Invoked="GlobalSearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked" />
            <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="SidebarAccelerator_Invoked" />
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <controls:WallpaperLayer x:Name="Wallpaper" Grid.RowSpan="2" Grid.ColumnSpan="2" />

        <Border x:Name="BackgroundImageBase" Grid.RowSpan="2" Grid.ColumnSpan="2"
                Visibility="Collapsed" IsHitTestVisible="False" />
        <Image x:Name="BackgroundImageHost" Grid.RowSpan="2" Grid.ColumnSpan="2"
               Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False"
               Opacity="1" />

        <Border x:Name="RootVeil" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="#0D0B0D10" IsHitTestVisible="False" />

        <!-- 主题染色：比遮罩更淡的一层主题色，只给界面一点色温，不压暗内容。 -->
        <Border x:Name="ThemeTintLayer" Grid.RowSpan="2" Grid.ColumnSpan="2"
                Background="{ThemeResource AppTintBrush}" IsHitTestVisible="False" />

        <Grid x:Name="TitleBarRoot" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" Canvas.ZIndex="20">
            <Grid x:Name="AppTitleBar" Height="48" VerticalAlignment="Top" Background="Transparent" />

            <!-- 标题栏透明到壁纸，只留 1px 分隔线（不画底） -->
            <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource AppStrokeBrush}" IsHitTestVisible="False" />

            <Button x:Name="MenuToggleButton" AutomationProperties.Name="菜单"
                    Width="32" Height="32" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0" Background="Transparent" BorderThickness="0" CornerRadius="6"
                    Click="MenuToggle_Click" ToolTipService.ToolTip="展开/收起菜单（Ctrl+B）">
                <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource AppText2Brush}" />
            </Button>

            <!-- 返回键只在有上一页时占位；品牌区跟着它左移，避免首页留一段空槽。 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="52,0,0,0" Spacing="10">
                <Button x:Name="BackButton" AutomationProperties.Name="返回"
                        Width="32" Height="32" Padding="0" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0" CornerRadius="6"
                        Click="Back_Click" ToolTipService.ToolTip="返回（Alt+Left）">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="{ThemeResource AppText2Brush}" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="10" IsHitTestVisible="False">
                    <Border Width="28" Height="28" CornerRadius="8" Background="Transparent">
                        <Image x:Name="TitleBarIcon" Stretch="Fill" />
                    </Border>
                    <TextBlock Text="MeowLauncher" FontSize="14" Foreground="{ThemeResource AppTextBrush}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="AppVersionText" Text="—" Foreground="{ThemeResource AppText3Brush}"
                               FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" Margin="2,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- 搜索栏靠左（品牌区右边），右边腾出一段给灵动岛向右撑开 -->
            <Grid x:Name="SearchHost" Width="320" HorizontalAlignment="Left" Margin="344,0,0,0" VerticalAlignment="Center">
                <Button x:Name="SearchTrigger" AutomationProperties.Name="搜索" Height="42" Padding="14,0" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Background="{ThemeResource AppCardBrush}"
                        BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1" CornerRadius="16"
                        Click="OpenSpotlight_Click">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AppText2Brush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchTriggerHint" Grid.Column="1"
                                   Text="搜索全部  Ctrl+Shift+K" FontSize="{StaticResource FontSizeBody}"
                                   Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>

        </Grid>

        <Border x:Name="SidebarRoot" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                Width="218" HorizontalAlignment="Left"
                Canvas.ZIndex="2"
                Background="{ThemeResource AppSidebarBrush}"
                BorderBrush="{ThemeResource AppStrokeBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,10,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button x:Name="AccountButton" AutomationProperties.Name="账户" Grid.Row="0" Padding="9,7" Margin="0,0,0,12"
                        Background="Transparent" BorderThickness="0" CornerRadius="10"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Click="AccountButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="AccountAvatar" Width="44" Height="44" />
                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AccountName" Text="正在读取账户…" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AccountType" Text="请稍候" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource AppText3Brush}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="{StaticResource FontSizeSmall}"
                                  Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <ScrollViewer x:Name="NavScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 导航按 HIG 分组：单条目组不再挂组标题（玩、获取），直接提到顶层；
                             其余组（实例、我的）保留小号灰字组标题，组间距 18。
                             「日志」不占侧栏位，LogsPage 的注册与 Navigate("logs") 保留，
                             入口由设置页「关于」组接入。 -->
                        <ToggleButton x:Name="NavHome" AutomationProperties.Name="主页" Style="{StaticResource NavToggleStyle}" IsChecked="True"
                                      Margin="0,4,0,0" Click="Nav_Click" Tag="home" ToolTipService.ToolTip="主页 · Ctrl+1">
                            <ToggleButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="NavAccelerator_Invoked" />
                            </ToggleButton.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="15" />
                                <TextBlock Text="主页" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" />
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton x:Name="NavGet" AutomationProperties.Name="获取" Style="{StaticResource NavToggleStyle}"
                                      Margin="0,18,0,0" Click="Nav_Click" Tag="get" ToolTipService.ToolTip="获取 · Ctrl+2">
                            <ToggleButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="NavAccelerator_Invoked" />
                            </ToggleButton.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE896;" FontSize="15" />
                                <TextBlock Text="获取" FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                        </ToggleButton>

                        <Grid x:Name="GroupInstanceTitleHost" Visibility="Collapsed" Margin="10,18,10,6" Height="16">
                            <TextBlock x:Name="GroupInstanceTitle" Text="实例" AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                       CharacterSpacing="10" Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center" />
                            <Border x:Name="GroupInstanceTitleRule" Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                    Background="{ThemeResource AppStrokeBrush}" Visibility="Collapsed" />
                        </Grid>
                        <!-- 第 3 步：侧栏收成 5 项，全部实例从「实例」页与胶囊下拉进入 -->
                        <ToggleButton x:Name="NavVersions" Visibility="Collapsed" AutomationProperties.Name="全部实例" Style="{StaticResource NavToggleStyle}" Click="Nav_Click" Tag="versions" ToolTipService.ToolTip="全部实例">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81E;" FontSize="15" />
                                <TextBlock Text="全部实例" FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavInstance" AutomationProperties.Name="实例" Style="{StaticResource NavToggleStyle}" Click="Nav_Click" Tag="instance" ToolTipService.ToolTip="实例 · Ctrl+3">
                            <ToggleButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="NavAccelerator_Invoked" />
                            </ToggleButton.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                <TextBlock Text="实例" FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                        </ToggleButton>
                        <Grid x:Name="GroupMineTitleHost" Margin="10,18,10,6" Height="16">
                            <TextBlock x:Name="GroupMineTitle" Text="我的" AutomationProperties.AccessibilityView="Raw" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                                       CharacterSpacing="10" Foreground="{ThemeResource AppText3Brush}" VerticalAlignment="Center" />
                            <Border x:Name="GroupMineTitleRule" Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                    Background="{ThemeResource AppStrokeBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ToggleButton x:Name="NavAccount" AutomationProperties.Name="账户" Style="{StaticResource NavToggleStyle}" Click="Nav_Click" Tag="account" ToolTipService.ToolTip="账户 · Ctrl+4">
                            <ToggleButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="NavAccelerator_Invoked" />
                            </ToggleButton.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="15" />
                                <TextBlock Text="账户" FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                        </ToggleButton>
                        <!-- 联机：只在「开发者测试 → 联机」开着时显示（MainWindow.ApplyOnlineSettingAsync 控制），默认隐藏 -->
                        <ToggleButton x:Name="NavRoom" AutomationProperties.Name="联机" Visibility="Collapsed" Style="{StaticResource NavToggleStyle}" Click="Nav_Click" Tag="room" ToolTipService.ToolTip="联机房间">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE716;" FontSize="15" />
                                <TextBlock Text="联机" FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSettings" AutomationProperties.Name="设置" Style="{StaticResource NavToggleStyle}" Click="Nav_Click" Tag="settings" ToolTipService.ToolTip="设置 · Ctrl+5">
                            <ToggleButton.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="NavAccelerator_Invoked" />
                            </ToggleButton.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="15" />
                                <TextBlock Text="设置" FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" x:Name="TaskDock" Visibility="Collapsed" AutomationProperties.Name="任务与通知" Margin="0,14,0,0" Padding="11,10"
                        Background="{ThemeResource AppPanelBrush}" BorderBrush="{ThemeResource AppStrokeBrush}"
                        BorderThickness="1" CornerRadius="18" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                    <!-- 悬浮概览：贴入口上沿弹出，宽 380（内容 352 + 内边距 28），只给最近 3 条进行中与 3 条结束。 -->
                    <Button.Flyout>
                        <Flyout x:Name="TaskFlyout" Placement="TopEdgeAlignedLeft" AreOpenCloseAnimationsEnabled="True"
                                Opening="TaskFlyout_Opening" Opened="TaskFlyout_Opened">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="14" />
                                    <Setter Property="CornerRadius" Value="{StaticResource RowCornerRadius}" />
                                    <Setter Property="Background" Value="{ThemeResource AppCardBrush}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel x:Name="TaskFlyoutRoot" Width="352" RenderTransformOrigin="0,0">
                                <Grid x:Name="TaskFlyoutHeader" Margin="0,0,0,10">
                                    <TextBlock Text="任务与通知" FontSize="{StaticResource FontSizeCardTitle}"
                                               FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                                    <TextBlock x:Name="TaskFlyoutSummary" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource AppText3Brush}" />
                                </Grid>
                                <StackPanel x:Name="TaskFlyoutBody" />
                                <Button x:Name="ViewAllTaskButton" Content="查看全部" Height="32" Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        CornerRadius="{StaticResource ChipCornerRadius}" BorderThickness="0"
                                        Background="{ThemeResource TintTasksSoftBrush}" FontSize="11.5"
                                        Foreground="{ThemeResource TintTasksBrush}"
                                        AutomationProperties.Name="查看全部任务与通知"
                                        Click="ViewAllTasks_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{ThemeResource AppChipBrush}">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{ThemeResource AppText2Brush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="TaskDockBody" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="任务与通知" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextBrush}" />
                            <TextBlock x:Name="TaskDockText" Text="没有正在进行的任务" FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource AppText3Brush}" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="1" Grid.Column="1" Background="Transparent">
            <Frame x:Name="ContentFrame" Background="Transparent" IsNavigationStackEnabled="False" />
        </Grid>

        <!-- Spotlight：点击搜索栏后浮出，Esc / 点遮罩关闭 -->
        <Grid x:Name="SpotlightLayer" Grid.RowSpan="2" Grid.ColumnSpan="2"
              Visibility="Collapsed" Canvas.ZIndex="100">
            <!-- 遮罩从标题栏下沿开始：标题栏（含搜索栏）始终保持原样，不会被压暗置灰。 -->
            <Rectangle x:Name="SpotlightBackdrop" Fill="#99000000" Margin="0,48,0,0"
                       Tapped="CloseSpotlight_Tapped" />
            <Border x:Name="SpotlightCard" Width="760" Height="44"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                    Background="{ThemeResource AppCardBrush}"
                    BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}">
                <Border.RenderTransform>
                    <CompositeTransform x:Name="SpotlightTransform" ScaleX="0.96" ScaleY="0.96"
                                        TranslateY="-12" />
                </Border.RenderTransform>
                <Grid Margin="8,2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" Height="32" Width="300"
                                    Background="{ThemeResource AppChipBrush}"
                                    BorderBrush="{ThemeResource AppStrokeBrush}"
                                    BorderThickness="1" Padding="10,0"
                                    VerticalAlignment="Center"
                                    PlaceholderText="搜索页面、设置、实例、Mod…"
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged"
                                    GotFocus="SearchBox_GotFocus"
                                    SuggestionChosen="SearchBox_SuggestionChosen"
                                    QuerySubmitted="SearchBox_QuerySubmitted"
                                    KeyDown="SearchBox_KeyDown">
                    </AutoSuggestBox>
                    <TextBlock Grid.Column="1" Text="Esc 关闭 · Enter 打开第一项"
                               FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppText3Brush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border x:Name="SpotlightResultsHost" Width="760" MaxHeight="420"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0"
                    Background="{ThemeResource AppPanelBrush}"
                    BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCornerRadius}"
                    Visibility="Collapsed">
                <ListView x:Name="SpotlightResults" MaxHeight="408" Margin="0,4"
                          SelectionMode="Single" IsItemClickEnabled="True"
                          ItemClick="SpotlightResults_ItemClick"
                          Background="Transparent" BorderThickness="0" Padding="0,2">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{ThemeResource AppChipHoverColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{ThemeResource AppChipHoverColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="{ThemeResource AppChipHoverColor}" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{ThemeResource AppChipHoverColor}" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="Margin" Value="6,1" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding GroupHeader}"
                                               Visibility="{Binding ShowGroupHeader, Converter={StaticResource BoolToVisibilityConverter}}"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppText3Brush}"
                                               Margin="4,9,4,4" />
                                    <Grid Padding="2,0" MinWidth="560" Height="36" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                  Foreground="{ThemeResource AppText2Brush}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                                   Foreground="{ThemeResource AppTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Subtitle}" FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource AppText3Brush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
            </Border>
        </Grid>

        <!-- 任务与通知灵动岛：视觉上在标题栏右侧、搜索框旁边，但必须放在整窗布局层（跨两行两列）：
             放在 48 高的标题栏那一格里，展开的卡片会被那一格裁掉。左边的 TitleBarRoot 之上、弹窗之下。 -->
        <controls:TaskIsland x:Name="TaskIsland" AutomationProperties.Name="任务与通知灵动岛"
                             Grid.RowSpan="2" Grid.ColumnSpan="2"
                             VerticalAlignment="Top" HorizontalAlignment="Left"
                             Margin="676,3,0,0" Canvas.ZIndex="40" />

        <!-- 冷启动遮罩：盖住标题栏以下的整个窗口，直到本机数据（实例 / 账户）读完；读完淡出 -->
        <Grid x:Name="StartupMask" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="60"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="1">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.35"/></Grid.OpacityTransition>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <controls:CatLogoPainter HorizontalAlignment="Center"/>
                <TextBlock x:Name="StartupText" Text="正在读取实例和账户…" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,18,0,0" Foreground="{ThemeResource AppText2Brush}"/>
            </StackPanel>
            <!-- 底部满宽绿条：从左往右慢慢填满，没读完就停在 92%，读完遮罩淡出时补满 -->
            <Grid VerticalAlignment="Bottom" Height="8" Background="#22FFFFFF">
                <Border x:Name="StartupBar" Background="{ThemeResource AppBrandBrush}" HorizontalAlignment="Left" Width="0">
                </Border>
            </Grid>
        </Grid>

        <!-- 新手引导已改成独立窗口（Views/OnboardingWindow），不再盖住主界面；
             这里只剩「进入启动器」之后的手绘线稿转场。 -->

        <!-- 进入启动器的过渡：先铺一层灰色骨架占位，真实数据就绪后骨架渐隐、露出真界面 -->
        <Grid x:Name="ShellSkeleton" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="62"
              Visibility="Collapsed" Opacity="0"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.42"/></Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.RowSpan="2" Margin="28,18,28,0" Spacing="16">
                <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <StackPanel Spacing="14" Margin="2,16,0,0">
                    <Border Height="13" Width="124" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Border Height="13" Width="104" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Border Height="13" Width="116" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Border Height="13" Width="92" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Border Height="13" Width="110" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Width="240" Height="14" Margin="26,17,0,0" HorizontalAlignment="Left"
                    CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="26,26,26,26" Spacing="16">
                <Border Height="208" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Height="136" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Border Grid.Column="1" Height="136" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Border Grid.Column="2" Height="136" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                </Grid>
                <Border Height="14" Width="240" HorizontalAlignment="Left" CornerRadius="7" Background="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 新手引导 → 主界面：手绘线稿转场。顶栏、侧栏、卡片框都是 1px 细线，按顺序一笔一笔「画」出来，
             画完整层淡出，露出已经加载好的真实界面。 -->
        <Grid x:Name="OnboardingSketch" Grid.RowSpan="2" Grid.ColumnSpan="2" Canvas.ZIndex="62"
              Visibility="Collapsed" Opacity="0"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.45"/></Grid.OpacityTransition>
            <Grid.Resources>
                <Storyboard x:Key="SketchStoryboard">
                    <DoubleAnimation Storyboard.TargetName="SkTop" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.26" BeginTime="0:0:0.00"/>
                    <DoubleAnimation Storyboard.TargetName="SkSide" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:0.30" BeginTime="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="SkAvatar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:0.42"/>
                    <DoubleAnimation Storyboard.TargetName="SkAvatarScale" Storyboard.TargetProperty="ScaleX" From="0.55" To="1" Duration="0:0:0.22" BeginTime="0:0:0.42"/>
                    <DoubleAnimation Storyboard.TargetName="SkAvatarScale" Storyboard.TargetProperty="ScaleY" From="0.55" To="1" Duration="0:0:0.22" BeginTime="0:0:0.42"/>
                    <DoubleAnimation Storyboard.TargetName="SkNav1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:0.52"/>
                    <DoubleAnimation Storyboard.TargetName="SkNav2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:0.60"/>
                    <DoubleAnimation Storyboard.TargetName="SkNav3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:0.68"/>
                    <DoubleAnimation Storyboard.TargetName="SkNav4" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:0.78"/>
                    <DoubleAnimation Storyboard.TargetName="SkNav5" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:0.86"/>
                    <DoubleAnimation Storyboard.TargetName="SkNav6" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:0.94"/>
                    <DoubleAnimation Storyboard.TargetName="SkCardT" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.20" BeginTime="0:0:1.08"/>
                    <DoubleAnimation Storyboard.TargetName="SkCardR" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:1.24"/>
                    <DoubleAnimation Storyboard.TargetName="SkCardB" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.20" BeginTime="0:0:1.40"/>
                    <DoubleAnimation Storyboard.TargetName="SkCardL" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:0.18" BeginTime="0:0:1.56"/>
                    <DoubleAnimation Storyboard.TargetName="SkInner1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.16" BeginTime="0:0:1.72"/>
                    <DoubleAnimation Storyboard.TargetName="SkInner2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.14" BeginTime="0:0:1.80"/>
                </Storyboard>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 顶栏底线 -->
            <Rectangle x:Name="SkTop" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>

            <!-- 侧栏右边界 -->
            <Rectangle x:Name="SkSide" Grid.Row="1" Width="1" HorizontalAlignment="Right" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleY="0" CenterY="0"/></Rectangle.RenderTransform>
            </Rectangle>

            <!-- 侧栏头像圆 -->
            <Ellipse x:Name="SkAvatar" Grid.Row="1" Width="26" Height="26" Margin="24,58,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" Stroke="{ThemeResource AppStrokeBrush}" StrokeThickness="1.2">
                <Ellipse.RenderTransform><ScaleTransform x:Name="SkAvatarScale" CenterX="13" CenterY="13" ScaleX="0.55" ScaleY="0.55"/></Ellipse.RenderTransform>
            </Ellipse>

            <!-- 侧栏六条导航 -->
            <Rectangle x:Name="SkNav1" Grid.Row="1" Width="112" Height="1" Margin="24,102,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="SkNav2" Grid.Row="1" Width="112" Height="1" Margin="24,160,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="SkNav3" Grid.Row="1" Width="112" Height="1" Margin="24,198,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="SkNav4" Grid.Row="1" Width="112" Height="1" Margin="24,241,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="SkNav5" Grid.Row="1" Width="112" Height="1" Margin="24,283,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="SkNav6" Grid.Row="1" Width="112" Height="1" Margin="24,325,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
            </Rectangle>

            <!-- 主卡片四边：上(左→右) 右(上→下) 下(右→左) 左(下→上)，像一笔把框描完 -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="44,26,44,26">
                <Rectangle x:Name="SkCardT" Height="1" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                    <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SkCardR" Width="1" HorizontalAlignment="Right" Fill="{ThemeResource AppStrokeBrush}">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0" CenterY="0"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SkCardB" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource AppStrokeBrush}">
                    <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="1"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SkCardL" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource AppStrokeBrush}">
                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0" CenterY="1"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SkInner1" Width="190" Height="1" Margin="30,38,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                    <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SkInner2" Width="124" Height="1" Margin="30,64,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{ThemeResource AppStrokeBrush}">
                    <Rectangle.RenderTransform><ScaleTransform ScaleX="0" CenterX="0"/></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </Grid>

        <!-- 出错提示：XAML 未处理异常时浮在内容区顶部，8 秒自动收起；不遮挡操作、不推动布局。 -->
        <Border x:Name="CrashToast" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,56,0,0" MaxWidth="560" Padding="16,12"
                CornerRadius="{StaticResource CardCornerRadius}"
                Background="{ThemeResource AppPanelBrush}"
                BorderBrush="{ThemeResource AppStrokeBrush}" BorderThickness="1"
                Visibility="Collapsed" Canvas.ZIndex="30">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CrashToastTitle" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextBrush}" />
                    <TextBlock x:Name="CrashToastBody" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                               Foreground="{ThemeResource AppText3Brush}" />
                </StackPanel>
                <Button x:Name="CrashToastOpenLogs" Grid.Column="1" Content="打开日志目录"
                        VerticalAlignment="Center" Click="CrashToastOpenLogs_Click" />
            </Grid>
        </Border>

        <!-- 好友邀请弹窗：收到邀请 / 对方回复时浮在内容区右上角，邀请 30 秒、回复 8 秒自动收起；邀请带「接受 / 拒绝」。 -->
        <Border x:Name="InviteToast" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,56,20,0" Width="380" Padding="16,14"
                CornerRadius="{StaticResource CardCornerRadius}"
                Background="{ThemeResource AppPanelBrush}"
                BorderBrush="{ThemeResource TintTasksBrush}" BorderThickness="2"
                Visibility="Collapsed" Canvas.ZIndex="31">
            <Border.RenderTransform>
                <TranslateTransform x:Name="InviteToastShift" X="0" />
            </Border.RenderTransform>
            <StackPanel Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE716;" FontSize="20" Foreground="{ThemeResource TintTasksBrush}"
                              VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="InviteToastTitle" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="InviteToastBody" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource AppText3Brush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="11" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Top" AutomationProperties.Name="关闭提示" Click="InviteToastClose_Click" />
                </Grid>
                <StackPanel x:Name="InviteToastButtons" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="InviteToastAccept" Content="接受" Height="34" Padding="18,0"
                            Style="{StaticResource AccentButtonStyle}" Click="InviteToastAccept_Click" />
                    <Button x:Name="InviteToastDecline" Content="拒绝" Height="34" Padding="18,0"
                            Click="InviteToastDecline_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
